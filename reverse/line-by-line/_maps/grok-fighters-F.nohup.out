,32,39,107,51,39,44,32,39,107,52,39,44,32,39,107,53,39,44,32,39,107,106,49,39,44,32,39,107,106,49,49,39,44,32,39,107,106,49,50,39,44,32,39,107,106,50,49,39,44,32,39,107,106,50,39,44,32,39,122,104,49,39,44,32,39,122,104,49,49,39,44,32,39,122,104,50,39,44,32,39,122,104,50,49,39,44,32,39,122,104,50,50,39,44,32,39,122,104,51,39,44,32,39,122,104,51,49,39,44,32,39,98,115,39,44,32,39,115,98,115,39,44,32,39,107,98,115,39,44,32,39,99,98,115,49,39,44,32,39,99,98,115,50,39,44,32,39,99,98,115,51,39,44,32,39,99,98,115,39,44,32,39,115,104,49,39,44,32,39,115,104,49,50,39,44,32,39,115,104,50,39,44,32,39,115,104,50,50,39,93,10],"output_for_prompt":"exit: 0\n==== rukia\nframe1 nact 0\nframe2 nact 18\n  stats 6 15 1 1\n  faces [('bsface1', 'bsface1'), ('bsface2', 'bsface2')]\n  sounds [('HurtSound', 'snd_hurt1'), ('HurtFlySound', 'snd_hurt1'), ('DieSound', 'snd_hurt1')]\nframe3 nact 24\n  stats 9 15 2 0\n  faces [('bsface1', 'bsface1'), ('bsface2', 'bsface2')]\n  sounds [('HurtSound', 'snd_hurt1'), ('HurtFlySound', 'snd_hurt1'), ('DieSound', 'snd_hurt1')]\n==== sasuke\nframe1 nact 0\nframe2 nact 24\n  stats 8 15 3 0\n  faces [('佐助1', 'bsface1'), ('佐助2', 'bsface2'), ('佐助3', 'bsface3')]\n  sounds [('HurtSound', 'snd_hurt1'), ('HurtFlySound', 'snd_hurt1'), ('DieSound', 'snd_hurt1')]\nframe3 nact 20\n  stats 10 15 3 1\n  faces [('佐助1', 'bsface1'), ('佐助2', 'bsface2'), ('佐助3', 'bsface3')]\n  sounds [('HurtSound', 'snd_hurt1'), ('HurtFlySound', 'snd_hurt1'), ('DieSound', 'snd_hurt1')]\n\n=== bsface sizes ===\nrenji bsface1.as ('168', '119')\nrenji bsface2.as ('168', '119')\nrenji bsface3.as ('168', '119')\norochimaru bsface1.as ('168', '119')\norochimaru bsface2.as ('168', '119')\npain bsface1.as ('169', '121')\npain bsface2.as ('170', '124')\npain bsface3.as ('169', '120')\nsasuke_xz bsface1.as ('168', '119')\nsasuke_xz bsface2.as ('168', '119')\nsakura bsface1.as ('168', '119')\nsakura bsface2.as ('168', '119')\nsasuke bsface1.as ('168', '119')\nsasuke bsface2.as ('168', '119')\nsasuke bsface3.as ('168', '119')\nrukia bsface1.as ('168', '119')\nrukia bsface2.as ('168', '119')\n\n=== AI mian ===\norochimaru AI面_2.as miss ['kbsmian'] extra []\npain AI面_2.as miss ['kbsmian'] extra []\nrenji AI面_2.as miss ['bsmian', 'kbsmian'] extra []\nrukia AI面副本_9.as miss ['kbsmian'] extra []\nrukia AI面_2.as miss ['kbsmian'] extra []\nsakura AI面_2.as miss ['sbsmian', 'kbsmian'] extra ['absmian']\nsasuke AI面副本_13.as miss ['kbsmian'] extra []\nsasuke AI面_2.as miss ['kbsmian'] extra []\nsasuke_xz AI面_2.as miss [] extra []\n\n=== orochimaru sounds raw ===\ndefineHurtSound(snd_hurt1,snd_hurt2)\ndefineHurtFlySound(snd_hurt3)\ndefineDieSound(snd_die)\n--- pain ---\ndefineHurtSound(snd_hurt1)\ndefineHurtFlySound(snd_hurt1)\ndefineDieSound(snd_hurt1)\n--- sakura ---\nTrue False\n--- sasuke_xz kbs ---\nTrue\n['tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'k5', 'kj1', 'kj11', 'kj12', 'kj21', 'kj2', 'zh1', 'zh11', 'zh2', 'zh21', 'zh22', 'zh3', 'zh31', 'bs', 'sbs', 'kbs', 'cbs1', 'cbs2', 'cbs3', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\n","exit_code":0,"command":"python3 - <<'PY'\nimport re, pathlib\nroot = pathlib.Path('/workspace/bvn-3.3/decompiled/fighters')\nfor f in ['rukia','sasuke']:\n    p = next((root/f/'scripts').rglob('MainTimeline.as'))\n    text = p.read_text()\n    # split frames\n    frames = re.split(r'internal function (frame\\d+)', text)\n    print('====', f)\n    # frames[0] is header, then name, body, name, body...\n    for i in range(1,len(frames),2):\n        name, body = frames[i], frames[i+1]\n        speed = re.search(r'speed\\s*=\\s*([0-9.]+)', body)\n        jump = re.search(r'jumpPower\\s*=\\s*([0-9.]+)', body)\n        heavy = re.search(r'\\.heavy\\s*=\\s*([0-9.]+)', body)\n        defn = re.search(r'defenseType\\s*=\\s*(\\d+)', body)\n        faces = re.findall(r'defineBishaFace\\(\"([^\"]+)\",\\s*(\\w+)\\)', body)\n        sounds = re.findall(r'define(HurtSound|HurtFlySound|DieSound)\\(([^)]+)\\)', body)\n        nact = len(re.findall(r'defineAction\\(\"', body))\n        print(name, 'nact', nact)\n        if speed: print('  stats', speed.group(1), jump.group(1) if jump else '-', heavy.group(1) if heavy else '-', defn.group(1) if defn else '-')\n        if faces: print('  faces', faces)\n        if sounds: print('  sounds', sounds)\n\n# bsface sizes\nprint('\\n=== bsface sizes ===')\nfor p in pathlib.Path('/workspace/bvn-3.3/decompiled/fighters').rglob('bsface*.as'):\n    if p.parts[-3] in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n        t=p.read_text()\n        m=re.search(r'param1:int = (\\d+), param2:int = (\\d+)', t)\n        print(p.parent.parent.name, p.name, m.groups() if m else '?')\n\n# sakura AI 缺\nprint('\\n=== AI mian ===')\nGETALL = ['tkanmian','tzmian','kanmian','kj1mian','kj2mian','zh1mian','zh2mian','zh3mian','bsmian','sbsmian','kbsmian','cbsmian']\nfor f in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    for p in (root/f/'scripts').rglob('*AI*.as'):\n        t=p.read_text()\n        pubs=re.findall(r'public var (\\w+):', t)\n        mian=[x for x in pubs if x.endswith('mian')]\n        miss=[x for x in GETALL if x not in mian]\n        extra=[x for x in mian if x not in GETALL]\n        print(f, p.name, 'miss', miss, 'extra', extra)\n\n# orochimaru defineDieSound\nprint('\\n=== orochimaru sounds raw ===')\nt=(root/'orochimaru/scripts/orochimaru_fla/MainTimeline.as').read_text()\nfor m in re.finditer(r'define\\w*Sound\\([^)]+\\)', t):\n    print(m.group(0))\nprint('--- pain ---')\nt=(root/'pain/scripts/pain_fla/MainTimeline.as').read_text()\nfor m in re.finditer(r'define\\w*Sound\\([^)]+\\)', t):\n    print(m.group(0))\nprint('--- sakura ---')\nt=(root/'sakura/scripts/sakura_fla/MainTimeline.as').read_text()\nprint('hurt' in t, 'snd' in t)\nprint('--- sasuke_xz kbs ---')\nt=(root/'sasuke_xz/scripts/sasuke_xz_fla/MainTimeline.as').read_text()\nprint('kbs' in t)\nprint(re.findall(r'defineAction\\(\"([^\"]+)\"', t))\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":"Extract F2/F3 stats, AI mian gaps, bsface sizes","current_dir":"/workspace/bvn-3.3","output_file":"/home/box/.grok/sessions/%2Fworkspace%2Fbvn-3.3/01a06ed4-cecf-7f70-bc8a-9b75d6ce8a02/terminal/call-621e0000-6274-44ca-844f-1f0a2c73c497-53.log","total_bytes":2361},"locations":[]}
