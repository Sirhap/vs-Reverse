wankai=False addhp=False\n    faces ['佐助1', '佐助2', '佐助3', '佐助1', '佐助2', '佐助3']\n    sounds ['snd_hurt1', 'snd_hurt1', 'snd_hurt1', 'snd_hurt1']\n    stats 8 15 3 0\n    public ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction']\n  sasuke_fla/佐助_1.as  lines=644 cls=佐助_1 frames=103 att=False fc=False wankai=True addhp=False\n    addAttacker ['huo'] n= 1\n    setAttack ['砍1', '砍2', '砍3']\n    justHit ['cbs1']\n    loop ['走', '跳招2']\n    goto ['跳招2']\n    embed ('/_assets/assets.swf', 'symbol548')\n    public ['AImain', 'bdmn', 'bs10atm', 'bsatm', 'cbs1atm', 'cbs2atm', 'cbs3atm', 'huo', 'k1atm', 'k2atm', 'k3atm', 'kj1atm', 'kj21atm', 'kj2atm', 'sbs2atm', 'sbsatm', 'sh12atm', 'sh1atm', 'sh22atm', 'sh2atm', 'tkatm', 'tzatm', 'zh12atm', 'zh1atm', 'zh2atm', 'zh31atm', 'zh3atm']\n  sasuke_fla/佐助_超必杀效果_9.as  lines=48 cls=佐助_超必杀效果_9 frames=2 att=True fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol401')\n    public ['cbsatm', '$attacker_ctrler']\n  sasuke_fla/佐助咒化_12.as  lines=569 cls=佐助咒化_12 frames=84 att=False fc=False wankai=True addhp=False\n    fire ['tkatm', 'zh1atm'] n= 2\n    addAttacker ['zz1', 'zz1'] n= 2\n    setAttack ['砍1', '砍2', '砍3']\n    loop ['走']\n    embed ('/_assets/assets.swf', 'symbol966')\n    public ['AImain', 'bdmn', 'bs1atm', 'bs2atm', 'bsatm', 'k1atm', 'k2atm', 'k3atm', 'kj1atm', 'kj2atm', 'sbsatm', 'sh12atm', 'sh1atm', 'sh22atm', 'sh2atm', 'tkatm', 'tzatm', 'zh1atm', 'zh2atm', 'zz1']\n  sasuke_fla/麒麟1_19.as  lines=39 cls=麒麟1_19 frames=1 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol883')\n    public ['cbs1atm', 'cbsatm']\n  snd_hurt1.as  lines=16 cls=snd_hurt1 frames=0 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/1_snd_hurt1.mp3',)\n============================================================ sasuke_xz\n  bsface1.as  lines=16 cls=bsface1 frames=0 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/3_bsface1.png',)\n  bsface2.as  lines=16 cls=bsface2 frames=0 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/2_bsface2.png',)\n  sasuke_xz_fla/AI面_2.as  lines=59 cls=AI面_2 frames=1 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol6')\n    public ['bsmian', 'cbsmian', 'kanmian', 'kbsmian', 'kj1mian', 'kj2mian', 'sbsmian', 'tkanmian', 'tzmian', 'zh1mian', 'zh2mian', 'zh3mian']\n  sasuke_xz_fla/MainTimeline.as  lines=348 cls=MainTimeline frames=2 att=False fc=True wankai=False addhp=False\n    faces ['须佐助1', '须佐助2']\n    sounds ['snd_hurt1', 'snd_hurt1']\n    stats 12 17 3 1\n    public ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction']\n  sasuke_xz_fla/加具土命效果_15.as  lines=67 cls=加具土命效果_15 frames=5 att=True fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol319')\n    public ['bsatm', 'mian', '$attacker_ctrler']\n  sasuke_xz_fla/天照效果22_13.as  lines=68 cls=天照效果22_13 frames=5 att=True fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol253')\n    public ['zh10atm', 'zh11atm', 'zh1atm', '$attacker_ctrler']\n  sasuke_xz_fla/须作_1.as  lines=687 cls=须作_1 frames=110 att=False fc=False wankai=False addhp=False\n    addAttacker ['huo', 'tianzhao', 'huo', 'fenshen', 'huo', 'fenshen', 'sbsmc'] n= 7\n    setAttack ['砍2', '砍3', '砍4', '砍5', '砍技12']\n    justHit ['zh2']\n    loop ['走', '跳招loop']\n    embed ('/_assets/assets.swf', 'symbol602')\n    public ['AImain', 'bdmn', 'cbs1atm', 'cbs2atm', 'cbs3atm', 'cbsatm', 'fenshen', 'huo', 'k1atm', 'k2atm', 'k3atm', 'k4atm', 'kbsatm', 'kj10atm', 'kj11atm', 'sbsmc', 'sh12atm', 'sh1atm', 'sh22atm', 'sh2atm', 'tianzhao', 'tkatm', 'tzatm', 'zh21atm', 'zh22atm', 'zh2atm']\n  sasuke_xz_fla/须作_砍技2效果_9.as  lines=43 cls=须作_砍技2效果_9 frames=1 att=True fc=False wankai=False addhp=False\n    embed ('/_assets/assets.swf', 'symbol166')\n    public ['k5atm', '$attacker_ctrler']\n  snd_hurt1.as  lines=16 cls=snd_hurt1 frames=0 att=False fc=False wankai=False addhp=False\n    embed ('/_assets/1_snd_hurt1.mp3',)\n","exit_code":0,"command":"python3 - <<'PY'\nimport re, pathlib\nroot = pathlib.Path('/workspace/bvn-3.3/decompiled/fighters')\nfighters = ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']\nfor f in fighters:\n    print('='*60, f)\n    for p in sorted((root/f/'scripts').rglob('*.as')):\n        text = p.read_text(encoding='utf-8', errors='replace')\n        cls = re.search(r'class (\\S+)', text)\n        nlines = text.count('\\n')+1\n        has_att = 'setAttackerCtrler' in text\n        has_fc = 'setFighterCtrler' in text\n        faces = re.findall(r'defineBishaFace\\(\"([^\"]+)\"', text)\n        sounds = re.findall(r'defineHurt\\w*Sound\\(([^)]+)\\)', text)\n        speed = re.search(r'speed\\s*=\\s*([0-9.]+)', text)\n        jump = re.search(r'jumpPower\\s*=\\s*([0-9.]+)', text)\n        heavy = re.search(r'\\.heavy\\s*=\\s*([0-9.]+)', text)\n        defn = re.search(r'defenseType\\s*=\\s*(\\d+)', text)\n        wankai = 'doWanKai' in text or 'startWanKai' in text or 'endWanKai' in text\n        addhp = 'addHp' in text\n        fire = re.findall(r'\\.fire\\(\"([^\"]+)\"', text)\n        addatt = re.findall(r'addAttacker\\(\"([^\"]+)\"', text)\n        setatt = re.findall(r'setAttack\\(\"([^\"]+)\"', text)\n        justhit = re.findall(r'justHitToPlay\\(\"([^\"]+)\"', text)\n        loop = re.findall(r'\\.loop\\(\"([^\"]+)\"', text)\n        goto = re.findall(r'gotoAndPlay\\(\"([^\"]+)\"', text)\n        frames = re.findall(r'function (frame\\d+)', text)\n        public = re.findall(r'public var (\\S+):', text)\n        embed = re.search(r'source=\"([^\"]+)\".*?symbol=\"([^\"]+)\"', text, re.S) or re.search(r'source=\"([^\"]+)\"', text)\n        print(f\"  {p.relative_to(root/f/'scripts')}  lines={nlines} cls={cls.group(1) if cls else '?'} frames={len(frames)} att={has_att} fc={has_fc} wankai={wankai} addhp={addhp}\")\n        if faces: print('    faces', faces)\n        if sounds: print('    sounds', sounds)\n        if speed: print('    stats', speed.group(1), jump.group(1) if jump else '-', heavy.group(1) if heavy else '-', defn.group(1) if defn else '-')\n        if fire: print('    fire', fire[:20], 'n=',len(fire))\n        if addatt: print('    addAttacker', addatt[:20], 'n=',len(addatt))\n        if setatt: print('    setAttack', sorted(set(setatt)))\n        if justhit: print('    justHit', justhit[:10])\n        if loop: print('    loop', loop[:10])\n        if goto: print('    goto', goto[:15])\n        if embed: print('    embed', embed.groups() if hasattr(embed,'groups') else embed.group(1))\n        if public: print('    public', public)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":"Extract metadata from all Batch F AS files","current_dir":"/workspace/bvn-3.3","output_file":"/home/box/.grok/sessions/%2Fworkspace%2Fbvn-3.3/01a06ed4-cecf-7f70-bc8a-9b75d6ce8a02/terminal/call-056643bc-42ad-4a11-a16a-1fb16cf9f3d6-41.log","total_bytes":16962},"locations":[]}
