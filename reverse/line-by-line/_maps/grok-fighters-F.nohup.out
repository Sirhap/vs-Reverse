e\n    embed ('/_assets/1_snd_hurt1.mp3',)\n","exit_code":0,"command":"python3 - <<'PY'\nimport re, pathlib\nroot = pathlib.Path('/workspace/bvn-3.3/decompiled/fighters')\nfighters = ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']\nfor f in fighters:\n    print('='*60, f)\n    for p in sorted((root/f/'scripts').rglob('*.as')):\n        text = p.read_text(encoding='utf-8', errors='replace')\n        cls = re.search(r'class (\\S+)', text)\n        nlines = text.count('\\n')+1\n        has_att = 'setAttackerCtrler' in text\n        has_fc = 'setFighterCtrler' in text\n        faces = re.findall(r'defineBishaFace\\(\"([^\"]+)\"', text)\n        sounds = re.findall(r'defineHurt\\w*Sound\\(([^)]+)\\)', text)\n        speed = re.search(r'speed\\s*=\\s*([0-9.]+)', text)\n        jump = re.search(r'jumpPower\\s*=\\s*([0-9.]+)', text)\n        heavy = re.search(r'\\.heavy\\s*=\\s*([0-9.]+)', text)\n        defn = re.search(r'defenseType\\s*=\\s*(\\d+)', text)\n        wankai = 'doWanKai' in text or 'startWanKai' in text or 'endWanKai' in text\n        addhp = 'addHp' in text\n        fire = re.findall(r'\\.fire\\(\"([^\"]+)\"', text)\n        addatt = re.findall(r'addAttacker\\(\"([^\"]+)\"', text)\n        setatt = re.findall(r'setAttack\\(\"([^\"]+)\"', text)\n        justhit = re.findall(r'justHitToPlay\\(\"([^\"]+)\"', text)\n        loop = re.findall(r'\\.loop\\(\"([^\"]+)\"', text)\n        goto = re.findall(r'gotoAndPlay\\(\"([^\"]+)\"', text)\n        frames = re.findall(r'function (frame\\d+)', text)\n        public = re.findall(r'public var (\\S+):', text)\n        embed = re.search(r'source=\"([^\"]+)\".*?symbol=\"([^\"]+)\"', text, re.S) or re.search(r'source=\"([^\"]+)\"', text)\n        print(f\"  {p.relative_to(root/f/'scripts')}  lines={nlines} cls={cls.group(1) if cls else '?'} frames={len(frames)} att={has_att} fc={has_fc} wankai={wankai} addhp={addhp}\")\n        if faces: print('    faces', faces)\n        if sounds: print('    sounds', sounds)\n        if speed: print('    stats', speed.group(1), jump.group(1) if jump else '-', heavy.group(1) if heavy else '-', defn.group(1) if defn else '-')\n        if fire: print('    fire', fire[:20], 'n=',len(fire))\n        if addatt: print('    addAttacker', addatt[:20], 'n=',len(addatt))\n        if setatt: print('    setAttack', sorted(set(setatt)))\n        if justhit: print('    justHit', justhit[:10])\n        if loop: print('    loop', loop[:10])\n        if goto: print('    goto', goto[:15])\n        if embed: print('    embed', embed.groups() if hasattr(embed,'groups') else embed.group(1))\n        if public: print('    public', public)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":16962},"locations":[]}
