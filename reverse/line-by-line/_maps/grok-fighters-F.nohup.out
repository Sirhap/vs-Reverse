elBody', 'setTouchFloor', 'setZhao1', 'setZhao2', 'setZhao3', 'shadow', 'shake', 'shine', 'slowDown', 'speed', 'startShake', 'startWanKai', 'stop', 'stopMove', 'walk']\n\n=== extra defineAction fields ===\norochimaru []\npain []\nrenji []\nrukia []\nsakura []\nsasuke []\nsasuke_xz []\n\n=== wanKai / unique fighter_ctrler ===\norochimaru 一护全动作_1.as moveToTarget\npain 佩恩_1.as justHit\npain 佩恩_1.as moveToTarget\npain 佩恩_1.as applyG\nrenji 一护全动作_1.as moveToTarget\nrenji 一护全动作_1.as applyG\nrukia 露琪雅2_8.as endWanKai\nrukia 露琪雅2_8.as moveToTarget\nrukia 露琪雅_1.as doWanKai\nrukia 露琪雅_1.as startWanKai\nrukia 露琪雅_1.as moveToTarget\nsakura 樱_1.as moveToTarget\nsasuke 佐助_1.as doWanKai\nsasuke 佐助_1.as startWanKai\nsasuke 佐助_1.as justHit\nsasuke 佐助_1.as moveToTarget\nsasuke 佐助_1.as applyG\nsasuke 佐助咒化_12.as endWanKai\nsasuke 佐助咒化_12.as moveToTarget\nsasuke 佐助咒化_12.as applyG\nsasuke_xz 须作_1.as justHit\nsasuke_xz 须作_1.as moveToTarget\nsasuke_xz 须作_1.as applyG\n","exit_code":0,"command":"python3 - <<'PY'\nimport re, pathlib\nroot = pathlib.Path('/workspace/bvn-3.3/decompiled/fighters')\nfighters = ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']\n# unique method calls\ncalls = set()\nfor f in fighters:\n    for p in (root/f/'scripts').rglob('*.as'):\n        text = p.read_text(encoding='utf-8', errors='replace')\n        for m in re.finditer(r'\\$\\w+_ctrler\\.(\\w+)', text):\n            calls.add(m.group(0) if False else m.group(1))\n        for m in re.finditer(r'parent\\.\\$\\w+_ctrler\\.(\\w+)', text):\n            calls.add(m.group(1))\n        for m in re.finditer(r'\\$effect_ctrler\\.(\\w+)', text):\n            calls.add('effect.'+m.group(1))\nprint('methods:', sorted(calls))\n\nprint('\\n=== extra defineAction fields ===')\nfor f in fighters:\n    p = next((root/f/'scripts').rglob('MainTimeline.as'))\n    text = p.read_text()\n    keys=set()\n    for obj in re.findall(r'defineAction\\(\"[^\"]+\",\\s*\\{([^}]+)\\}', text):\n        for k in re.findall(r'(\\w+)\\s*:', obj):\n            keys.add(k)\n    print(f, sorted(keys))\n\nprint('\\n=== wanKai / unique fighter_ctrler ===')\nfor f in fighters:\n    for p in (root/f/'scripts').rglob('*.as'):\n        text = p.read_text()\n        for pat in ['doWanKai','startWanKai','endWanKai','addHp','setCross','justHit','moveToTarget','setHurtAction','recoveryBisha','target.visible','applyG','checkDirect']:\n            if pat in text:\n                print(f, p.name, pat)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":1958},"locations":[]}
