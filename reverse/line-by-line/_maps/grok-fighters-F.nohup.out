zh2mian','zh3mian','bsmian','sbsmian','kbsmian','cbsmian']\nfor f in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    for p in (root/f/'scripts').rglob('*AI*.as'):\n        t=p.read_text()\n        pubs=re.findall(r'public var (\\w+):', t)\n        mian=[x for x in pubs if x.endswith('mian')]\n        miss=[x for x in GETALL if x not in mian]\n        extra=[x for x in mian if x not in GETALL]\n        print(f, p.name, 'miss', miss, 'extra', extra)\n\n# orochimaru defineDieSound\nprint('\\n=== orochimaru sounds raw ===')\nt=(root/'orochimaru/scripts/orochimaru_fla/MainTimeline.as').read_text()\nfor m in re.finditer(r'define\\w*Sound\\([^)]+\\)', t):\n    print(m.group(0))\nprint('--- pain ---')\nt=(root/'pain/scripts/pain_fla/MainTimeline.as').read_text()\nfor m in re.finditer(r'define\\w*Sound\\([^)]+\\)', t):\n    print(m.group(0))\nprint('--- sakura ---')\nt=(root/'sakura/scripts/sakura_fla/MainTimeline.as').read_text()\nprint('hurt' in t, 'snd' in t)\nprint('--- sasuke_xz kbs ---')\nt=(root/'sasuke_xz/scripts/sasuke_xz_fla/MainTimeline.as').read_text()\nprint('kbs' in t)\nprint(re.findall(r'defineAction\\(\"([^\"]+)\"', t))\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":0},"locations":[]}
