, 'kj1', 'kj2', 'zh1', 'zh2', 'zh3', 'sh1', 'sh12', 'sh2', 'sh22', 'bs', 'bs1', 'bs2', 'sbs1', 'sbs', 'cbs', 'cbs2']\nrukia as 42 md 47 MISMATCH\n  as ['tk', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj2', 'zh1', 'zh2', 'zh3', 'sh1', 'sh12', 'sh2', 'sh22', 'bs', 'sbs', 'cbs1', 'cbs', 'tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'kj11', 'kj1', 'kj2', 'kj21', 'zh1', 'zh2', 'zh3', 'zh31', 'sh1', 'sh12', 'sh2', 'sh21', 'sh22', 'bs', 'sbs', 'cbs1', 'cbs', 'cbs2']\n  md ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction', 'tk', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj2', 'zh1', 'zh2', 'zh3', 'sh1', 'sh12', 'sh2', 'sh22', 'bs', 'sbs', 'cbs1', 'cbs', 'tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'kj11', 'kj1', 'kj2', 'kj21', 'zh1', 'zh2', 'zh3', 'zh31', 'sh1', 'sh12', 'sh2', 'sh21', 'sh22', 'bs', 'sbs', 'cbs1', 'cbs', 'cbs2']\nsakura as 29 md 34 MISMATCH\n  as ['tk', 'tz1', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj11', 'kj21', 'kj2', 'zh1', 'zh12', 'zh2', 'zh3', 'zh31', 'zh32', 'bs', 'bs1', 'sbs2', 'sbs', 'kbs2', 'kbs', 'cbs1', 'cbs2', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\n  md ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction', 'tk', 'tz1', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj11', 'kj21', 'kj2', 'zh1', 'zh12', 'zh2', 'zh3', 'zh31', 'zh32', 'bs', 'bs1', 'sbs2', 'sbs', 'kbs2', 'kbs', 'cbs1', 'cbs2', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\nsasuke as 44 md 49 MISMATCH\n  as ['tk', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj21', 'kj2', 'zh1', 'zh12', 'zh2', 'zh3', 'zh31', 'bs', 'sbs', 'sbs2', 'cbs1', 'cbs2', 'cbs3', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22', 'tk', 'tz', 'k1', 'k2', 'k3', 'kj2', 'kj1', 'zh1', 'zh2', 'zh3', 'bs1', 'bs', 'bs2', 'sbs', 'cbs1', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\n  md ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction', 'tk', 'tz', 'k1', 'k2', 'k3', 'kj1', 'kj21', 'kj2', 'zh1', 'zh12', 'zh2', 'zh3', 'zh31', 'bs', 'sbs', 'sbs2', 'cbs1', 'cbs2', 'cbs3', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22', 'tk', 'tz', 'k1', 'k2', 'k3', 'kj2', 'kj1', 'zh1', 'zh2', 'zh3', 'bs1', 'bs', 'bs2', 'sbs', 'cbs1', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\nsasuke_xz as 30 md 35 MISMATCH\n  as ['tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'k5', 'kj1', 'kj11', 'kj12', 'kj21', 'kj2', 'zh1', 'zh11', 'zh2', 'zh21', 'zh22', 'zh3', 'zh31', 'bs', 'sbs', 'kbs', 'cbs1', 'cbs2', 'cbs3', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\n  md ['mc', '$fighter_ctrler', '$mc_ctrler', '$effect_ctrler', 'defineAction', 'tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'k5', 'kj1', 'kj11', 'kj12', 'kj21', 'kj2', 'zh1', 'zh11', 'zh2', 'zh21', 'zh22', 'zh3', 'zh31', 'bs', 'sbs', 'kbs', 'cbs1', 'cbs2', 'cbs3', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22']\n\n=== action MC frame coverage ===\n一护全动作_1.as as 89 md F-rows 89 unique 89\n佩恩_1.as as 99 md F-rows 99 unique 99\n一护全动作_1.as as 89 md F-rows 89 unique 89\n露琪雅2_8.as as 84 md F-rows 84 unique 84\n露琪雅_1.as as 84 md F-rows 84 unique 84\n樱_1.as as 104 md F-rows 104 unique 104\n佐助_1.as as 103 md F-rows 103 unique 103\n佐助咒化_12.as as 84 md F-rows 84 unique 84\n须作_1.as as 110 md F-rows 110 unique 110\n\n=== key calls in action md ===\n\n=== engine path existence ===\nbad paths 0\n\n=== MainTimeline extras ===\norochimaru True True True True True\npain True True True True True\nrenji True True True True True\nrukia True True True True True\nsakura True True True True True\nsasuke True True True True True\nsasuke_xz True True True True True\n","exit_code":0,"command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\nROOT = Path('/workspace/bvn-3.3')\nSRC = ROOT/'decompiled/fighters'\nOUT = ROOT/'reverse/line-by-line/fighters'\nLIST = ROOT/'reverse/line-by-line/_maps/fighters-batch-F-files.txt'\nfiles = [Path(p.strip()) for p in LIST.read_text().splitlines() if p.strip()]\n\nprint('=== missing md ===')\nmissing=0\nfor p in files:\n    md = OUT / p.relative_to(SRC).with_suffix('.md')\n    if not md.exists() or md.stat().st_size < 200:\n        print(' MISSING/STUB', md, md.stat().st_size if md.exists() else 0)\n        missing += 1\nprint('missing', missing, 'total', len(files))\n\n# HitVO counts\nfrom collections import defaultdict\nprint('\\n=== HitVO counts vs source ===')\nfor fighter in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    as_p = next((SRC/fighter/'scripts').rglob('MainTimeline.as'))\n    md_p = OUT / as_p.relative_to(SRC).with_suffix('.md')\n    as_ids = re.findall(r'defineAction\\(\"([^\"]+)\"', as_p.read_text())\n    md_t = md_p.read_text()\n    # table rows with `id`\n    md_ids = re.findall(r'\\| L\\d+ \\| `([^`]+)` \\|', md_t)\n    print(fighter, 'as', len(as_ids), 'md', len(md_ids), 'OK' if as_ids==md_ids else 'MISMATCH')\n    if as_ids != md_ids:\n        print('  as', as_ids)\n        print('  md', md_ids)\n\n# frame counts\nprint('\\n=== action MC frame coverage ===')\nfor fighter in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    for as_p in (SRC/fighter/'scripts').rglob('*.as'):\n        t = as_p.read_text()\n        if 'AImain' not in t or 'setFighterCtrler' in t:\n            continue\n        md_p = OUT / as_p.relative_to(SRC).with_suffix('.md')\n        as_frames = re.findall(r'function (frame\\d+)', t)\n        md_t = md_p.read_text()\n        md_f = re.findall(r'\\| F(\\d+) \\|', md_t)\n        print(as_p.name, 'as', len(as_frames), 'md F-rows', len(md_f), 'unique', len(set(md_f)))\n        as_nos = [int(x[5:]) for x in as_frames]\n        md_nos = [int(x) for x in md_f]\n        if sorted(as_nos) != sorted(md_nos):\n            print('  MISSING', sorted(set(as_nos)-set(md_nos)))\n            print('  EXTRA', sorted(set(md_nos)-set(as_nos)))\n\n# key calls present\nprint('\\n=== key calls in action md ===')\nfor fighter in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    for as_p in (SRC/fighter/'scripts').rglob('*.as'):\n        t = as_p.read_text()\n        md_p = OUT / as_p.relative_to(SRC).with_suffix('.md')\n        if not md_p.exists():\n            continue\n        md = md_p.read_text()\n        for pat, label in [\n            ('doWanKai','doWanKai'),\n            ('startWanKai','startWanKai'),\n            ('endWanKai','endWanKai'),\n            ('addAttacker','addAttacker'),\n            ('.fire(','fire'),\n            ('justHitToPlay','justHitToPlay'),\n            ('moveToTarget','moveToTarget'),\n            ('setSteelBody','setSteelBody'),\n        ]:\n            if pat in t and pat not in md and label not in md:\n                print('MISSING', label, 'in', md_p.name)\n\n# engine paths\nprint('\\n=== engine path existence ===')\nbad=0\nfor md in OUT.rglob('*.md'):\n    if not any(x in str(md) for x in ['orochimaru','pain','renji','rukia','sakura','sasuke']):\n        continue\n    if 'sasuke_xz_old' in str(md):\n        continue\n    t = md.read_text()\n    for m in re.finditer(r'\\]\\(([^)]+engine/[^)]+)\\)', t):\n        target = (md.parent / m.group(1)).resolve()\n        if not target.exists():\n            print('BAD', md.relative_to(OUT), m.group(1), '->', target)\n            bad += 1\n            break\nprint('bad paths', bad)\n\n# MainTimeline extra\nprint('\\n=== MainTimeline extras ===')\nfor fighter in ['orochimaru','pain','renji','rukia','sakura','sasuke','sasuke_xz']:\n    md = next((OUT/fighter/'scripts').rglob('MainTimeline.md'))\n    t = md.read_text()\n    print(fighter,\n          'speed' in t,\n          'defineBishaFace' in t,\n          'initMc' in t,\n          'defenseType' in t,\n          '未注入' in t)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":4724},"locations":[]}
