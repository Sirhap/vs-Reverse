{"type":"tool_call","toolCallId":"call-7838ae58-5639-48ba-8734-bb0741e7cb52-70","title":"write","kind":"write","status":"pending","toolName":"write","rawInput":{"file_path":"/tmp/gen_fighters_f.py","content":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"content":[],"locations":[]}
{"type":"tool_call_update","toolCallId":"call-7838ae58-5639-48ba-8734-bb0741e7cb52-70","status":null,"content":[{"type":"diff","path":"/tmp/gen_fighters_f.py","oldText":"","newText":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}],"rawOutput":null,"locations":[{"path":"/tmp/gen_fighters_f.py"}]}
{"type":"tool_call_update","toolCallId":"call-7838ae58-5639-48ba-8734-bb0741e7cb52-70","status":"completed","content":[{"type":"diff","path":"/tmp/gen_fighters_f.py","oldText":"","newText":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n","_meta":{"details":[{"old_string":"","old_line":1,"new_string":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n","new_line":1,"context_before":"","context_after":"","line_prefix":""}]}}],"rawOutput":{"type":"SearchReplace","EditsApplied":{"old_string":"","new_string":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n","tool_output_for_prompt":"The file /tmp/gen_fighters_f.py has been created.","tool_output_for_prompt_concise":"The file /tmp/gen_fighters_f.py has been created.","absolute_path":"/tmp/gen_fighters_f.py","edits":{"details":[{"old_string":"","old_line":1,"new_string":"#!/usr/bin/env python3\n\"\"\"Generate line-by-line Chinese notes for fighters Batch F.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom pathlib import Path\n\nROOT = Path(\"/workspace/bvn-3.3\")\nSRC = ROOT / \"decompiled/fighters\"\nOUT = ROOT / \"reverse/line-by-line/fighters\"\nLIST = ROOT / \"reverse/line-by-line/_maps/fighters-batch-F-files.txt\"\n\nHITTYPE = {\n    0: \"? 未知\",\n    1: \"KAN 砍\",\n    2: \"DA 打\",\n    3: \"DA_HEAVY 重打\",\n    4: \"MAGIC 忍术/鬼道\",\n    5: \"MAGIC_HEAVY 重法\",\n    6: \"KAN_HEAVY 重砍\",\n    7: \"FIRE 火\",\n    8: \"ICE 冰\",\n    9: \"ELECTRIC 雷\",\n    10: \"STONE 石化\",\n    11: \"CATCH 抓\",\n}\n\nGETALL = [\n    (\"tkanmian\", \"JUMP_ATTACK 跳轻\"),\n    (\"tzmian\", \"JUMP_SKILL 跳重\"),\n    (\"kanmian\", \"ATTACK 地面轻\"),\n    (\"kj1mian\", \"SKILL1 下攻\"),\n    (\"kj2mian\", \"SKILL2 上攻\"),\n    (\"zh1mian\", \"ZHAO1\"),\n    (\"zh2mian\", \"ZHAO2\"),\n    (\"zh3mian\", \"ZHAO3\"),\n    (\"bsmian\", \"BISHA 必杀\"),\n    (\"sbsmian\", \"BISHA_UP 上必\"),\n    (\"kbsmian\", \"BISHA_AIR 空必\"),\n    (\"cbsmian\", \"BISHA_SUPER 超必\"),\n]\nGETALL_NAMES = [n for n, _ in GETALL]\n\nFIGHTER_CN = {\n    \"orochimaru\": \"大蛇丸\",\n    \"pain\": \"佩恩\",\n    \"renji\": \"阿散井·恋次\",\n    \"rukia\": \"朽木·露琪亚\",\n    \"sakura\": \"春野·樱\",\n    \"sasuke\": \"宇智波·佐助\",\n    \"sasuke_xz\": \"宇智波·佐助 须佐能乎\",\n}\n\nCOMIC = {\n    \"orochimaru\": (1, \"火影\"),\n    \"pain\": (1, \"火影\"),\n    \"renji\": (0, \"死神\"),\n    \"rukia\": (0, \"死神\"),\n    \"sakura\": (1, \"火影\"),\n    \"sasuke\": (1, \"火影\"),\n    \"sasuke_xz\": (1, \"火影\"),\n}\n\nXML_ROWS = {\n    \"orochimaru\": [(\"orochimaru\", \"大蛇丸\", 1)],\n    \"pain\": [(\"pain\", \"佩恩\", 1)],\n    \"renji\": [(\"renji\", \"阿散井·恋次\", 1)],\n    \"rukia\": [(\"rukia\", \"朽木·露琪亚 义骸\", 1), (\"rukia_shijie\", \"朽木·露琪亚 始解\", 2)],\n    \"sakura\": [(\"sakura\", \"春野·樱\", 1)],\n    \"sasuke\": [(\"sasuke\", \"宇智波·佐助\", 1), (\"sasuke_zy\", \"宇智波·佐助 咒怨\", 2)],\n    \"sasuke_xz\": [(\"sasuke_xz\", \"宇智波·佐助 须佐能乎\", 1)],\n}\n\nSWF = {\n    \"orochimaru\": \"assets/fighter/orochimaru.swf\",\n    \"pain\": \"assets/fighter/pain.swf\",\n    \"renji\": \"assets/fighter/renji.swf\",\n    \"rukia\": \"assets/fighter/rukia.swf\",\n    \"sakura\": \"assets/fighter/sakura.swf\",\n    \"sasuke\": \"assets/fighter/sasuke.swf\",\n    \"sasuke_xz\": \"assets/fighter/sasuke_xz.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"orochimaru\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n    \"renji\": \"动作 MC 类名误作 `一护全动作_1`（一护 FLA 模板残留）。\",\n}\n\n\ndef compact_ws(s: str) -> str:\n    s = re.sub(r\"\\s+\", \" \", s).strip()\n    s = s.replace(\"{ \", \"{\").replace(\" }\", \"}\")\n    s = s.replace(\", \", \",\")\n    # restore a bit of readability around objects\n    s = s.replace(\"{\", \"{ \").replace(\"}\", \" }\")\n    s = re.sub(r\"\\s+\", \" \", s)\n    s = s.replace(\"{ }\", \"{}\")\n    return s.strip()\n\n\ndef strip_this_parent(s: str) -> str:\n    s = re.sub(r\"\\bthis\\.\", \"\", s)\n    s = re.sub(r\"\\bparent\\.\", \"\", s)\n    return s\n\n\ndef engine_prefix(md_rel: Path) -> str:\n    # md_rel relative to fighters/\n    return \"../\" * len(md_rel.parts)\n\n\ndef match_braces(text: str, open_idx: int) -> int:\n    \"\"\"open_idx points at '{'. Return index after matching '}'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(text)\n    while i < n:\n        c = text[i]\n        if c == \"{\":\n            depth += 1\n        elif c == \"}\":\n            depth -= 1\n            if depth == 0:\n                return i + 1\n        i += 1\n    return n\n\n\ndef extract_object_literal(text: str, start_from: int) -> tuple[str, int]:\n    i = text.find(\"{\", start_from)\n    if i < 0:\n        return \"\", start_from\n    j = match_braces(text, i)\n    return text[i:j], j\n\n\ndef parse_kv_object(obj: str) -> dict:\n    inner = obj.strip()\n    if inner.startswith(\"{\"):\n        inner = inner[1:-1]\n    out = {}\n    for m in re.finditer(r\"(\\w+)\\s*:\\s*([^,}\\n]+)\", inner):\n        k = m.group(1)\n        v = m.group(2).strip().rstrip(\",\")\n        if v in (\"true\", \"false\"):\n            out[k] = v == \"true\"\n        else:\n            try:\n                if \".\" in v:\n                    out[k] = float(v)\n                else:\n                    out[k] = int(v)\n            except ValueError:\n                out[k] = v\n    return out\n\n\ndef line_starts(text: str) -> list[int]:\n    \"\"\"Return start offset of each 1-based line.\"\"\"\n    starts = [0]\n    for i, c in enumerate(text):\n        if c == \"\\n\":\n            starts.append(i + 1)\n    return starts\n\n\ndef offset_to_line(starts: list[int], off: int) -> int:\n    lo, hi = 0, len(starts) - 1\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if starts[mid] <= off:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo + 1\n\n\ndef parse_as(path: Path) -> dict:\n    text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    if text.endswith(\"\\n\"):\n        nlines = text.count(\"\\n\")\n    else:\n        nlines = text.count(\"\\n\") + 1\n    starts = line_starts(text)\n    pkg_m = re.search(r\"^package\\s+(\\S+)?\", text, re.M)\n    pkg = (pkg_m.group(1) or \"\").strip() if pkg_m else \"\"\n    cls_m = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n    cls = cls_m.group(1) if cls_m else path.stem\n    ext = cls_m.group(2) if cls_m else \"\"\n    embed_src = None\n    embed_sym = None\n    em = re.search(r'\\[Embed\\(source=\"([^\"]+)\"(?:, symbol=\"([^\"]+)\")?\\)\\]', text)\n    if em:\n        embed_src = em.group(1)\n        embed_sym = em.group(2)\n\n    fields = []\n    for m in re.finditer(r\"public var (\\S+):(\\S+);\", text):\n        fields.append(\n            {\n                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\")\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if st.startswith(\"if(!$fighter_ctrler)\") or st.startswith(\"if(! $fighter_ctrler)\"):\n                    lines.append(f\"- L{ff['start']+1}: `if(!$fighter_ctrler){ return; }` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n","new_line":1,"context_before":"","context_after":"","line_prefix":""}]}}},"locations":[]}
