.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n980→    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n990→    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]","absolute_path":"/tmp/gen_fighters_f.py","offset":600,"limit":400,"raw_output":"    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\") + 1\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n            if depth == 0:\n                stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n                if stmt.startswith(\"if(\") or stmt.startswith(\"if (\"):\n                    if \"defineAction\" not in stmt:\n                        out_stmts.append((func[\"start\"] + stmt_line + 1, stmt))\n                    buf = []\n                    stmt_line = line_rel\n                    i += 1\n                    continue\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line + 1, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n    if \"initMc\" in stmt:\n        return \"把内部动作 MC 交给 FighterMC\"\n    return annotate_call(stmt)\n\n\ndef hitvo_table(items: list[dict]) -> list[str]:\n    lines = []\n    lines.append(\"| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\")\n    lines.append(\"|---|---|---|---|---|---|---|---|---|---|\")\n    for it in items:\n        kv = it[\"kv\"]\n        ht = kv.get(\"hitType\", \"\")\n        ht_s = f\"{ht} {HITTYPE.get(int(ht), '?')}\" if ht != \"\" else \"\"\n        br = kv.get(\"isBreakDef\", False)\n        br_s = \"true\" if br is True else \"false\" if br is False else str(br)\n        lines.append(\n            f\"| L{it['line']} | `{it['id']}` | {id_meaning(it['id'])} | {kv.get('power','')} | {ht_s} | {kv.get('hitx','')} | {kv.get('hity','')} | {kv.get('hurtTime','')} | {kv.get('hurtType','')} | {br_s} |\"\n        )\n    return lines\n\n\ndef md_stub_bitmap(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    ctor = info[\"ctor\"]\n    w, h = \"?\", \"?\"\n    if ctor:\n        m = re.search(r\"param1:int = (\\d+), param2:int = (\\d+)\", ctor[\"params\"])\n        if m:\n            w, h = m.group(1), m.group(2)\n    src = info[\"embed_src\"] or \"\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — 必杀脸 BitmapData {w}×{h}\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：必杀脸 `BitmapData` 导出类，尺寸 {w}×{h}。`MainTimeline` `defineBishaFace` 把本 Class 交给 `FighterEffectCtrl.setBishaFace`；`BishaFaceEffectView` 弹出。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    pfx = engine_prefix(md_rel)\n    lines.append(\n        f\"无名包导出。[`FighterCtrler.defineBishaFace`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 只存 Class，真正 `new` 在特效视图。本批 `{fighter}` 的脸图：见同目录 `MainTimeline`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends BitmapData`。\")\n    lines.append(\n        f\"- **构造** `(param1:int = {w}, param2:int = {h})`：`super(param1,param2)`，默认 {w}×{h}。无其它逻辑。\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_stub_sound(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    src = info[\"embed_src\"] or \"\"\n    pfx = engine_prefix(md_rel)\n    kind = \"受击\"\n    if \"die\" in cls:\n        kind = \"死亡\"\n    elif \"fly\" in cls:\n        kind = \"击飞\"\n    lines = []\n    lines.append(f\"# `(无名包).{cls}` — {kind}语音 Sound\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{kind}语音 `Sound` 导出。`MainTimeline` `defineHurtSound` / `defineHurtFlySound` / `defineDieSound` 把本 Class 交给 `FighterVoiceCtrler.setVoice`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"[`FighterCtrler.defineHurtSound`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md) 把 rest Class 存进 voice 0；Fly=1、Die=2。McCtrler 受击时按类型随机播。本文件 `{fighter}/{cls}`。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_sym\"]:\n        lines.append(\n            f\"- **Embed** `source=\\\"{src}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n        )\n    else:\n        lines.append(f\"- **Embed** `source=\\\"{src}\\\"`。\")\n    lines.append(f\"- **类** `public dynamic class {cls} extends Sound`。\")\n    lines.append(\"- **构造** 空 `super()`。无循环、无音量。\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef md_ai(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    pubs = [f[\"name\"] for f in info[\"fields\"]]\n    mian = [n for n in pubs if n.endswith(\"mian\")]\n    miss = [n for n in GETALL_NAMES if n not in mian]\n    extra = [n for n in mian if n not in GETALL_NAMES]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — AI 判定面 AImain\")\n    lines.append(\"\")\n    lines.append(\n        \"一句话目的：动作 MC 上的 `AImain` 元件类：AI/距离判定「面」。`FighterMC.initHitRange` 把本 clip `gotoAndStop(2)`，按 `FighterHitRange.getALL()` 取 `*mian` bounds，再 `gotoAndStop(1)` 并 `visible=false`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    miss_s = \"、\".join(f\"`{x}`\" for x in miss) if miss else \"无\"\n    extra_s = \"、\".join(f\"`{x}`\" for x in extra)\n    hook = (\n        f\"实例名必须是 `AImain`（`FighterMC.getChildByName(\\\"AImain\\\")`）。`renderChildren` 跳过它，不自动播。[`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 常量对应下列子件。缺某个 `*mian` 则该招没有独立 AI 范围盒。\"\n    )\n    if miss:\n        hook += f\" 缺：{miss_s} → 对应招没有独立 AI 范围盒。\"\n    if extra:\n        hook += f\" 多余 {extra_s}（不在 `getALL()`，? 不采样）。\"\n    lines.append(hook)\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"- **构造** `addFrameScript(0, frame1)`。\")\n    lines.append(\"- **`frame1`**：`stop()`。运行时真正被拨到第 2 帧采样，第 1 帧是收起态。\")\n    lines.append(\"\")\n    lines.append(\"| L | 子件 | `FighterHitRange` |\")\n    lines.append(\"|---|---|---|\")\n    name2desc = dict(GETALL)\n    for f in info[\"fields\"]:\n        desc = name2desc.get(f[\"name\"], \"不在 getALL()，? 不采样\")\n        lines.append(f\"| L{f['line']} | `{f['name']}` | {desc} |\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef collect_stats(func: dict) -> dict:\n    body = func[\"body\"]\n    def g(pat):\n        m = re.search(pat, body)\n        return m.group(1) if m else None\n    return {\n        \"speed\": g(r\"speed\\s*=\\s*([0-9.]+)\"),\n        \"jump\": g(r\"jumpPower\\s*=\\s*([0-9.]+)\"),\n        \"heavy\": g(r\"\\.heavy\\s*=\\s*([0-9.]+)\"),\n        \"def\": g(r\"defenseType\\s*=\\s*(\\d+)\"),\n        \"faces\": re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', body),\n        \"hurt\": re.search(r\"defineHurtSound\\(([^)]+)\\)\", body),\n        \"fly\": re.search(r\"defineHurtFlySound\\(([^)]+)\\)\", body),\n        \"die\": re.search(r\"defineDieSound\\(([^)]+)\\)\", body),\n    }\n\n\ndef md_main(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    comic_n, comic_s = COMIC[fighter]\n    xmls = XML_ROWS[fighter]\n    swf = SWF[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — {cn} 根时间轴\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：{cn} 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"可玩角色 SWF 文档类。[`FighterMain.initlize`]({pfx}engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\"\n    )\n    lines.append(\"\")\n    lines.append(\n        f\"门面见 [`FighterCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\"\n    )\n    lines.append(\"\")\n    xml_bits = []\n    for xid, xname, sf in xmls:\n        xml_bits.append(f\"`{xid}` startFrame={sf}（{xname}）\")\n    lines.append(\n        f\"XML：{'；'.join(xml_bits)}；文件 `{swf}`；comic_type {comic_n} {comic_s}。引擎 `gotoAndStop(startFrame+1)`，因此 sf=1 → 时间轴 F2\"\n        + (\"，sf=2 → F3。\" if any(sf == 2 for _, _, sf in xmls) else \"。\")\n    )\n    lines.append(\"\")\n\n    # per-frame stats\n    frame_funcs = [f for f in info[\"funcs\"] if re.fullmatch(r\"frame\\d+\", f[\"name\"])]\n    frame_funcs.sort(key=lambda x: int(x[\"name\"][5:]))\n    for ff in frame_funcs:\n        if ff[\"name\"] == \"frame1\":\n            continue\n        st = collect_stats(ff)\n        defn = \"斩防\" if st[\"def\"] == \"0\" else \"拳防\" if st[\"def\"] == \"1\" else st[\"def\"]\n        face_s = \"、\".join(f\"`{a}`←`{b}`\" for a, b in st[\"faces\"]) or \"无\"\n        snd_parts = []\n        if st[\"hurt\"]:\n            snd_parts.append(f\"`defineHurtSound({st['hurt'].group(1)})`\")\n        if st[\"fly\"]:\n            snd_parts.append(f\"`defineHurtFlySound({st['fly'].group(1)})`\")\n        if st[\"die\"]:\n            snd_parts.append(f\"`defineDieSound({st['die'].group(1)})`\")\n        snd_s = \"；\".join(snd_parts) if snd_parts else \"本形态 **未** `defineHurtSound*`（库里也可能没有 `snd_*`）。? 受击无声\"\n        fn = int(ff[\"name\"][5:])\n        lines.append(\n            f\"F{fn}：speed={st['speed']} / jump={st['jump']} / heavy={st['heavy']} / {defn}。必杀脸：{face_s}。语音：{snd_s}。\"\n        )\n    if fighter in TEMPLATE_NOTE:\n        lines.append(TEMPLATE_NOTE[fighter])\n    lines.append(\"\")\n    lines.append(\n        f\"HitVO 字段见 [`HitVO`]({pfx}engine/game/bvn/fighter/models/HitVO.md)。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n\n    ctor = info[\"ctor\"]\n","total_lines":1323}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-8a539df8-5e41-4b00-b720-052ffe6baca0-39","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1000→    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n1010→                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n1020→        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n1030→            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n1040→        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n1050→        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n1060→            for ln, st in extras:\n                if \"if(!$fighter_ctrler)\" in st.replace(\" \", \"\") or \"if(!$fighter_ctrler)\" in st:\n                    lines.append(f\"- L{ln}: `if(!$fighter_ctrler){{return;}}` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n1070→    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n1080→    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n1090→    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n1100→        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n1110→    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n1120→    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n1130→    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n1140→    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n1150→    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n1160→        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n1170→    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n1180→        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n1190→            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n1200→            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n1210→    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm