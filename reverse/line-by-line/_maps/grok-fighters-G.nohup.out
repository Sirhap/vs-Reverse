+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n580→                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n590→        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"","absolute_path":"/tmp/gen_fighters_f.py","offset":200,"limit":400,"raw_output":"                \"name\": m.group(1),\n                \"type\": m.group(2),\n                \"line\": offset_to_line(starts, m.start()),\n            }\n        )\n\n    # functions\n    funcs = []\n    for m in re.finditer(\n        r\"(public|internal|private)?\\s*function (\\S+)\\((.*?)\\)(?:\\s*:\\s*(\\S+))?\\s*\\{\",\n        text,\n        re.S,\n    ):\n        name = m.group(2)\n        params = compact_ws(m.group(3) or \"\")\n        ret = m.group(4) or \"\"\n        body_open = m.end() - 1\n        body_end = match_braces(text, body_open)\n        body = text[body_open + 1 : body_end - 1]\n        start_l = offset_to_line(starts, m.start())\n        end_l = offset_to_line(starts, body_end - 1)\n        funcs.append(\n            {\n                \"name\": name,\n                \"params\": params,\n                \"ret\": ret,\n                \"body\": body,\n                \"start\": start_l,\n                \"end\": end_l,\n                \"vis\": m.group(1) or \"\",\n            }\n        )\n\n    frames = []\n    for f in funcs:\n        fm = re.fullmatch(r\"frame(\\d+)\", f[\"name\"])\n        if fm:\n            frames.append(\n                {\n                    **f,\n                    \"frame_no\": int(fm.group(1)),\n                }\n            )\n    frames.sort(key=lambda x: x[\"frame_no\"])\n\n    ctor = next((f for f in funcs if f[\"name\"] == cls), None)\n    addfs = \"\"\n    if ctor:\n        am = re.search(r\"addFrameScript\\((.*)\\)\\s*;\", ctor[\"body\"], re.S)\n        if am:\n            addfs = compact_ws(am.group(0))\n\n    return {\n        \"text\": text,\n        \"nlines\": nlines,\n        \"pkg\": pkg,\n        \"cls\": cls,\n        \"ext\": ext,\n        \"embed_src\": embed_src,\n        \"embed_sym\": embed_sym,\n        \"fields\": fields,\n        \"funcs\": funcs,\n        \"frames\": frames,\n        \"ctor\": ctor,\n        \"addfs\": addfs,\n        \"path\": path,\n    }\n\n\ndef field_desc(name: str) -> str:\n    if name == \"mc\":\n        return \"动作总 MC，`initMc` 用\"\n    if name == \"$fighter_ctrler\":\n        return \"引擎注入\"\n    if name == \"$mc_ctrler\":\n        return \"引擎注入\"\n    if name == \"$effect_ctrler\":\n        return \"引擎注入\"\n    if name == \"$attacker_ctrler\":\n        return \"攻击体控制器\"\n    if name == \"defineAction\":\n        return \"setFighterCtrler 写成 ctrler.defineAction\"\n    if name == \"AImain\":\n        return \"AI 判定面容器\"\n    if name == \"bdmn\":\n        return \"身体盒\"\n    if name.endswith(\"atm\"):\n        return \"攻击判定盒（displayName → HitVO）\"\n    if name.endswith(\"mian\"):\n        return \"AI 判定面子件\"\n    if name in (\"main\", \"mian\"):\n        return \"攻击体命中取样盒\"\n    if name == \"move_mc\":\n        return \"位移跟随辅助 MC（`moveTarget({followmc})`）\"\n    if name == \"fenshen\":\n        return \"分身攻击体 MC\"\n    if name in (\n        \"snake\",\n        \"zzz1\",\n        \"zz1\",\n        \"dao\",\n        \"huo\",\n        \"tianzhao\",\n        \"sbsmc\",\n        \"rjd\",\n        \"xld\",\n        \"stone\",\n        \"kj2\",\n        \"tk2\",\n        \"sbs1\",\n        \"zh1\",\n        \"zh2\",\n        \"zh20\",\n        \"zh3\",\n    ):\n        return \"攻击体 MC（`addAttacker` 名）\"\n    return \"子剪辑\"\n\n\ndef id_meaning(hid: str) -> str:\n    if hid == \"tk\" or re.fullmatch(r\"tk\\d+\", hid):\n        return \"跳轻/跳踢\" if hid == \"tk\" else f\"跳轻 段{hid[2:]}\"\n    if hid == \"tz\" or re.fullmatch(r\"tz\\d+\", hid):\n        return \"跳重\" if hid == \"tz\" else f\"跳重 段{hid[2:]}\"\n    if re.fullmatch(r\"k\\d+\", hid):\n        return f\"普攻 {hid[1:]}\"\n    if hid.startswith(\"kj\"):\n        rest = hid[2:]\n        if rest == \"1\":\n            return \"空中技 1 / 下攻\"\n        if rest == \"2\":\n            return \"空中技 2 / 上攻\"\n        return f\"空中技 {rest}\"\n    if hid.startswith(\"zh\"):\n        rest = hid[2:]\n        return f\"招 {rest}\" if rest else \"招\"\n    if hid.startswith(\"kbs\"):\n        return \"空必杀\" if hid == \"kbs\" else f\"空必杀 {hid[3:]}\"\n    if hid.startswith(\"sbs\"):\n        return \"上必杀\" if hid == \"sbs\" else f\"上必杀前段/多段\"\n    if hid.startswith(\"cbs\"):\n        return \"超必杀\" if hid == \"cbs\" else f\"超必杀前段/多段\"\n    if hid.startswith(\"bs\"):\n        return \"必杀\" if hid == \"bs\" else \"必杀前段/多段\"\n    if hid in (\"sh1\", \"sh2\"):\n        return f\"抓 {hid[-1]}（hitType 11）\"\n    if hid in (\"sh12\", \"sh22\"):\n        return f\"抓 {hid[2]} 伤害段\"\n    if hid.startswith(\"sh\"):\n        return f\"抓 {hid[2:]}\"\n    return hid\n\n\ndef parse_define_actions(body: str, text: str, starts: list[int], body_abs_off: int) -> list[dict]:\n    \"\"\"Find defineAction calls in a frame body. body is without surrounding braces.\"\"\"\n    items = []\n    for m in re.finditer(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body):\n        hid = m.group(1)\n        obj, _ = extract_object_literal(body, m.end() - 1)\n        kv = parse_kv_object(obj)\n        # line in file: need absolute offset. We don't have body abs easily.\n        items.append({\"id\": hid, \"kv\": kv, \"m\": m})\n    return items\n\n\ndef annotate_call(stmt: str) -> str:\n    s = stmt\n    note = \"\"\n    if \".walk(\" in s:\n        note = \"走路尘土\"\n    elif \".dashStop(\" in s:\n        note = \"停冲\"\n    elif re.search(r\"\\.dash\\(\", s) and \"effect\" not in s:\n        note = \"冲刺速度倍率\"\n    elif \".effect.dash(\" in s or \"$effect_ctrler.dash(\" in s:\n        note = \"冲刺特效 dash/dash_air\"\n    elif \".idle(\" in s:\n        note = \"回站立，重填允许表\"\n    elif \".endAct(\" in s:\n        note = \"结束当前招，清攻击允许\"\n    elif \".loop(\" in s:\n        note = \"走路循环标签\" if \"走\" in s else \"循环标签\"\n    elif \".setAttack(\" in s:\n        note = \"允许普攻接到指定帧标签\"\n    elif \".setZhao1(\" in s:\n        note = \"允许招 1\"\n    elif \".setZhao2(\" in s:\n        note = \"允许招 2\"\n    elif \".setZhao3(\" in s:\n        note = \"允许招 3\"\n    elif \".setSkill1(\" in s:\n        note = \"允许下攻/技能 1\"\n    elif \".setSkill2(\" in s:\n        note = \"允许上攻/技能 2\"\n    elif \".setSkillAIR(\" in s:\n        note = \"允许空中技能\"\n    elif \".setAttackAIR(\" in s:\n        note = \"允许空中普攻\"\n    elif \".setBishaSUPER(\" in s:\n        note = \"允许超必杀\"\n    elif \".setBishaUP(\" in s:\n        note = \"允许上必杀\"\n    elif \".setBishaAIR(\" in s:\n        note = \"允许空必杀\"\n    elif \".setBisha(\" in s:\n        note = \"允许必杀\"\n    elif \".setDash(\" in s:\n        note = \"允许冲刺/瞬步\"\n    elif \".setJump(\" in s:\n        note = \"允许跳\"\n    elif \".setAirMove(\" in s:\n        note = \"空中左右移动开关\"\n    elif \".isApplyG(\" in s:\n        note = \"是否受重力\"\n    elif \".setSteelBody(\" in s:\n        note = \"钢体/霸体\"\n    elif \".addQi(\" in s:\n        note = \"加气\"\n    elif \".movePercent(\" in s:\n        note = \"按百分比位移\"\n    elif \".dampingPercent(\" in s:\n        note = \"百分比阻尼\"\n    elif \".moveOnce(\" in s:\n        note = \"一次性位移\"\n    elif \".moveToTarget(\" in s:\n        note = \"贴近目标\"\n    elif \".moveTarget(\" in s:\n        note = \"跟随位移盒\"\n    elif \".move(\" in s and \"attacker\" in s:\n        note = \"攻击体速度\"\n    elif \".move(\" in s:\n        note = \"设速度\"\n    elif \".damping(\" in s:\n        note = \"阻尼\"\n    elif \".stopMove(\" in s:\n        note = \"清速度\"\n    elif \".fire(\" in s:\n        hits = re.search(r'\"hits\"\\s*:\\s*(\\d+)', s) or re.search(r\"hits:(\\d+)\", s)\n        note = f\"出子弹（hits:{hits.group(1)}）\" if hits else \"出子弹\"\n    elif \".addAttacker(\" in s:\n        note = \"放出攻击体\"\n    elif \".justHitToPlay(\" in s:\n        note = \"命中则切标签\"\n    elif \".setHurtAction(\" in s:\n        note = \"受击切指定动作\"\n    elif \".setDirectToTarget(\" in s:\n        note = \"朝向目标\"\n    elif \".setHitTarget(\" in s:\n        note = \"攻击体命中取样\"\n    elif \".setTouchFloor(\" in s:\n        note = \"落地切标签\"\n    elif \".removeSelf(\" in s:\n        note = \"移除本攻击体\"\n    elif \".doWanKai(\" in s:\n        note = \"切同一 SWF 下一形态帧\"\n    elif \".startWanKai(\" in s:\n        note = \"万解/切形态开场\"\n    elif \".endWanKai(\" in s:\n        note = \"结束万解演出\"\n    elif \".endBisha(\" in s:\n        note = \"关必杀演出\"\n    elif \".bisha(\" in s:\n        note = \"必杀演出（脸/黑屏）\"\n    elif \".endShadow(\" in s:\n        note = \"关残影\"\n    elif \".shadow(\" in s:\n        note = \"残影\"\n    elif \".endShake(\" in s:\n        note = \"停震动\"\n    elif \".startShake(\" in s:\n        note = \"开始震动\"\n    elif \".shake(\" in s:\n        note = \"震动\"\n    elif \".shine(\" in s:\n        note = \"闪光\"\n    elif \".slowDown(\" in s:\n        note = \"慢动作\"\n    elif \".addHp(\" in s:\n        note = \"回血\"\n    elif \".gotoAndPlay(\" in s:\n        note = \"跳到帧标签\"\n    elif re.search(r\"\\$attacker_ctrler\\.stop\\(\", s):\n        note = \"停攻击体\"\n    elif re.search(r\"\\bstop\\(\\)\", s):\n        note = \"停时间轴\"\n    elif \"visible\" in s:\n        note = \"显隐目标\"\n    elif s.strip() in (\"\", \"{\", \"}\"):\n        note = \"\"\n    return note\n\n\ndef statements_of(body: str) -> list[tuple[int, str]]:\n    \"\"\"Return (relative-line-in-body, compact statement) pairs.\n\n    Frame bodies are small; we split on top-level ';' while respecting braces.\n    \"\"\"\n    # keep original for line numbers\n    raw = body\n    stmts = []\n    buf = []\n    depth = 0\n    i = 0\n    line_rel = 1\n    stmt_start_line = 1\n    while i < len(raw):\n        c = raw[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n            buf.append(c)\n        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = \"\".join(buf)\n            compact = compact_ws(strip_this_parent(stmt))\n            if compact not in (\"\", \";\"):\n                stmts.append((stmt_start_line, compact))\n            buf = []\n            stmt_start_line = line_rel if c != \"\\n\" else line_rel\n            # next stmt starts on same line or next\n            stmt_start_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n                    stmt_start_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    rest = \"\".join(buf).strip()\n    if rest:\n        compact = compact_ws(strip_this_parent(rest))\n        if compact:\n            stmts.append((stmt_start_line, compact))\n    return stmts\n\n\ndef group_frames(frames: list[dict]) -> list[list[dict]]:\n    if not frames:\n        return []\n    groups = [[frames[0]]]\n    for fr in frames[1:]:\n        prev = groups[-1][-1]\n        gap = fr[\"frame_no\"] - prev[\"frame_no\"]\n        prev_idle = \"idle(\" in prev[\"body\"]\n        next_attack = bool(\n            re.search(\n                r\"setAttack\\(|addAttacker\\(|fire\\(|bisha\\(|startWanKai\\(|doWanKai\\(\",\n                fr[\"body\"],\n            )\n        )\n        if gap > 15:\n            groups.append([fr])\n        elif prev_idle and gap >= 8:\n            groups.append([fr])\n        elif prev_idle and gap >= 6 and next_attack:\n            groups.append([fr])\n        else:\n            groups[-1].append(fr)\n    return groups\n\n\ndef group_title(group: list[dict]) -> str:\n    labels = []\n    for fr in group:\n        for pat in [\n            r'setAttack\\(\"([^\"]+)\"',\n            r'\\.loop\\(\"([^\"]+)\"',\n            r'gotoAndPlay\\(\"([^\"]+)\"',\n            r'justHitToPlay\\(\"[^\"]+\",\"([^\"]+)\"',\n            r'setSkillAIR\\(\"([^\"]+)\"',\n            r'setTouchFloor\\(\"([^\"]+)\"',\n            r'setHurtAction\\(\"([^\"]+)\"',\n        ]:\n            for m in re.finditer(pat, fr[\"body\"]):\n                lab = m.group(1)\n                if lab not in labels:\n                    labels.append(lab)\n    nums = [f[\"frame_no\"] for f in group]\n    if nums[0] == nums[-1]:\n        rng = f\"F{nums[0]}\"\n    else:\n        rng = f\"F{nums[0]}–F{nums[-1]}\"\n    bodies = \" \".join(f[\"body\"] for f in group)\n    if labels:\n        joined = \" / \".join(f\"`{x}`\" for x in labels)\n        return f\"{rng} — 动作 {joined}\"\n    if all(\"idle(\" in f[\"body\"] and f[\"body\"].count(\"(\") <= 2 for f in group) and \"idle(\" in bodies:\n        if all(re.search(r\"idle\\s*\\(\\s*\\)\", f[\"body\"]) and not re.search(\n            r\"setAttack|fire|addAttacker|bisha|move|dash\", f[\"body\"]\n        ) for f in group):\n            return f\"{rng} — 回站立\"\n    if \"setSkillAIR\" in bodies or \"setAirMove\" in bodies:\n        return f\"{rng} — 空中段\"\n    if \"endAct(\" in bodies and \"idle(\" in bodies and \"setAttack\" not in bodies:\n        return f\"{rng} — 收招\"\n","total_lines":1323}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-8a539df8-5e41-4b00-b720-052ffe6baca0-38","status":"completed","content":[{"type":"content","content":{"type":"text","text":"600→    if all(not compact_ws(strip_this_parent(f[\"body\"])) for f in group):\n        return f\"{rng} — 空帧\"\n    if all(\"stop()\" in f[\"body\"] and \"attacker\" not in f[\"body\"] for f in group):\n        return f\"{rng} — 停\"\n    return f\"{rng} — 脚本段\"\n\n\ndef render_frame_groups(frames: list[dict], prefix: str) -> list[str]:\n    out = []\n    out.append(\"### 逐帧脚本\")\n610→    out.append(\"\")\n    out.append(f\"共 {len(frames)} 个 `addFrameScript` 点。帧标签不在 AS 中，按帧号分段。每个脚本帧都列出，不跳过。\")\n    out.append(\"\")\n    for group in group_frames(frames):\n        out.append(f\"#### {group_title(group)}\")\n        out.append(\"\")\n        out.append(\"| 帧 | 函数 L | 调用 |\")\n        out.append(\"|---|---|---|\")\n        for fr in group:\n            stmts = statements_of(fr[\"body\"])\n620→            fl = f\"L{fr['start']}–{fr['end']}\"\n            if not stmts:\n                out.append(f\"| F{fr['frame_no']} | {fl} / L{fr['start']} | （空） |\")\n                continue\n            first = True\n            for rel, stmt in stmts:\n                call_line = fr[\"start\"] + rel  # approximate\n                # better: find stmt in body\n                note = annotate_call(stmt)\n                shown = stmt\n630→                if shown.endswith(\";\"):\n                    pass\n                else:\n                    shown = shown + (\"\" if shown.endswith(\";\") else \"\")\n                shown = shown.replace(\"|\", \"\\\\|\")\n                extra = f\" — {note}\" if note else \"\"\n                if first:\n                    out.append(\n                        f\"| F{fr['frame_no']} | {fl} / L{call_line} | `{shown}`{extra} |\"\n                    )\n640→                    first = False\n                else:\n                    out.append(f\"|  |  / L{call_line} | `{shown}`{extra} |\")\n        out.append(\"\")\n    return out\n\n\ndef parse_actions_with_lines(func: dict) -> list[dict]:\n    body = func[\"body\"]\n    items = []\n650→    pos = 0\n    # We need file line of each defineAction. Use the function start + newlines before match.\n    while True:\n        m = re.search(r'(?:this\\.)?defineAction\\(\"([^\"]+)\"\\s*,', body[pos:])\n        if not m:\n            break\n        abs_in_body = pos + m.start()\n        line = func[\"start\"] + body[:abs_in_body].count(\"\\n\") + 1\n        obj, endrel = extract_object_literal(body, pos + m.end() - 1)\n        kv = parse_kv_object(obj)\n660→        items.append({\"id\": m.group(1), \"kv\": kv, \"line\": line})\n        pos = pos + m.end()\n        # advance past object\n        i = body.find(\"{\", pos + m.start() - m.end() if False else pos)\n        # simpler: set pos after this match's object\n        obj_start = body.find(\"{\", abs_in_body)\n        if obj_start >= 0:\n            pos = match_braces(body, obj_start)\n        else:\n            pos = abs_in_body + m.end()\n670→    return items\n\n\ndef extra_calls_in_frame(func: dict) -> list[tuple[int, str]]:\n    \"\"\"Non-defineAction statements.\"\"\"\n    body = func[\"body\"]\n    # mask defineAction blocks\n    masked = body\n    out_stmts = []\n    i = 0\n680→    depth = 0\n    buf = []\n    line_rel = 0\n    stmt_line = 0\n    skip_define = False\n    while i < len(body):\n        # detect defineAction\n        if body.startswith(\"defineAction\", i) or body.startswith(\"this.defineAction\", i):\n            # skip until end of object + );\n            j = body.find(\"{\", i)\n690→            if j > 0:\n                k = match_braces(body, j)\n                # skip to semicolon\n                while k < len(body) and body[k] != \";\":\n                    k += 1\n                if k < len(body):\n                    k += 1\n                # count newlines\n                line_rel += body[i:k].count(\"\\n\")\n                i = k\n700→                stmt_line = line_rel\n                continue\n        c = body[i]\n        if c == \"\\n\":\n            line_rel += 1\n        if c == \"{\":\n            depth += 1\n            buf.append(c)\n        elif c == \"}\":\n            depth -= 1\n710→            buf.append(c)\n            if depth == 0:\n                stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n                if stmt.startswith(\"if(\") or stmt.startswith(\"if (\"):\n                    if \"defineAction\" not in stmt:\n                        out_stmts.append((func[\"start\"] + stmt_line + 1, stmt))\n                    buf = []\n                    stmt_line = line_rel\n                    i += 1\n                    continue\n720→        elif c == \";\" and depth == 0:\n            buf.append(c)\n            stmt = compact_ws(strip_this_parent(\"\".join(buf)))\n            if stmt and \"defineAction\" not in stmt:\n                out_stmts.append((func[\"start\"] + stmt_line + 1, stmt))\n            buf = []\n            stmt_line = line_rel\n        else:\n            if not buf and c in \" \\t\\n\":\n                if c == \"\\n\":\n730→                    stmt_line = line_rel\n                i += 1\n                continue\n            buf.append(c)\n        i += 1\n    return out_stmts\n\n\ndef extra_note(stmt: str) -> str:\n    if \"if(!$fighter_ctrler)\" in stmt.replace(\" \", \"\") or \"if(! $fighter_ctrler)\" in stmt:\n740→        return \"未注入则整帧跳过\"\n    if \"defineBishaFace\" in stmt:\n        return \"登记必杀脸 BitmapData\"\n    if \"defineHurtSound\" in stmt:\n        return \"受击语音\"\n    if \"defineHurtFlySound\" in stmt:\n        return \"击飞语音\"\n    if \"defineDieSound\" in stmt:\n        return \"死亡语音\"\n    if \".speed\" in stmt:\n750→        return \"走速\"\n    if \"jumpPower\" in stmt:\n        return \"跳跃初速\"\n    if \".heavy\" in stmt:\n        return \"重量\"\n    if \"defenseType\" in stmt:\n        return \"0=斩防 / 1=拳防\"\n   