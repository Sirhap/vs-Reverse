"ulquiorra\": (0, \"死神\"),\n    \"uryuu\": (0, \"死神\"),\n    \"yin\": (0, \"死神\"),\n}\n\nXML_ROWS = {\n    \"sasuke_xz_old\": [],  # 不在 fighter.xml\n    \"soifon\": [(\"soifon\", \"碎蜂\", 1)],\n    \"temari\": [(\"temari\", \"手鞠\", 1)],\n    \"toushirou\": [(\"toushirou\", \"日番谷·东狮郎\", 1), (\"toushirou_wanjie\", \"日番谷·东狮郎 卍解\", 2)],\n    \"ulquiorra\": [(\"ulquiorra\", \"乌尔奇奥拉\", 1), (\"ulquiorra_guiren\", \"乌尔奇奥拉 归刃\", 2)],\n    \"uryuu\": [(\"uryuu\", \"石田·雨龙\", 1)],\n    \"yin\": [(\"yin\", \"市丸·银\", 1)],\n}\n\nSWF = {\n    \"sasuke_xz_old\": \"assets/fighter/sasuke_xz_old.swf\",\n    \"soifon\": \"assets/fighter/soifon.swf\",\n    \"temari\": \"assets/fighter/temari.swf\",\n    \"toushirou\": \"assets/fighter/toushirou.swf\",\n    \"ulquiorra\": \"assets/fighter/ulquiorra.swf\",\n    \"uryuu\": \"assets/fighter/uryuu.swf\",\n    \"yin\": \"assets/fighter/yin.swf\",\n}\n\nTEMPLATE_NOTE = {\n    \"sasuke_xz_old\": \"遗留 SWF，不在现行 `fighter.xml`；动作 MC 类名 `Timeline_1`。必杀脸键与现行须佐能乎同为 `须佐助1/2`，但动作里还有一次 `bisha(..., \\\"佐助1\\\")`（? 该键未 `defineBishaFace`）。\",\n    \"temari\": \"动作 MC 类名误作 `佐助咒化_1`（佐助 FLA 模板残留）。\",\n    \"ulquiorra\": \"动作 MC 类名误作 `一护虚化全动作_1` / `一护虚化全动作副本_9`（一护 FLA 模板残留）。切归刃 `startWanKai(\\\"一户万解\\\")`（「护」写成「户」）。\",\n}"},"content":[],"locations":[]}
