        15 yin/scripts/snd_hurt1.as  cls=snd_hurt1 fields=0 extra=[]\nsnd        15 yin/scripts/snd_hurt2.as  cls=snd_hurt2 fields=0 extra=[]\nai         56 yin/scripts/yin_fla/AI_2.as  cls=AI_2 fields=11 extra=[]\n  mian ['bsmian', 'tkanmian', 'kanmian', 'zh2mian', 'sbsmian', 'tzmian', 'zh3mian', 'cbsmian', 'zh1mian', 'kj2mian', 'kj1mian']\nmain      302 yin/scripts/yin_fla/MainTimeline.as  cls=MainTimeline fields=5 extra=['setFighterCtrler', 'initMc']\n  frames ['frame1', 'frame2']\n  faces [('银1', 'bsface1'), ('银2', 'bsface2')]\n  snd ['snd_hurt1,snd_hurt2', 'snd_hurt2', 'snd_die']\n  stats [('speed', '10'), ('jumpPower', '16'), ('heavy', '2'), ('defenseType', '0')]\n  hits ['tk', 'tz', 'k1', 'k2', 'k3', 'k4', 'k5', 'kj1', 'kj2', 'kj21', 'zh1', 'zh12', 'zh2', 'zh3', 'zh31', 'bs', 'sbs', 'sbs1', 'cbs1', 'cbs', 'sh1', 'sh12', 'sh2', 'sh22', 'sh23']\naction    547 yin/scripts/yin_fla/Timeline_1.as  cls=Timeline_1 fields=27 extra=[]\n  nframes 87 AImain yes\n  addAttacker [] fire []\nempty      34 yin/scripts/yin_fla/Timeline_7.as  cls=Timeline_7 fields=0 extra=[]\n  fields []\n","exit_code":0,"command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nROOT = Path(\"/workspace/bvn-3.3/decompiled/fighters\")\nfighters = [\"sasuke_xz_old\",\"soifon\",\"temari\",\"toushirou\",\"ulquiorra\",\"uryuu\",\"yin\"]\nfor f in fighters:\n    print(\"=\"*60, f)\n    for p in sorted((ROOT/f/\"scripts\").rglob(\"*.as\")):\n        text = p.read_text(encoding=\"utf-8\", errors=\"replace\")\n        cls = re.search(r\"public dynamic class (\\S+) extends (\\S+)\", text)\n        names = set(re.findall(r\"function (\\w+)\\(\", text))\n        fields = re.findall(r\"public var (\\S+):\", text)\n        nlines = text.count(\"\\n\") + (0 if text.endswith(\"\\n\") else 1)\n        kind = \"?\"\n        cname = cls.group(1) if cls else p.stem\n        if cname.startswith(\"bsface\"): kind=\"bsface\"\n        elif cname.startswith(\"snd_\") or \"snd_\" in cname: kind=\"snd\"\n        elif cname==\"MainTimeline\": kind=\"main\"\n        elif \"AI面\" in cname or cname in (\"AI_2\",\"AI\"): kind=\"ai\"\n        elif \"setAttackerCtrler\" in names: kind=\"attacker\"\n        elif any(x==\"AImain\" for x in fields): kind=\"action\"\n        else: kind=\"empty\"\n        extra=[]\n        for k in [\"doWanKai\",\"startWanKai\",\"endWanKai\",\"setFighterCtrler\",\"initMc\"]:\n            if k in text: extra.append(k)\n        print(f\"{kind:8} {nlines:4} {p.relative_to(ROOT)}  cls={cname} fields={len(fields)} extra={extra}\")\n        if kind==\"main\":\n            faces=re.findall(r'defineBishaFace\\(\"([^\"]+)\"\\s*,\\s*(\\w+)\\)', text)\n            snd=re.findall(r'define(?:HurtSound|HurtFlySound|DieSound)\\(([^)]+)\\)', text)\n            stats=re.findall(r'(speed|jumpPower|heavy|defenseType)\\s*=\\s*([0-9.]+)', text)\n            frames=re.findall(r\"function (frame\\d+)\", text)\n            print(\"  frames\", frames)\n            print(\"  faces\", faces)\n            print(\"  snd\", snd)\n            print(\"  stats\", stats)\n            hits=re.findall(r'defineAction\\(\"([^\"]+)\"', text)\n            print(\"  hits\", hits)\n        if kind==\"ai\":\n            mians=[x for x in fields if x.endswith(\"mian\")]\n            print(\"  mian\", mians)\n        if kind==\"action\":\n            nfr=len(re.findall(r\"function frame\\d+\", text))\n            print(\"  nframes\", nfr, \"AImain yes\")\n            add=re.findall(r'addAttacker\\(\"([^\"]+)\"', text)\n            fire=re.findall(r'fire\\(\"([^\"]+)\"', text)\n            print(\"  addAttacker\", sorted(set(add)), \"fire\", sorted(set(fire)))\n        if kind==\"attacker\":\n            nfr=len(re.findall(r\"function frame\\d+\", text))\n            print(\"  nframes\", nfr, \"fields\", fields)\n        if kind==\"empty\":\n            print(\"  fields\", fields)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":"Classify all Batch G AS files and extract metadata","current_dir":"/workspace/bvn-3.3","output_file":"/home/box/.grok/sessions/%2Fworkspace%2Fbvn-3.3/01a06ef2-6490-7642-9309-d915862e44e0/terminal/call-cb411af7-96b7-4449-9015-01a1998a5a2d-41.log","total_bytes":12327},"locations":[]}
