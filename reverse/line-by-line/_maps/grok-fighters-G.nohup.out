\"\")\n    return \"\\n\".join(lines)\n\n1260→\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n1270→        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n1280→\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n1290→        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n1300→        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n1310→        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n1320→\nif __name__ == \"__main__\":\n    main()\n"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1000→    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n1010→                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n1020→        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n1030→            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n1040→        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n1050→        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n1060→            for ln, st in extras:\n                if \"if(!$fighter_ctrler)\" in st.replace(\" \", \"\") or \"if(!$fighter_ctrler)\" in st:\n                    lines.append(f\"- L{ln}: `if(!$fighter_ctrler){{return;}}` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n1070→    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n1080→    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n1090→    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n1100→        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n1110→    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n1120→    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n1130→    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n1140→    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n1150→    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n1160→        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n1170→    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n1180→        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n1190→            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n1200→            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n1210→    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n1220→    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n1230→    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n1240→        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    for fr in info[\"frames\"]:\n1250→        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n1260→\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n1270→        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n1280→\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n1290→        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n1300→        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n1310→        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n1320→\nif __name__ == \"__main__\":\n    main()\n","content_concise":"1000→    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n1010→                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n1020→        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n1030→            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n1040→        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n1050→        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n1060→            for ln, st in extras:\n                if \"if(!$fighter_ctrler)\" in st.replace(\" \", \"\") or \"if(!$fighter_ctrler)\" in st:\n                    lines.append(f\"- L{ln}: `if(!$fighter_ctrler){{return;}}` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n1070→    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n1080→    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n1090→    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n1100→        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n1110→    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n1120→    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n1130→    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n1140→    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n1150→    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n1160→        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n1170→    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n1180→        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n1190→            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n1200→            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n1210→    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n1220→    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n1230→    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n1240→        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    for fr in info[\"frames\"]:\n1250→        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n1260→\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n1270→        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n1280→\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n1290→        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n1300→        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n1310→        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n1320→\nif __name__ == \"__main__\":\n    main()\n","absolute_path":"/tmp/gen_fighters_f.py","offset":1000,"limit":330,"raw_output":"    if ctor:\n        lines.append(f\"#### `MainTimeline()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        # addFrameScript line\n        body_lines = ctor[\"body\"].splitlines()\n        for i, bl in enumerate(body_lines):\n            if \"addFrameScript\" in bl:\n                # may be one line\n                ln = ctor[\"start\"] + i  # start is function line, body starts next\n                # actually function line is start, `{` same or next. Approximate + index in body newlines\n                break\n        af_line = ctor[\"start\"] + ctor[\"body\"][: ctor[\"body\"].find(\"addFrameScript\")].count(\"\\n\") + (\n            1 if ctor[\"body\"].lstrip() else 0\n        )\n        # more accurate:\n        off = info[\"text\"].find(\"addFrameScript\", info[\"text\"].find(\"function MainTimeline\"))\n        if off >= 0:\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n\n    for fname, title in [\n        (\"setFighterCtrler\", \"setFighterCtrler(param1:*)\"),\n        (\"setFighterMcCtrler\", \"setFighterMcCtrler(param1:*)\"),\n        (\"setEffectCtrler\", \"setEffectCtrler(param1:*)\"),\n    ]:\n        fn = next((f for f in info[\"funcs\"] if f[\"name\"] == fname), None)\n        if not fn:\n            continue\n        lines.append(f\"#### `{title}`（L{fn['start']}–{fn['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(fn[\"body\"])\n        for rel, st in stmts:\n            ln = fn[\"start\"] + rel\n            lines.append(f\"- L{ln}: `{st}`\")\n        lines.append(\"\")\n\n    for ff in frame_funcs:\n        fn = int(ff[\"name\"][5:])\n        lines.append(f\"### `{ff['name']}`（时间轴 F{fn}，L{ff['start']}–{ff['end']}）\")\n        lines.append(\"\")\n        if fn == 1:\n            lines.append(\"- `stop();` — 停时间轴\")\n            lines.append(\"\")\n            continue\n        items = parse_actions_with_lines(ff)\n        lines.append(\"ctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\")\n        lines.append(\"\")\n        lines.append(f\"### F{fn} HitVO\")\n        lines.append(\"\")\n        lines.extend(hitvo_table(items))\n        lines.append(\"\")\n        lines.append(\"`hurtType` 0=站硬直 / 1=击飞。`isBisha` 看 id 是否含 `bs`。`isCatch` 要 `hitType==11 && isBreakDef`。字段见 [`HitVO`](\" + pfx + \"engine/game/bvn/fighter/models/HitVO.md)。\")\n        lines.append(\"\")\n        extras = extra_calls_in_frame(ff)\n        if extras:\n            lines.append(\"**本帧其它调用**\")\n            lines.append(\"\")\n            for ln, st in extras:\n                if \"if(!$fighter_ctrler)\" in st.replace(\" \", \"\") or \"if(!$fighter_ctrler)\" in st:\n                    lines.append(f\"- L{ln}: `if(!$fighter_ctrler){{return;}}` — 未注入则整帧跳过\")\n                    continue\n                if st in (\"{\", \"}\", \"return;\"):\n                    continue\n                note = extra_note(st)\n                extra = f\" — {note}\" if note else \"\"\n                lines.append(f\"- L{ln}: `{st}`{extra}\")\n            lines.append(\"\")\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef public_list(info: dict) -> str:\n    names = [f[\"name\"] for f in info[\"fields\"] if not f[\"name\"].startswith(\"$\")]\n    return \", \".join(f\"`{n}`\" for n in names)\n\n\ndef md_action(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    cn = FIGHTER_CN[fighter]\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 动作 MC `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：角色动作时间轴 `{cls}`：走/跳/普攻/招/必杀/抓/胜负的脚本帧。通过 `parent.$mc_ctrler` 改允许表、位移、出子弹/攻击体；`$effect_ctrler` 播必杀脸与闪光；偶发 `$fighter_ctrler.moveToTarget`/`setCross`/`justHit`/`doWanKai`/`addHp`。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"动作总 MC（`FighterCtrler.initMc(this.mc)` 的那份）。根时间轴是 `$fighter_ctrler` 持有者；本 clip 用 **`parent.$mc_ctrler` / `parent.$effect_ctrler` / `parent.$fighter_ctrler`** 回调。[`FighterMC`]({pfx}engine/game/bvn/fighter/FighterMC.md) `renderChildren` **跳过** 名为 `AImain`、`bdmn`、名字含 `atm` 的子剪辑（当判定盒，不自动 nextFrame）。`AImain` 在 `initHitRange` 里 `gotoAndStop(2)` 扫 [`FighterHitRange`]({pfx}engine/game/bvn/fighter/FighterHitRange.md) 的 `*mian` 再藏起来。\"\n    )\n    lines.append(\"\")\n    pubs = public_list(info)\n    lines.append(\n        f\"帧脚本几乎全是 [`FighterMcCtrler`]({pfx}engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)：`idle` / `endAct` / `setAttack` / `fire` / `addAttacker`。Flash 帧标签本身 **不在** 反编译 AS 里，只留下 `addFrameScript` 数字；下面按帧号分组，标签名从 `setAttack`/`gotoAndPlay`/`loop` 字符串回推。 公开子件：{pubs}。\"\n    )\n    lines.append(\"\")\n    extra = f\"{cn} 动作 MC。\"\n    if fighter in TEMPLATE_NOTE:\n        extra += \" \" + TEMPLATE_NOTE[fighter]\n    body_all = \" \".join(f[\"body\"] for f in info[\"frames\"])\n    if \"doWanKai\" in body_all or \"startWanKai\" in body_all or \"endWanKai\" in body_all:\n        extra += \" 脚本里有切形态：`startWanKai` / `doWanKai` / `endWanKai`。\"\n    lines.append(extra)\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    lines.append(\"### 字段\")\n    lines.append(\"\")\n    lines.append(\"| L | 名字 | 类型 |\")\n    lines.append(\"|---|---|---|\")\n    for f in info[\"fields\"]:\n        lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n    lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        off = info[\"text\"].find(\"addFrameScript\")\n        af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n        lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_attacker(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    lines.append(f\"# `{info['pkg']}.{cls}` — 攻击体 `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：攻击体/技能 clip `{cls}`：`setAttackerCtrler` 注入 `$attacker_ctrler`，帧脚本驱动位移/命中/自毁。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        f\"攻击体 clip。动作 MC 里 `addAttacker(...)` 之后引擎调 `setAttackerCtrler` 注入 [`FighterAttacker`]({pfx}engine/game/bvn/fighter/FighterAttacker.md) 门面 `$attacker_ctrler`（没有也不 throw）。`FighterMC.renderChildren` 对名字含 `atm` 的子件不自动 `nextFrame`；本类若被当独立 attacker 播，则走自己的帧脚本。\"\n    )\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"Embed `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"Embed `source=\\\"{info['embed_src']}\\\"`。\")\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"fields\"]:\n        lines.append(\"### 字段\")\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    lines.append(\"### 函数\")\n    lines.append(\"\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"#### `{cls}()`（L{ctor['start']}–{ctor['end']}）\")\n        lines.append(\"\")\n        lines.append(f\"- L{ctor['start']+2}: `super();`\")\n        if addfs_show:\n            off = info[\"text\"].find(\"addFrameScript\")\n            af_line = info[\"text\"][:off].count(\"\\n\") + 1 if off >= 0 else ctor[\"start\"] + 3\n            lines.append(f\"- L{af_line}: `{addfs_show}`\")\n        lines.append(\"\")\n    sat = next((f for f in info[\"funcs\"] if f[\"name\"] == \"setAttackerCtrler\"), None)\n    if sat:\n        lines.append(f\"#### `setAttackerCtrler(param1:*)`（L{sat['start']}–{sat['end']}）\")\n        lines.append(\"\")\n        stmts = statements_of(sat[\"body\"])\n        for rel, st in stmts:\n            lines.append(f\"- L{sat['start']+rel}: `{st}`\")\n        lines.append(\"\")\n    if info[\"frames\"]:\n        lines.extend(render_frame_groups(info[\"frames\"], pfx))\n    return \"\\n\".join(lines).rstrip() + \"\\n\"\n\n\ndef md_empty(info: dict, fighter: str, md_rel: Path) -> str:\n    cls = info[\"cls\"]\n    pfx = engine_prefix(md_rel)\n    lines = []\n    kind = \"空元件\"\n    if any(f[\"name\"].endswith(\"atm\") for f in info[\"fields\"]):\n        kind = \"特效/判定子时间轴\"\n    lines.append(f\"# `{info['pkg']}.{cls}` — {kind} `{cls}`\")\n    lines.append(\"\")\n    lines.append(\n        f\"一句话目的：库元件 `{cls}`：无 ctrler 回调，末帧 `stop()`。多半是特效/刀光/循环动画。\"\n    )\n    lines.append(\"\")\n    rel_as = info[\"path\"].relative_to(ROOT)\n    lines.append(f\"源文件：`{rel_as}`（{info['nlines']} 行）\")\n    lines.append(\"\")\n    lines.append(\"## 如何挂上引擎\")\n    lines.append(\"\")\n    lines.append(\n        \"不直接挂钩 `$fighter_ctrler`。作为动作 MC 的子时间轴，由 `FighterMC.renderChildren` 自动 `nextFrame`（名字不是 `AImain`/`bdmn`/`atm*` 才会推进）。标签 `stop` 会停（本文件用脚本 `stop()`，效果相同）。名字含 `atm` 的实例会被 `renderChildren` 跳过，当判定盒。\"\n    )\n    lines.append(\"\")\n    lines.append(\"## 逐行说明\")\n    lines.append(\"\")\n    if info[\"embed_src\"]:\n        if info[\"embed_sym\"]:\n            lines.append(\n                f\"- **Embed** `source=\\\"{info['embed_src']}\\\", symbol=\\\"{info['embed_sym']}\\\"`。\"\n            )\n        else:\n            lines.append(f\"- **Embed** `source=\\\"{info['embed_src']}\\\"`。\")\n    ctor = info[\"ctor\"]\n    if ctor:\n        addfs_show = info[\"addfs\"].replace(\"this.\", \"\")\n        lines.append(f\"- **构造** L{ctor['start']}–{ctor['end']}：`{addfs_show or 'super();'}`\")\n    if info[\"fields\"]:\n        lines.append(\"\")\n        lines.append(\"| L | 名字 | 类型 |\")\n        lines.append(\"|---|---|---|\")\n        for f in info[\"fields\"]:\n            lines.append(f\"| L{f['line']} | `{f['name']}` | `{f['type']}` | {field_desc(f['name'])}\")\n        lines.append(\"\")\n    for fr in info[\"frames\"]:\n        stmts = statements_of(fr[\"body\"])\n        shown = \"; \".join(s for _, s in stmts) or \"（空）\"\n        note = annotate_call(shown)\n        extra = f\" — {note}\" if note else \"\"\n        lines.append(\n            f\"- **`frame{fr['frame_no']}`（时间轴 F{fr['frame_no']}，L{fr['start']}–{fr['end']}）**：`{shown}`{extra}\"\n        )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef classify(info: dict) -> str:\n    cls = info[\"cls\"]\n    if cls.startswith(\"bsface\"):\n        return \"bsface\"\n    if cls.startswith(\"snd_\") or \"snd_\" in cls:\n        return \"snd\"\n    if cls == \"MainTimeline\":\n        return \"main\"\n    if \"AI面\" in cls or cls in (\"AI_2\", \"AI\"):\n        return \"ai\"\n    names = {f[\"name\"] for f in info[\"funcs\"]}\n    if \"setAttackerCtrler\" in names:\n        return \"attacker\"\n    if \"setFighterCtrler\" in names:\n        return \"main\"\n    if any(f[\"name\"] == \"AImain\" for f in info[\"fields\"]):\n        return \"action\"\n    # empty / fx\n    return \"empty\"\n\n\ndef as_to_md(as_path: Path) -> Path:\n    rel = as_path.relative_to(SRC)\n    return OUT / rel.with_suffix(\".md\")\n\n\ndef main():\n    files = [\n        Path(p.strip())\n        for p in LIST.read_text().splitlines()\n        if p.strip()\n    ]\n    written = []\n    for as_path in files:\n        fighter = as_path.relative_to(SRC).parts[0]\n        info = parse_as(as_path)\n        md_path = as_to_md(as_path)\n        md_rel = md_path.relative_to(OUT)\n        kind = classify(info)\n        if kind == \"bsface\":\n            content = md_stub_bitmap(info, fighter, md_rel)\n        elif kind == \"snd\":\n            content = md_stub_sound(info, fighter, md_rel)\n        elif kind == \"ai\":\n            content = md_ai(info, fighter, md_rel)\n        elif kind == \"main\":\n            content = md_main(info, fighter, md_rel)\n        elif kind == \"action\":\n            content = md_action(info, fighter, md_rel)\n        elif kind == \"attacker\":\n            content = md_attacker(info, fighter, md_rel)\n        else:\n            content = md_empty(info, fighter, md_rel)\n        md_path.parent.mkdir(parents=True, exist_ok=True)\n        md_path.write_text(content, encoding=\"utf-8\")\n        written.append(md_path)\n        print(f\"PROGRESS: wrote {md_path}\")\n    print(f\"DONE {len(written)} files\")\n\n\nif __name__ == \"__main__\":\n    main()\n","total_lines":1323}},"locations":[]}
