{"type":"tool_call","toolCallId":"call-9b925006-c027-4079-ada1-f2c34b9913c3-72","title":"run_terminal_command","kind":"execute","status":"pending","toolName":"run_terminal_command","rawInput":{"command":"python3 - <<'PY'\nfrom pathlib import Path\nLIST = Path(\"/workspace/bvn-3.3/reverse/line-by-line/_maps/fighters-batch-G-files.txt\")\nSRC = Path(\"/workspace/bvn-3.3/decompiled/fighters\")\nOUT = Path(\"/workspace/bvn-3.3/reverse/line-by-line/fighters\")\nlisted = [Path(p.strip()) for p in LIST.read_text().splitlines() if p.strip()]\nprint(\"listed\", len(listed))\nok=0\nfor p in listed:\n    md = OUT / p.relative_to(SRC).with_suffix('.md')\n    t=md.read_text(encoding='utf-8')\n    assert \"一句话目的\" in t and \"如何挂上引擎\" in t and \"逐行说明\" in t\n    assert len(t.splitlines()) >= 10\n    ok += 1\nprint(\"md ok\", ok)\n\n# checklist in index vs list\nidx = (OUT/\"00-BATCH-G-INDEX.md\").read_text(encoding='utf-8')\n# extract checked links\nimport re\nlinks = re.findall(r\"\\[x\\] \\[`([^`]+)`\\]\", idx)\nprint(\"checklist items\", len(links))\nlisted_rel = [str(p.relative_to(SRC).with_suffix('.md')) for p in listed]\nmiss = [x for x in listed_rel if x not in links]\nextra = [x for x in links if x not in listed_rel]\nprint(\"missing from checklist\", miss)\nprint(\"extra in checklist\", extra)\n\n# index files\nfor name in [\"00-BATCH-G-INDEX.md\",\"00-INDEX.md\"]:\n    p=OUT/name\n    print(name, \"exists\", p.exists(), \"lines\", len(p.read_text().splitlines()))\n\n# confirm 00-INDEX marks G done and ui pending\nix=(OUT/\"00-INDEX.md\").read_text()\nassert \"Batch A–G done\" in ix\nassert \"ui/**\" in ix\nassert \"**done**\" in ix.split(\"sasuke_xz_old\")[1][:400]\nprint(\"00-INDEX status ok\")\nprint(\"PROGRESS: wrote\", OUT/\"00-BATCH-G-INDEX.md\")\nprint(\"PROGRESS: wrote\", OUT/\"00-INDEX.md\")\nPY\n","description":"Verify checklist completeness and index status"},"content":[],"locations":[]}
