ader_start(data):\n    nbits = data[8] >> 3\n    rect_bytes = (5 + nbits*4 + 7)//8\n    return 8 + rect_bytes + 4\n\ndef iter_tags_from(data, i=0):\n    while i+2 <= len(data):\n        code_len = struct.unpack_from('<H', data, i)[0]\n        i += 2\n        tag = code_len >> 6\n        length = code_len & 0x3f\n        if length == 0x3f:\n            length = struct.unpack_from('<I', data, i)[0]\n            i += 4\n        payload = data[i:i+length]\n        yield tag, payload\n        i += length\n        if tag==0:\n            break\n\ndef walk_places(spr):\n    frame=1; i=0\n    places=[]\n    while i+2<=len(spr):\n        code_len = struct.unpack_from('<H', spr, i)[0]; i+=2\n        tag = code_len>>6; length=code_len&0x3f\n        if length==0x3f:\n            length=struct.unpack_from('<I', spr, i)[0]; i+=4\n        payload=spr[i:i+length]; i+=length\n        if tag==1: frame+=1\n        elif tag==26:\n            flags=payload[0]\n            depth=struct.unpack_from('<H', payload,1)[0]\n            cid=None\n            if flags & 0x02:\n                cid=struct.unpack_from('<H', payload,3)[0]\n            places.append((frame, depth, cid, flags))\n        elif tag==0: break\n    return places\n\ndata = decompress_swf(os.path.join(SWFDIR,'bin_228.swf'))\nsprites={}\nfor tag, payload in iter_tags_from(data, header_start(data)):\n    if tag==39:\n        sid, fc = struct.unpack_from('<HH', payload, 0)\n        sprites[sid] = (fc, payload[4:])\n\n# find who places 45 and 306\nprint('who places cid 45 (arrow) and 306 (元件48):')\nfor sid, (fc, body) in sprites.items():\n    for fr,d,cid,fl in walk_places(body):\n        if cid in (45, 306):\n            print(f'  sprite {sid} F{fr} depth={d} cid={cid}')\n\nprint('\\nsprite 449 places:')\nfor e in walk_places(sprites[449][1])[:30]:\n    print(' ', e)\n\nprint('\\nsprite 44 places:')\nfor e in walk_places(sprites[44][1]):\n    print(' ', e)\n\nprint('\\nsprite 34 places:')\nfor e in walk_places(sprites[34][1]):\n    print(' ', e)\n\nprint('\\nsprite 62 places:')\nfor e in walk_places(sprites[62][1]):\n    print(' ', e)\n\nprint('\\narrow 45 places:')\nfor e in walk_places(sprites[45][1]):\n    print(' ', e)\n\nprint('\\n元件48 306 places:')\nfor e in walk_places(sprites[306][1]):\n    print(' ', e)\n\n# Maybe 306 is placed via PlaceObject3?\nprint('\\n--- PlaceObject3 in all sprites ---')\nfor sid, (fc, body) in sprites.items():\n    frame=1; i=0\n    while i+2<=len(body):\n        code_len = struct.unpack_from('<H', body, i)[0]; i+=2\n        tag = code_len>>6; length=code_len&0x3f\n        if length==0x3f:\n            length=struct.unpack_from('<I', body, i)[0]; i+=4\n        payload=body[i:i+length]; i+=length\n        if tag==1: frame+=1\n        elif tag==70:\n            print(f'  PO3 sprite {sid} F{frame} len {len(payload)} first', payload[:12].hex())\n        elif tag==0: break\n\n# also root timeline\nprint('\\nroot tags after header:')\nfor tag, payload in iter_tags_from(data, header_start(data)):\n    if tag in (26,70,4):\n        print(' root place tag', tag, 'len', len(payload), payload[:16].hex())\n    if tag==1:\n        print(' root ShowFrame')\n\n# Symbol 306 might be used only as export, placed in 450 with HasCharacter on later frames\n# Check ALL character ids placed in 450\nprint('\\nall unique cids in 450:')\ncids=defaultdict(lambda:[10**9,0,0])\nfor fr,d,cid,fl in walk_places(sprites[450][1]):\n    if cid:\n        a=cids[cid]; a[0]=min(a[0],fr); a[1]=max(a[1],fr); a[2]+=1\nprint(sorted(cids.items()))\nprint('has 306?', 306 in cids)\n\n# Maybe 306 is referenced from ABC / class linkage only (library symbol used as nested in 450 via timeline in FLA but JPEXS exported it)\n# Check if any sprite places 306\nprint('306 in any sprite?', any(any(cid==306 for *_,cid,_ in walk_places(body)) for body in (s[1] for s in sprites.values())))\n\n# Check root for 306\nprint('\\nDefineShape/sprite around 306:')\nfor tag, payload in iter_tags_from(data, header_start(data)):\n    if tag in (2,6,20,21,22,32,35,36,39,46):\n        sid = struct.unpack_from('<H', payload,0)[0]\n        if 300 <= sid <= 320:\n            print(' tag', tag, 'id', sid, 'len', len(payload))\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":6113},"locations":[]}
