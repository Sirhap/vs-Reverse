bits*4 + 7)//8\n    return 8 + rect_bytes + 4\n\ndef parse_edittext(payload):\n    sid = struct.unpack_from('<H', payload, 0)[0]\n    flags = struct.unpack_from('<H', payload, 2)[0] if False else None\n    # DefineEditText: id UI16, bounds RECT, flags UI16\n    # skip RECT\n    nbits = payload[2] >> 3\n    rect_bytes = (5 + nbits*4 + 7)//8\n    i = 2 + rect_bytes\n    flags = struct.unpack_from('<H', payload, i)[0]; i+=2\n    # HasText 0x80, WordWrap 0x40, Multiline 0x20, Password 0x10, ReadOnly 0x08,\n    # HasTextColor 0x04, HasMaxLength 0x02, HasFont 0x01,\n    # HasFontClass 0x8000, AutoSize 0x4000, HasLayout 0x2000, NoSelect 0x1000,\n    # Border 0x0800, WasStatic 0x0400, HTML 0x0200, UseOutlines 0x0100\n    varname=None; initial=None\n    has_text = flags & 0x80\n    has_font = flags & 0x01\n    has_fontclass = flags & 0x8000\n    has_color = flags & 0x04\n    has_maxlen = flags & 0x02\n    has_layout = flags & 0x2000\n    if has_font:\n        i += 2 # fontid\n        i += 2 # height\n    if has_fontclass:\n        _, i = read_string(payload, i)\n    if has_color:\n        i += 4\n    if has_maxlen:\n        i += 2\n    varname, i = read_string(payload, i)\n    if has_text:\n        initial, i = read_string(payload, i)\n    return sid, varname, initial, flags\n\ndef parse_button2(payload):\n    sid = struct.unpack_from('<H', payload, 0)[0]\n    return sid, payload[2]  # flags trackasmenu\n\ndata = decompress_swf(os.path.join(SWFDIR,'bin_228.swf'))\nstart = header_start(data)\nprint('howtoplay tags of interest:')\nsprites=[]\nabc_count=0\nfor tag, payload in iter_tags_from(data, start):\n    if tag==37:  # DefineEditText\n        sid, vn, init, flags = parse_edittext(payload)\n        print(f'  EditText id={sid} var={vn!r} init={init!r} flags=0x{flags:04x}')\n    elif tag==7:  # DefineButton\n        print('  DefineButton', struct.unpack_from('<H', payload,0)[0])\n    elif tag==34:  # DefineButton2\n        sid = struct.unpack_from('<H', payload,0)[0]\n        print('  DefineButton2 id', sid, 'len', len(payload))\n    elif tag==39:\n        sid, fc = struct.unpack_from('<HH', payload, 0)\n        sprites.append((sid, fc, len(payload)))\n    elif tag==82:\n        abc_count += 1\nprint('sprites', sprites)\nprint('DoABC', abc_count)\n\n# parse movie_howtoplay placements of sprites 45 and 306\nprint('\\n--- placements of 45/306 in sprite 450 ---')\n\ndef get_sprite(data, want_id):\n    for tag, payload in iter_tags_from(data, header_start(data)):\n        if tag==39:\n            sid, fc = struct.unpack_from('<HH', payload, 0)\n            if sid==want_id:\n                return payload[4:], fc\n    return None, None\n\ndef skip_matrix(data, i):\n    b0 = data[i]\n    has_scale = (b0 >> 7) & 1\n    has_rot = (b0 >> 6) & 1\n    def read_bits(bp, n):\n        v = 0\n        for k in range(n):\n            byte = data[bp//8]\n            bit = 7 - (bp%8)\n            v = (v<<1) | ((byte>>bit)&1)\n            bp += 1\n        return v, bp\n    bp = i*8\n    _, bp = read_bits(bp, 1)\n    _, bp = read_bits(bp, 1)\n    if has_scale:\n        nbits, bp = read_bits(bp, 5)\n        _, bp = read_bits(bp, nbits)\n        _, bp = read_bits(bp, nbits)\n    if has_rot:\n        nbits, bp = read_bits(bp, 5)\n        _, bp = read_bits(bp, nbits)\n        _, bp = read_bits(bp, nbits)\n    nbits, bp = read_bits(bp, 5)\n    _, bp = read_bits(bp, nbits)\n    _, bp = read_bits(bp, nbits)\n    return (bp + 7)//8\n\nspr, fc = get_sprite(data, 450)\n# walk looking for character ids 45 and 306\nframe=1\ni=0\nfound=[]\nwhile i+2 <= len(spr):\n    code_len = struct.unpack_from('<H', spr, i)[0]\n    i += 2\n    tag = code_len >> 6\n    length = code_len & 0x3f\n    if length == 0x3f:\n        length = struct.unpack_from('<I', spr, i)[0]\n        i += 4\n    payload = spr[i:i+length]; i += length\n    if tag==1:\n        frame += 1\n    elif tag==26:\n        flags = payload[0]\n        depth = struct.unpack_from('<H', payload, 1)[0]\n        off=3\n        cid=None\n        if flags & 0x02:\n            cid = struct.unpack_from('<H', payload, off)[0]\n        if cid in (45, 306, 449, 36, 9, 18, 34, 44, 62, 192, 284):\n            found.append((frame, depth, cid, flags))\n    elif tag==0:\n        break\nprint('interesting placements (first 40):')\nfor e in found[:40]:\n    print(e)\nprint('total interesting', len(found), 'unique cids', sorted(set(e[2] for e in found)))\n# first/last frame per cid\nfrom collections import defaultdict\nspan=defaultdict(lambda: [10**9,0,0])\nfor fr,d,cid,fl in found:\n    a=span[cid]\n    a[0]=min(a[0],fr); a[1]=max(a[1],fr); a[2]+=1\nprint('cid spans', dict(span))\n\nprint('\\n==== title sprite 19 children + 20 btnct ====')\ndata = decompress_swf(os.path.join(SWFDIR,'bin_2215.swf'))\nfor want in (8,11,18,19,20,64,66):\n    spr, fc = get_sprite(data, want)\n    print(f'sprite {want} frames={fc} bytes={len(spr) if spr else None}')\n\n# ExportAssets / SymbolClass already known\nprint('\\n==== gameover sprite 39: first/last named ===')\ndata = decompress_swf(os.path.join(SWFDIR,'bin_227.swf'))\nspr, fc = get_sprite(data, 39)\nprint('frames', fc)\n\n# sounds\nprint('\\ngameover DefineSound ids:')\ndata = decompress_swf(os.path.join(SWFDIR,'bin_227.swf'))\nfor tag, payload in iter_tags_from(data, header_start(data)):\n    if tag==14:\n        sid = struct.unpack_from('<H', payload,0)[0]\n        print('  sound', sid, 'fmt', payload[2]>>4, 'len', len(payload))\n    if tag==15: # StartSound\n        print('  StartSound', struct.unpack_from('<H', payload,0)[0])\n\n# StartSound inside sprite 39\nspr, fc = get_sprite(data, 39)\nframe=1; i=0\nwhile i+2<=len(spr):\n    code_len = struct.unpack_from('<H', spr, i)[0]; i+=2\n    tag = code_len>>6; length=code_len&0x3f\n    if length==0x3f:\n        length=struct.unpack_from('<I', spr, i)[0]; i+=4\n    payload=spr[i:i+length]; i+=length\n    if tag==1: frame+=1\n    elif tag==15:\n        print('  sprite StartSound frame', frame, 'id', struct.unpack_from('<H', payload,0)[0])\n    elif tag==0: break\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":2390},"locations":[]}
