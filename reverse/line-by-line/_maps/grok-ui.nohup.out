      _loc3_.gotoAndPlay(\"in_bleach\");"},{"line_number":51,"content":"               _loc3_.gotoAndPlay(\"in_naruto\");"}]},{"path":"/workspace/bvn-3.3/import-full/net/play5d/game/bvn/ui/WinUI.as","matches":[{"line_number":48,"content":"               _loc3_.gotoAndPlay(\"in_bleach\");"},{"line_number":51,"content":"               _loc3_.gotoAndPlay(\"in_naruto\");"}]},{"path":"/workspace/bvn-3.3/extracted/full/abc/all_strings.txt","matches":[{"line_number":6650,"content":"in_bleach"},{"line_number":6651,"content":"in_naruto"}]},{"path":"/workspace/bvn-3.3/extracted/full/abc/abc_16_id0_merged_strings.txt","matches":[{"line_number":4867,"content":"in_bleach"},{"line_number":4868,"content":"in_naruto"}]}]},"locations":[]}
{"type":"thought","data":" The timeline breakdown you laid out makes sense—F1-15 looks like a clean key_fadin fade-in, then a hold through F25, and key_fadout 26-35."}
