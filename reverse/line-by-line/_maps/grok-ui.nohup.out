{"type":"tool_call","toolCallId":"call-f89a59d1-2f31-4cd9-8f4c-f848dee2aabc-74","title":"run_terminal_command","kind":"execute","status":"pending","toolName":"run_terminal_command","rawInput":{"command":"python3 - << 'PY'\nimport os, struct, zlib\n\nSWFDIR = '/workspace/bvn-3.3/extracted/full/swf'\n\ndef encoded_u32(data, i):\n    result = 0\n    shift = 0\n    while True:\n        b = data[i]; i += 1\n        result |= (b & 0x7f) << shift\n        if not (b & 0x80):\n            break\n        shift += 7\n    return result, i\n\ndef read_string(data, i):\n    end = data.find(b'\\x00', i)\n    return data[i:end].decode('utf-8','replace'), end+1\n\ndef decompress_swf(path):\n    data = open(path,'rb').read()\n    if data[:3]==b'CWS':\n        return b'FWS'+data[3:8]+zlib.decompress(data[8:])\n    return data\n\ndef iter_tags_from(data, i=0, until_end=True):\n    while i+2 <= len(data):\n        code_len = struct.unpack_from('<H', data, i)[0]\n        i += 2\n        tag = code_len >> 6\n        length = code_len & 0x3f\n        if length == 0x3f:\n            length = struct.unpack_from('<I', data, i)[0]\n            i += 4\n        payload = data[i:i+length]\n        yield tag, payload, i- (2 if length<0x3f else 6)\n        i += length\n        if tag==0 and until_end:\n            break\n\ndef parse_placeobject2(payload):\n    flags = payload[0]\n    i = 1\n    depth = struct.unpack_from('<H', payload, i)[0]; i+=2\n    cid = None\n    name = None\n    # PlaceFlagHasCharacter 0x02\n    if flags & 0x02:\n        cid = struct.unpack_from('<H', payload, i)[0]; i+=2\n    # HasMatrix 0x04\n    if flags & 0x04:\n        nbits = payload[i] >> 4\n        # skip MATRIX: 1 byte nbits + 2*(nbits if HasScale) + 2*(nbits if HasRotate) + 2*Ntranslate\n        b0 = payload[i]\n        has_scale = (b0 >> 7) & 1\n        has_rot = (b0 >> 6) & 1\n        # this is messy; we'll just search for name at the end if HasName\n        pass\n    # We'll parse name by: if HasName (0x20), the name is a null-terminated string near the end\n    # Better: properly skip MATRIX\n    return flags, depth, cid\n\ndef skip_matrix(data, i):\n    b0 = data[i]\n    has_scale = (b0 >> 7) & 1\n    has_rot = (b0 >> 6) & 1\n    nbits_trans_field_start = 2  # bits used\n    bitpos = i*8\n    def read_bits(bp, n):\n        v = 0\n        for k in range(n):\n            byte = data[bp//8]\n            bit = 7 - (bp%8)\n            v = (v<<1) | ((byte>>bit)&1)\n            bp += 1\n        return v, bp\n    bp = bitpos\n    _, bp = read_bits(bp, 1)  # has_scale already\n    _, bp = read_bits(bp, 1)\n    if has_scale:\n        nbits, bp = read_bits(bp, 5)\n        _, bp = read_bits(bp, nbits)\n        _, bp = read_bits(bp, nbits)\n    if has_rot:\n        nbits, bp = read_bits(bp, 5)\n        _, bp = read_bits(bp, nbits)\n        _, bp = read_bits(bp, nbits)\n    nbits, bp = read_bits(bp, 5)\n    _, bp = read_bits(bp, nbits)\n    _, bp = read_bits(bp, nbits)\n    # pad to byte\n    return (bp + 7)//8\n\ndef skip_cxform_with_alpha(data, i):\n    b0 = data[i]\n    has_add = (b0 >> 7) & 1\n    has_mult = (b0 >> 6) & 1\n    nbits = (b0 >> 2) & 0x0f  # wait, nbits is 4 bits at bits 2-5? \n    # CXFORMWITHALPHA: HasAddTerms, HasMultTerms, Nbits(4), then 4*nbits each\n    bp = i*8\n    def read_bits(bp, n):\n        v = 0\n        for k in range(n):\n            byte = data[bp//8]\n            bit = 7 - (bp%8)\n            v = (v<<1) | ((byte>>bit)&1)\n            bp += 1\n        return v, bp\n    has_add, bp = read_bits(bp, 1)\n    has_mult, bp = read_bits(bp, 1)\n    nbits, bp = read_bits(bp, 4)\n    terms = 0\n    if has_mult: terms += 4\n    if has_add: terms += 4\n    _, bp = read_bits(bp, terms * nbits)\n    return (bp+7)//8\n\ndef parse_po2_full(payload):\n    flags = payload[0]\n    i = 1\n    depth = struct.unpack_from('<H', payload, i)[0]; i+=2\n    cid=None; name=None\n    if flags & 0x02:  # character\n        cid = struct.unpack_from('<H', payload, i)[0]; i+=2\n    if flags & 0x04:\n        i = skip_matrix(payload, i)\n    if flags & 0x08:\n        i = skip_cxform_with_alpha(payload, i)\n    if flags & 0x10:  # ratio\n        i += 2\n    if flags & 0x20:  # name\n        name, i = read_string(payload, i)\n    return flags, depth, cid, name\n\ndef get_sprite(data, want_id):\n    # skip header\n    nbits = data[8] >> 3\n    rect_bytes = (5 + nbits*4 + 7)//8\n    start = 8 + rect_bytes + 4\n    for tag, payload, _ in iter_tags_from(data, start):\n        if tag==39:\n            sid, fc = struct.unpack_from('<HH', payload, 0)\n            if sid==want_id:\n                return payload[4:], fc\n    return None, None\n\ndef walk_sprite(spr_tags):\n    frame = 1\n    # depth -> (cid, name)\n    depths = {}\n    events = []\n    i = 0\n    data = spr_tags\n    while i+2 <= len(data):\n        code_len = struct.unpack_from('<H', data, i)[0]\n        i += 2\n        tag = code_len >> 6\n        length = code_len & 0x3f\n        if length == 0x3f:\n            length = struct.unpack_from('<I', data, i)[0]\n            i += 4\n        payload = data[i:i+length]\n        i += length\n        if tag==1:\n            frame += 1\n        elif tag==43:\n            name,_ = read_string(payload,0)\n            events.append((frame, 'LABEL', name))\n        elif tag==26:  # PlaceObject2\n            try:\n                flags, depth, cid, name = parse_po2_full(payload)\n            except Exception as e:\n                events.append((frame, 'PO2_ERR', str(e), payload[:20]))\n                continue\n            if name or cid is not None:\n                events.append((frame, 'PLACE', depth, cid, name, flags))\n            if name:\n                depths[depth] = (cid, name)\n            elif cid is not None:\n                old = depths.get(depth)\n                if old:\n                    depths[depth] = (cid, old[1])\n                else:\n                    depths[depth] = (cid, None)\n        elif tag==28:\n            depth = struct.unpack_from('<H', payload, 0)[0]\n            events.append((frame, 'REMOVE', depth, depths.get(depth)))\n            depths.pop(depth, None)\n        elif tag==12:\n            events.append((frame, 'ACTION', length))\n        elif tag==0:\n            break\n    return events\n\n# ---- gameover sprite 39 ----\ndata = decompress_swf(os.path.join(SWFDIR,'bin_227.swf'))\nspr, fc = get_sprite(data, 39)\nprint('gameover sprite frames', fc)\nevents = walk_sprite(spr)\nnamed = [e for e in events if (e[1]=='PLACE' and e[4]) or e[1] in ('LABEL','REMOVE','ACTION')]\nprint('--- named/label/remove/action ---')\nfor e in named:\n    print(e)\n\nprint('\\n==== howtoplay sprite 450 labels and named instances ===')\ndata = decompress_swf(os.path.join(SWFDIR,'bin_228.swf'))\nspr, fc = get_sprite(data, 450)\nprint('howtoplay frames', fc)\nevents = walk_sprite(spr)\n# collect unique names\nnames=set()\nfor e in events:\n    if e[1]=='PLACE' and e[4]:\n        names.add(e[4])\n    if e[1]=='LABEL':\n        print('LABEL', e)\nprint('instance names', sorted(names))\n# first placement of each name\nseen=set()\nfor e in events:\n    if e[1]=='PLACE' and e[4] and e[4] not in seen:\n        print(' first', e)\n        seen.add(e[4])\n    if e[1]=='LABEL':\n        print(' ', e)\n\nprint('\\n==== title sprite 64 ===')\ndata = decompress_swf(os.path.join(SWFDIR,'bin_2215.swf'))\nspr, fc = get_sprite(data, 64)\nprint('title frames', fc)\nevents = walk_sprite(spr)\nnames=set()\nfor e in events:\n    if e[1]=='PLACE' and e[4]:\n        names.add(e[4])\nprint('instance names', sorted(names))\nfor e in events:\n    if (e[1]=='PLACE' and e[4]) or e[1] in ('LABEL','ACTION'):\n        print(e)\n\nprint('\\n==== title logomc sprite 19 ===')\nspr, fc = get_sprite(data, 19)\nprint('logomc frames', fc)\nevents = walk_sprite(spr)\nfor e in events:\n    if (e[1]=='PLACE' and e[4]) or e[1] in ('LABEL','ACTION'):\n        print(e)\n\nprint('\\n==== title stg_test sprite 66 ===')\nspr, fc = get_sprite(data, 66)\nprint('stg_test frames', fc)\nevents = walk_sprite(spr)\nprint('events', events[:20], 'count', len(events))\nPY\n","description":"Parse PlaceObject instance names on UI timelines"},"content":[],"locations":[]}
