t:int;\r\n   \r\n   private var _renderFlashFrame:int;\r\n   \r\n   public function InsTxt(param1:MovieClip)\r\n   {\r\n      super();\r\n      _mc = param1;\r\n   }\r\n   \r\n   public function setDirect(param1:int) : void\r\n   {\r\n      _mc.scaleX = param1 > 0 ? 1 : -1;\r\n   }\r\n   \r\n   public function setType(param1:int) : void\r\n   {\r\n      switch(param1)\r\n      {\r\n         case 0:\r\n            _mc.gotoAndStop(1);\r\n            break;\r\n         case 1:\r\n            _mc.gotoAndStop(2);\r\n      }\r\n   }\r\n   \r\n   public function render() : void\r\n   {\r\n      if(_isFlash)\r\n      {\r\n         renderFlash();\r\n      }\r\n   }\r\n   \r\n   private function renderFlash() : void\r\n   {\r\n      if(!_mc.mc)\r\n      {\r\n         return;\r\n      }\r\n      if(++_renderFlashInt > 2)\r\n      {\r\n         _renderFlashInt = 0;\r\n         _mc.mc.gotoAndStop(_renderFlashFrame);\r\n         _renderFlashFrame = _renderFlashFrame == 1 ? 2 : 1;\r\n      }\r\n   }\r\n   \r\n   public function normal() : void\r\n   {\r\n      if(!_isOverLoad && !_isFlash)\r\n      {\r\n         return;\r\n      }\r\n      _isOverLoad = false;\r\n      _isFlash = false;\r\n      if(_mc.mc)\r\n      {\r\n         _mc.mc.gotoAndStop(1);\r\n      }\r\n   }\r\n   \r\n   public function flash() : void\r\n   {\r\n      if(_isFlash)\r\n      {\r\n         return;\r\n      }\r\n      _isFlash = true;\r\n      _renderFlashInt = 0;\r\n      _renderFlashFrame = 2;\r\n   }\r\n   \r\n   public function overLoad() : void\r\n   {\r\n      if(_isOverLoad)\r\n      {\r\n         return;\r\n      }\r\n      _isOverLoad = true;\r\n      _isFlash = false;\r\n      if(_mc.mc)\r\n      {\r\n         _mc.mc.gotoAndStop(2);\r\n      }\r\n   }\r\n}\n","total_lines":260}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-50b56fea-3815-471d-a3d9-b60572ce872a-55","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# `FightBar` — 顶部血条带（脸 / HP / 体力 / 计时 / 胜场 / 分数）\n\n一句话目的：包住 `hpbar_mc`。P1 左、P2 右各一套 `FightFaceGroup` + `FighterHpBar` + `EnergyBar` + `WinUI`，正中 `FightTimeUI`，街机再挂 `FightScoreUI`。`GameUI.BITMAP_UI`（默认 true）时把装饰烘焙成一张 Bitmap，动态条子挪到 `ui_fight` 下。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightBar.as`（370 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new FightBar(ui.hpbarmc)`；`initlize` → `setFighter`；街机构造 → `initScore` + `setScore`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；`showWins` → `showWin`。\n10→- **Callees**：`FightFaceGroup`、`FighterHpBar`、`EnergyBar`、`FightTimeUI`、`FightScoreUI`、`WinUI`（`ui.WinUI`）、`GameUI.BITMAP_UI`。\n\n## HUD 槽位（`hpbar_mc`，`decompiled/ui/fight/scripts/hpbar_mc.as`）\n\n| 实例名 | 类 | 用途 |\n|---|---|---|\n| `face1` / `face2` | `hpbar_facegroup` | P1 / P2 三槽头像 |\n| `bar1` / `bar2` | `hpbar_barmc` | HP 绿条+红拖尾 |\n| `energy1` / `energy2` | `energy_bar` | 体力 `FighterMain.energy` |\n| `timemc` | `time_mc` | 正中倒计时 /「无限」 |\n20→| `win_p1` / `win_p2` | `winmc` | 胜场灯（死神/火影两套动画） |\n| `scoremc` | `score_mc` | 街机分数，非街机隐藏 |\n\n帧脚本：帧 1 `stop`；帧 25 / 46 `stop` + `Event.COMPLETE`（对应 `fadin_fin` / `fadout_fin` 一类标签）。`FightBar` 用标签名 `\"fadin\"` / `\"fadin_fin\"` / `\"fadout\"` / `\"destory\"`，具体帧号以 SWF 为准。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `_empytBd`：empty 的笔误，透明空 BitmapData，用来 `copyPixels` 清空再 `draw`。\n- `BITMAP_UI`：`GameUI` 默认 true，本包无写入。**生产路径就是位图模式**。MC 淡入动画只在有人把 flag 扳 false 时才走。\n30→- 位图模式把 `_ui`（`hpbar_mc`）从父级摘掉，装饰（脸、底图）画进 `_bp`；HP/体力/计时数字/胜场/分数作为独立 DisplayObject 加到原来的父级（`ui_fight`）。\n- `setChildrenPosition` 在 `_ui` 已 `removeChild` 之后跑：子件 `parent` 仍是 `_ui`，while 遇 `_ui` 即停，只加 `_ui.x/y`，等于把局部坐标抬到 `ui_fight` 空间。\n- `destory` **不**拆 `FightFaceGroup` / `FightTimeUI` / `FightScoreUI` / `WinUI`。位图模式只 `removeChild` `_children`。脸 Bitmap 随 `_ui` 一起丢掉。\n- `initScore` 在 `FightUI` 构造、`FightBar` 构造**之后**调用。BITMAP 时 `scoremc` 已在 `_children` 里，只需 `new FightScoreUI`；非 BITMAP 才把 `scoremc.visible=true`。\n- `WinUI`（`ui/WinUI.as`）：`show(FighterVO, wins)`。`wins-1`：0 用 `w1`（P1）或 `w2`（P2 的第一盏——team 参数把左右灯对调）；1 用另一盏。`comicType` 0 → `in_bleach`，1 → `in_naruto`。本类不 render WinUI，时间轴自己 `gotoAndPlay`。\n- BITMAP `_children` 顺序（后加的在上）：hp1, hp2, energy1, energy2, **底图 `_bp`**, 计时数字, win1, win2, scoremc。底图夹在条子和灯/分之间，脸在图里、条子在图下、灯在图上。\n- `_ui.width/height` 在 `fadin_fin` 上取样。若元件有滤镜/旋转，BitmapData 尺寸可能大于视觉，`getBounds` 补偿负坐标。\n- 非 BITMAP 且未 `initScore`：`scoremc` 仍在 `hpbar_mc` 里只是 invisible。街机以外永远不 new `FightScoreUI`。\n\n## 逐行说明\n40→\n### 字段（L19–53）\n\n- `_ui`：`hpbar_mc`。\n- `_faceGroup1/2`：P2 构造里 `setDirect(-1)`（但 `FightFaceUI.setDirect` 是空函数，镜像靠 SWF 布局）。\n- `_hpBar1/2`、`_energyBar1/2`：P2 体力 `setDirect(-1)` 翻文字。\n- `_score`：仅街机 `initScore` 才 new。\n- `_isFadIn`：当前是否处于「已显示」。`fadIn`/`fadOut` 的重入闸。\n- `_timerMc`：总是创建。`gameTimeMax==-1` 时内部不建数字。\n- `_winUI1/2`：`new WinUI(win_p1, 1)` / `(win_p2, 2)`，team 参数决定亮 `w1` 还是 `w2`。\n50→- `_isRenderAnimate`：非 BITMAP 淡入/淡出期间才 true，让 `renderAnimate` `nextFrame()`。\n- `_bp` / `_parent` / `_children` / `_drawMatrix` / `_empytBd`：BITMAP 专用。\n\n### 构造（L55–79）\n\n按上表 new 全套。P2 脸组、P2 体力条 `setDirect(-1)`。\n\n- `BITMAP_UI` → `initBitmapUI()`。\n- 否则 `_ui.scoremc.visible=false`（街机稍后 `initScore` 再打开）。\n\n60→最后 `_ui.addEventListener(\"complete\", uiPlayComplete)`。BITMAP 路径 `_ui` 停在 `fadin_fin` 且已离场，COMPLETE 基本不会再来（除非有人 `gotoAndStop` 播动画）。"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# `FightBar` — 顶部血条带（脸 / HP / 体力 / 计时 / 胜场 / 分数）\n\n一句话目的：包住 `hpbar_mc`。P1 左、P2 右各一套 `FightFaceGroup` + `FighterHpBar` + `EnergyBar` + `WinUI`，正中 `FightTimeUI`，街机再挂 `FightScoreUI`。`GameUI.BITMAP_UI`（默认 true）时把装饰烘焙成一张 Bitmap，动态条子挪到 `ui_fight` 下。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightBar.as`（370 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new FightBar(ui.hpbarmc)`；`initlize` → `setFighter`；街机构造 → `initScore` + `setScore`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；`showWins` → `showWin`。\n10→- **Callees**：`FightFaceGroup`、`FighterHpBar`、`EnergyBar`、`FightTimeUI`、`FightScoreUI`、`WinUI`（`ui.WinUI`）、`GameUI.BITMAP_UI`。\n\n## HUD 槽位（`hpbar_mc`，`decompiled/ui/fight/scripts/hpbar_mc.as`）\n\n| 实例名 | 类 | 用途 |\n|---|---|---|\n| `face1` / `face2` | `hpbar_facegroup` | P1 / P2 三槽头像 |\n| `bar1` / `bar2` | `hpbar_barmc` | HP 绿条+红拖尾 |\n| `energy1` / `energy2` | `energy_bar` | 体力 `FighterMain.energy` |\n| `timemc` | `time_mc` | 正中倒计时 /「无限」 |\n20→| `win_p1` / `win_p2` | `winmc` | 胜场灯（死神/火影两套动画） |\n| `scoremc` | `score_mc` | 街机分数，非街机隐藏 |\n\n帧脚本：帧 1 `stop`；帧 25 / 46 `stop` + `Event.COMPLETE`（对应 `fadin_fin` / `fadout_fin` 一类标签）。`FightBar` 用标签名 `\"fadin\"` / `\"fadin_fin\"` / `\"fadout\"` / `\"destory\"`，具体帧号以 SWF 为准。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `_empytBd`：empty 的笔误，透明空 BitmapData，用来 `copyPixels` 清空再 `draw`。\n- `BITMAP_UI`：`GameUI` 默认 true，本包无写入。**生产路径就是位图模式**。MC 淡入动画只在有人把 flag 扳 false 时才走。\n30→- 位图模式把 `_ui`（`hpbar_mc`）从父级摘掉，装饰（脸、底图）画进 `_bp`；HP/体力/计时数字/胜场/分数作为独立 DisplayObject 加到原来的父级（`ui_fight`）。\n- `setChildrenPosition` 在 `_ui` 已 `removeChild` 之后跑：子件 `parent` 仍是 `_ui`，while 遇 `_ui` 即停，只加 `_ui.x/y`，等于把局部坐标抬到 `ui_fight` 空间。\n- `destory` **不**拆 `FightFaceGroup` / `FightTimeUI` / `FightScoreUI` / `WinUI`。位图模式只 `removeChild` `_children`。脸 Bitmap 随 `_ui` 一起丢掉。\n- `initScore` 在 `FightUI` 构造、`FightBar` 构造**之后**调用。BITMAP 时 `scoremc` 已在 `_children` 里，只需 `new FightScoreUI`；非 BITMAP 才把 `scoremc.visible=true`。\n- `WinUI`（`ui/WinUI.as`）：`show(FighterVO, wins)`。`wins-1`：0 用 `w1`（P1）或 `w2`（P2 的第一盏——team 参数把左右灯对调）；1 用另一盏。`comicType` 0 → `in_bleach`，1 → `in_naruto`。本类不 render WinUI，时间轴自己 `gotoAndPlay`。\n- BITMAP `_children` 顺序（后加的在上）：hp1, hp2, energy1, energy2, **底图 `_bp`**, 计时数字, win1, win2, scoremc。底图夹在条子和灯/分之间，脸在图里、条子在图下、灯在图上。\n- `_ui.width/height` 在 `fadin_fin` 上取样。若元件有滤镜/旋转，BitmapData 尺寸可能大于视觉，`getBounds` 补偿负坐标。\n- 非 BITMAP 且未 `initScore`：`scoremc` 仍在 `hpbar_mc` 里只是 invisible。街机以外永远不 new `FightScoreUI`。\n\n## 逐行说明\n40→\n### 字段（L19–53）\n\n- `_ui`：`hpbar_mc`。\n- `_faceGroup1/2`：P2 构造里 `setDirect(-1)`（但 `FightFaceUI.setDirect` 是空函数，镜像靠 SWF 布局）。\n- `_hpBar1/2`、`_energyBar1/2`：P2 体力 `setDirect(-1)` 翻文字。\n- `_score`：仅街机 `initScore` 才 new。\n- `_isFadIn`：当前是否处于「已显示」。`fadIn`/`fadOut` 的重入闸。\n- `_timerMc`：总是创建。`gameTimeMax==-1` 时内部不建数字。\n- `_winUI1/2`：`new WinUI(win_p1, 1)` / `(win_p2, 2)`，team 参数决定亮 `w1` 还是 `w2`。\n50→- `_isRenderAnimate`：非 BITMAP 淡入/淡出期间才 true，让 `renderAnimate` `nextFrame()`。\n- `_bp` / `_parent` / `_children` / `_drawMatrix` / `_empytBd`：BITMAP 专用。\n\n### 构造（L55–79）\n\n按上表 new 全套。P2 脸组、P2 体力条 `setDirect(-1)`。\n\n- `BITMAP_UI` → `initBitmapUI()`。\n- 否则 `_ui.scoremc.visible=false`（街机稍后 `initScore` 再打开）。\n\n60→最后 `_ui.addEventListener(\"complete\", uiPlayComplete)`。BITMAP 路径 `_ui` 停在 `fadin_fin` 且已离场，COMPLETE 基本不会再来（除非有人 `gotoAndStop` 播动画）。","content_concise":"1→# `FightBar` — 顶部血条带（脸 / HP / 体力 / 计时 / 胜场 / 分数）\n\n一句话目的：包住 `hpbar_mc`。P1 左、P2 右各一套 `FightFaceGroup` + `FighterHpBar` + `EnergyBar` + `WinUI`，正中 `FightTimeUI`，街机再挂 `FightScoreUI`。`GameUI.BITMAP_UI`（默认 true）时把装饰烘焙成一张 Bitmap，动态条子挪到 `ui_fight` 下。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightBar.as`（370 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new FightBar(ui.hpbarmc)`；`initlize` → `setFighter`；街机构造 → `initScore` + `setScore`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；`showWins` → `showWin`。\n10→- **Callees**：`FightFaceGroup`、`FighterHpBar`、`EnergyBar`、`FightTimeUI`、`FightScoreUI`、`WinUI`（`ui.WinUI`）、`GameUI.BITMAP_UI`。\n\n## HUD 槽位（`hpbar_mc`，`decompiled/ui/fight/scripts/hpbar_mc.as`）\n\n| 实例名 | 类 | 用途 |\n|---|---|---|\n| `face1` / `face2` | `hpbar_facegroup` | P1 / P2 三槽头像 |\n| `bar1` / `bar2` | `hpbar_barmc` | HP 绿条+红拖尾 |\n| `energy1` / `energy2` | `energy_bar` | 体力 `FighterMain.energy` |\n| `timemc` | `time_mc` | 正中倒计时 /「无限」 |\n20→| `win_p1` / `win_p2` | `winmc` | 胜场灯（死神/火影两套动画） |\n| `scoremc` | `score_mc` | 街机分数，非街机隐藏 |\n\n帧脚本：帧 1 `stop`；帧 25 / 46 `stop` + `Event.COMPLETE`（对应 `fadin_fin` / `fadout_fin` 一类标签）。`FightBar` 用标签名 `\"fadin\"` / `\"fadin_fin\"` / `\"fadout\"` / `\"destory\"`，具体帧号以 SWF 为准。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `_empytBd`：empty 的笔误，透明空 BitmapData，用来 `copyPixels` 清空再 `draw`。\n- `BITMAP_UI`：`GameUI` 默认 true，本包无写入。**生产路径就是位图模式**。MC 淡入动画只在有人把 flag 扳 false 时才走。\n30→- 位图模式把 `_ui`（`hpbar_mc`）从父级摘掉，装饰（脸、底图）画进 `_bp`；HP/体力/计时数字/胜场/分数作为独立 DisplayObject 加到原来的父级（`ui_fight`）。\n- `setChildrenPosition` 在 `_ui` 已 `removeChild` 之后跑：子件 `parent` 仍是 `_ui`，while 遇 `_ui` 即停，只加 `_ui.x/y`，等于把局部坐标抬到 `ui_fight` 空间。\n- `destory` **不**拆 `FightFaceGroup` / `FightTimeUI` / `FightScoreUI` / `WinUI`。位图模式只 `removeChild` `_children`。脸 Bitmap 随 `_ui` 一起丢掉。\n- `initScore` 在 `FightUI` 构造、`FightBar` 构造**之后**调用。BITMAP 时 `scoremc` 已在 `_children` 里，只需 `new FightScoreUI`；非 BITMAP 才把 `scoremc.visible=true`。\n- `WinUI`（`ui/WinUI.as`）：`show(FighterVO, wins)`。`wins-1`：0 用 `w1`（P1）或 `w2`（P2 的第一盏——team 参数把左右灯对调）；1 用另一盏。`comicType` 0 → `in_bleach`，1 → `in_naruto`。本类不 render WinUI，时间轴自己 `gotoAndPlay`。\n- BITMAP `_children` 顺序（后加的在上）：hp1, hp2, energy1, energy2, **底图 `_bp`**, 计时数字, win1, win2, scoremc。底图夹在条子和灯/分之间，脸在图里、条子在图下、灯在图上。\n- `_ui.width/height` 在 `fadin_fin` 上取样。若元件有滤镜/旋转，BitmapData 尺寸可能大于视觉，`getBounds` 补偿负坐标。\n- 非 BITMAP 且未 `initScore`：`scoremc` 仍在 `hpbar_mc` 里只是 invisible。街机以外永远不 new `FightScoreUI`。\n\n## 逐行说明\n40→\n### 字段（L19–53）\n\n- `_ui`：`hpbar_mc`。\n- `_faceGroup1/2`：P2 构造里 `setDirect(-1)`（但 `FightFaceUI.setDirect` 是空函数，镜像靠 SWF 布局）。\n- `_hpBar1/2`、`_energyBar1/2`：P2 体力 `setDirect(-1)` 翻文字。\n- `_score`：仅街机 `initScore` 才 new。\n- `_isFadIn`：当前是否处于「已显示」。`fadIn`/`fadOut` 的重入闸。\n- `_timerMc`：总是创建。`gameTimeMax==-1` 时内部不建数字。\n- `_winUI1/2`：`new WinUI(win_p1, 1)` / `(win_p2, 2)`，team 参数决定亮 `w1` 还是 `w2`。\n50→- `_isRenderAnimate`：非 BITMAP 淡入/淡出期间才 true，让 `renderAnimate` `nextFrame()`。\n- `_bp` / `_parent` / `_children` / `_drawMatrix` / `_empytBd`：BITMAP 专用。\n\n### 构造（L55–79）\n\n按上表 new 全套。P2 脸组、P2 体力条 `setDirect(-1)`。\n\n- `BITMAP_UI` → `initBitmapUI()`。\n- 否则 `_ui.scoremc.visible=false`（街机稍后 `initScore` 再打开）。\n\n60→最后 `_ui.addEventListener(\"complete\", uiPlayComplete)`。BITMAP 路径 `_ui` 停在 `fadin_fin` 且已离场，COMPLETE 基本不会再来（除非有人 `gotoAndStop` 播动画）。","absolute_path":"/workspace/bvn-3.3/reverse/line-by-line/engine/game/bvn/ui/fight/FightBar.md","offset":null,"limit":60,"raw_output":"# `FightBar` — 顶部血条带（脸 / HP / 体力 / 计时 / 胜场 / 分数）\n\n一句话目的：包住 `hpbar_mc`。P1 左、P2 右各一套 `FightFaceGroup` + `FighterHpBar` + `EnergyBar` + `WinUI`，正中 `FightTimeUI`，街机再挂 `FightScoreUI`。`GameUI.BITMAP_UI`（默认 true）时把装饰烘焙成一张 Bitmap，动态条子挪到 `ui_fight` 下。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightBar.as`（370 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new FightBar(ui.hpbarmc)`；`initlize` → `setFighter`；街机构造 → `initScore` + `setScore`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；`showWins` → `showWin`。\n- **Callees**：`FightFaceGroup`、`FighterHpBar`、`EnergyBar`、`FightTimeUI`、`FightScoreUI`、`WinUI`（`ui.WinUI`）、`GameUI.BITMAP_UI`。\n\n## HUD 槽位（`hpbar_mc`，`decompiled/ui/fight/scripts/hpbar_mc.as`）\n\n| 实例名 | 类 | 用途 |\n|---|---|---|\n| `face1` / `face2` | `hpbar_facegroup` | P1 / P2 三槽头像 |\n| `bar1` / `bar2` | `hpbar_barmc` | HP 绿条+红拖尾 |\n| `energy1` / `energy2` | `energy_bar` | 体力 `FighterMain.energy` |\n| `timemc` | `time_mc` | 正中倒计时 /「无限」 |\n| `win_p1` / `win_p2` | `winmc` | 胜场灯（死神/火影两套动画） |\n| `scoremc` | `score_mc` | 街机分数，非街机隐藏 |\n\n帧脚本：帧 1 `stop`；帧 25 / 46 `stop` + `Event.COMPLETE`（对应 `fadin_fin` / `fadout_fin` 一类标签）。`FightBar` 用标签名 `\"fadin\"` / `\"fadin_fin\"` / `\"fadout\"` / `\"destory\"`，具体帧号以 SWF 为准。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `_empytBd`：empty 的笔误，透明空 BitmapData，用来 `copyPixels` 清空再 `draw`。\n- `BITMAP_UI`：`GameUI` 默认 true，本包无写入。**生产路径就是位图模式**。MC 淡入动画只在有人把 flag 扳 false 时才走。\n- 位图模式把 `_ui`（`hpbar_mc`）从父级摘掉，装饰（脸、底图）画进 `_bp`；HP/体力/计时数字/胜场/分数作为独立 DisplayObject 加到原来的父级（`ui_fight`）。\n- `setChildrenPosition` 在 `_ui` 已 `removeChild` 之后跑：子件 `parent` 仍是 `_ui`，while 遇 `_ui` 即停，只加 `_ui.x/y`，等于把局部坐标抬到 `ui_fight` 空间。\n- `destory` **不**拆 `FightFaceGroup` / `FightTimeUI` / `FightScoreUI` / `WinUI`。位图模式只 `removeChild` `_children`。脸 Bitmap 随 `_ui` 一起丢掉。\n- `initScore` 在 `FightUI` 构造、`FightBar` 构造**之后**调用。BITMAP 时 `scoremc` 已在 `_children` 里，只需 `new FightScoreUI`；非 BITMAP 才把 `scoremc.visible=true`。\n- `WinUI`（`ui/WinUI.as`）：`show(FighterVO, wins)`。`wins-1`：0 用 `w1`（P1）或 `w2`（P2 的第一盏——team 参数把左右灯对调）；1 用另一盏。`comicType` 0 → `in_bleach`，1 → `in_naruto`。本类不 render WinUI，时间轴自己 `gotoAndPlay`。\n- BITMAP `_children` 顺序（后加的在上）：hp1, hp2, energy1, energy2, **底图 `_bp`**, 计时数字, win1, win2, scoremc。底图夹在条子和灯/分之间，脸在图里、条子在图下、灯在图上。\n- `_ui.width/height` 在 `fadin_fin` 上取样。若元件有滤镜/旋转，BitmapData 尺寸可能大于视觉，`getBounds` 补偿负坐标。\n- 非 BITMAP 且未 `initScore`：`scoremc` 仍在 `hpbar_mc` 里只是 invisible。街机以外永远不 new `FightScoreUI`。\n\n## 逐行说明\n\n### 字段（L19–53）\n\n- `_ui`：`hpbar_mc`。\n- `_faceGroup1/2`：P2 构造里 `setDirect(-1)`（但 `FightFaceUI.setDirect` 是空函数，镜像靠 SWF 布局）。\n- `_hpBar1/2`、`_energyBar1/2`：P2 体力 `setDirect(-1)` 翻文字。\n- `_score`：仅街机 `initScore` 才 new。\n- `_isFadIn`：当前是否处于「已显示」。`fadIn`/`fadOut` 的重入闸。\n- `_timerMc`：总是创建。`gameTimeMax==-1` 时内部不建数字。\n- `_winUI1/2`：`new WinUI(win_p1, 1)` / `(win_p2, 2)`，team 参数决定亮 `w1` 还是 `w2`。\n- `_isRenderAnimate`：非 BITMAP 淡入/淡出期间才 true，让 `renderAnimate` `nextFrame()`。\n- `_bp` / `_parent` / `_children` / `_drawMatrix` / `_empytBd`：BITMAP 专用。\n\n### 构造（L55–79）\n\n按上表 new 全套。P2 脸组、P2 体力条 `setDirect(-1)`。\n\n- `BITMAP_UI` → `initBitmapUI()`。\n- 否则 `_ui.scoremc.visible=false`（街机稍后 `initScore` 再打开）。\n\n最后 `_ui.addEventListener(\"complete\", uiPlayComplete)`。BITMAP 路径 `_ui` 停在 `fadin_fin` 且已离场，COMPLETE 基本不会再来（除非有人 `gotoAndStop` 播动画）。\n","total_lines":167}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-50b56fea-3815-471d-a3d9-b60572ce872a-58","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# `aizen_fla.MainTimeline` — 蓝染·惣右介 根时间轴\n\n一句话目的：蓝染·惣右介 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\n\n源文件：`decompiled/fighters/aizen/scripts/aizen_fla/MainTimeline.as`（356 行）\n\n## 如何挂上引擎\n\n可玩角色 SWF 文档类。[`FighterMain.initlize`](../../../../engine/game/bvn/fighter/FighterMain.md)：`new FighterCtrler` → `_mainMc.setFighterCtrler`（本类把 `defineAction` 别名到 ctrler）→ `initFighter` 再 `setEffectCtrler` / `setFighterMcCtrler` → `gotoAndStop(data.startFrame+1)` 跑形态帧。缺 `setFighterCtrler` 会 throw。\n10→\n门面见 [`FighterCtrler`](../../../../engine/game/bvn/fighter/ctrler/FighterCtrler.md)；动作帧里 `parent.$mc_ctrler` 是 [`FighterMcCtrler`](../../../../engine/game/bvn/fighter/ctrler/FighterMcCtrler.md)。内部 `this.mc` 才是 `initMc` 包进 `FighterMC` 的那份。\n\nXML：`aizen`；文件 `assets/fighter/aizen.swf`；comic_type 0 死神。引擎 `gotoAndStop(startFrame+1)`，1 → 时间轴 F2。\n\n`defenseType=0` 斩防。speed=13 偏快。必杀脸键名 `蓝染1`/`蓝染2`。受击/击飞/死亡共用 `snd_hurt1`。\n\nHitVO 字段见 [`HitVO`](../../../../engine/game/bvn/fighter/models/HitVO.md)。\n\n## 逐行说明\n20→\n### 字段\n\n| L | 名字 | 类型 |\n|---|---|---|\n| L21 | `mc` | `MovieClip` | 动作总 MC，`initMc` 用\n| L29 | `defineAction` | `Function` | `setFighterCtrler` 写成 ctrler.defineAction\n\n### 函数\n\n30→#### `MainTimeline()`（L31–35）\n\n- L33: `super();`\n- L34: `addFrameScript(0,frame1,1,frame2);`\n\n#### `setFighterCtrler(param1:*)`（L37–41）\n\n- L39: `$fighter_ctrler = param1;`\n- L40: `defineAction = $fighter_ctrler.defineAction;`\n\n40→#### `setFighterMcCtrler(param1:*)`（L43–46）\n\n- L45: `$mc_ctrler = param1;`\n\n#### `setEffectCtrler(param1:*)`（L48–51）\n\n- L50: `$effect_ctrler = param1;`\n\n### `frame1`（时间轴 F1，L53–56）\n\n50→- L55: `stop();` — 停时间轴\n\n### `frame2`（时间轴 F2，L58–353）\n\nctrler 空则 return（`initlize` 先注入再 goto）。随后批量 `defineAction`，再脸/声/数值/`initMc`。\n\n### F2 HitVO\n\n| L | id | 含义 | power | hitType | hitx | hity | hurtTime | hurtType | 破防 |\n|---|---|---|---|---|---|---|---|---|---|\n60→| L64 | `tk` | 跳轻/跳踢 | 50 | 6 KAN_HEAVY 重砍 | 6 | 6 | 600 | 0 | false |\n| L73 | `tz` | 跳重 | 80 | 5 MAGIC_HEAVY 重法 | 10 | 0 | 0 | 1 | false |\n| L82 | `k1` | 普攻 1 | 30 | 1 KAN 砍 | 3 | 0 | 300 | 0 | false |\n| L91 | `k2` | 普攻 2 | 30 | 1 KAN 砍 | 3 | 0 | 400 | 0 | false |\n| L100 | `k3` | 普攻 3 | 50 | 6 KAN_HEAVY 重砍 | 4 | 0 | 600 | 0 | false |\n| L109 | `k4` | 普攻 4 | 50 | 6 KAN_HEAVY 重砍 | 5 | 0 | 400 | 0 | false |\n| L118 | `k5` | 普攻 5 | 30 | 1 KAN 砍 | 3 | -5 | 600 | 0 | false |\n| L127 | `k52` | 普攻 5 击飞段 | 30 | 1 KAN 砍 | 3 | -5 | 600 | 1 | false |\n| L136 | `kj2` | 空中技 2 / 上攻 | 120 | 5 MAGIC_HEAVY 重法 | 10 | -10 | 0 | 1 | true |\n| L145 | `kj21` | 空中技 2 中段 | 40 | 6 KAN_HEAVY 重砍 | 1 | 0 | 600 | 0 | false |\n70→| L154 | `kj22` | 空中技 2 收段 | 50 | 6 KAN_HEAVY 重砍 | 7 | 0 | 0 | 1 | false |\n| L163 | `kj1` | 空中技 1 / 下攻 | 100 | 6 KAN_HEAVY 重砍 | 3 | 0 | 500 | 0 | false |\n| L172 | `kj12` | 空中技 1 收段 | 110 | 6 KAN_HEAVY 重砍 | 7 | 0 | 0 | 1 | false |\n| L181 | `zh1` | 招 1 | 100 | 9 ELECTRIC 雷 | 15 | 0 | 0 | 1 | false |\n| L190 | `zh2` | 招 2 | 110 | 5 MAGIC_HEAVY 重法 | 30 | -5 | 0 | 1 | true |\n| L199 | `zh3` | 招 3 | 100 | 5 MAGIC_HEAVY 重法 | 10 | 0 | 700 | 1 | false |\n| L208 | `zh31` | 招 3 分支 | 100 | 5 MAGIC_HEAVY 重法 | 20 | -3 | 0 | 1 | false |\n| L217 | `bs1` | 必杀前段/多段 | 20 | 1 KAN 砍 | 0 | 0 | 500 | 0 | false |\n| L226 | `bs` | 必杀 | 80 | 5 MAGIC_HEAVY 重法 | 10 | 0 | 0 | 1 | false |\n| L235 | `sbs` | 上必杀 | 150 | 5 MAGIC_HEAVY 重法 | 0 | -15 | 0 | 1 | false |\n80→| L244 | `sbs1` | 上必杀前段 | 30 | 1 KAN 砍 | 3 | 0 | 500 | 0 | false |"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# `aizen_fla.MainTimeline` — 蓝染·惣右介 根时间轴\n\n一句话目的：蓝染·惣右介 角色 SWF 根时间轴：注入三个 ctrler，在形态帧 `defineAction` 灌 HitVO，登记必杀脸/语音，写 speed/jump/heavy/defenseType，最后 `initMc(this.mc)`。\n\n源文件：`decompiled/fighters/aizen/scripts/aizen_fla/MainTimeline.as`（356 行）\n\n## 如何挂上