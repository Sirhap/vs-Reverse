{"type":"tool_call","toolCallId":"call-15e67382-1bb7-4fea-a52d-1f0bcf516fca-53","title":"run_terminal_command","kind":"execute","status":"pending","toolName":"run_terminal_command","rawInput":{"command":"python3 << 'PY'\nimport zlib, struct, re\n\npath = '/workspace/bvn-3.3/extracted/full/swf/bin_225.swf'\ndata = open(path,'rb').read()\nbody = zlib.decompress(data[8:])\n\ndef read_rect_val(buf, pos):\n    class BR:\n        def __init__(self, data, offset=0):\n            self.data=data; self.pos=offset; self.bit=0; self.cur=0\n        def bits(self,n):\n            v=0\n            for _ in range(n):\n                if self.bit==0:\n                    self.cur=self.data[self.pos]; self.pos+=1; self.bit=8\n                self.bit-=1\n                v=(v<<1)|((self.cur>>self.bit)&1)\n            return v\n        def sbits(self,n):\n            v=self.bits(n)\n            if n and (v&(1<<(n-1))): v -= 1<<n\n            return v\n        def align(self):\n            self.bit=0\n    br=BR(buf,pos)\n    n=br.bits(5)\n    xmn=br.sbits(n)/20.0; xmx=br.sbits(n)/20.0; ymn=br.sbits(n)/20.0; ymx=br.sbits(n)/20.0\n    br.align()\n    return (xmn,xmx,ymn,ymx), br.pos\n\ndef parse_tags(buf):\n    TAG={0:'End',1:'ShowFrame',2:'DefineShape',6:'DefineBits',9:'BG',11:'DefineText',\n         14:'DefineSound',22:'DefineShape2',26:'PlaceObject2',32:'DefineShape3',\n         35:'JPEG3',36:'Lossless2',39:'DefineSprite',43:'FrameLabel',48:'DefineFont3',\n         75:'DefineFont3',76:'SymbolClass',82:'DoABC',83:'DefineShape4',88:'DefineFontName'}\n    tags=[]; pp=0\n    while pp < len(buf)-1:\n        rec=struct.unpack('<H', buf[pp:pp+2])[0]; pp+=2\n        tt=rec>>6; ln=rec&0x3f\n        if ln==0x3f:\n            ln=struct.unpack('<I', buf[pp:pp+4])[0]; pp+=4\n        pl=buf[pp:pp+ln]; pp+=ln\n        tags.append((tt, TAG.get(tt,f'T{tt}'), ln, pl))\n        if tt==0: break\n    return tags\n\nrect, pos = read_rect_val(body,0)\nprint('SWF rect', rect)\nfps=struct.unpack('<H', body[pos:pos+2])[0]/256\nframes=struct.unpack('<H', body[pos+2:pos+4])[0]\nprint('fps',fps,'frames',frames)\npos+=4\ntags=parse_tags(body[pos:])\n\nprint('\\n=== SHAPE BOUNDS + fills ===')\n# Parse DefineShape / DefineShape3 / DefineShape4 enough to get bounds and bitmap fills\nfor tt,name,ln,pl in tags:\n    if tt in (2,22,32,83):\n        cid=struct.unpack('<H', pl[:2])[0]\n        bounds, q = read_rect_val(pl, 2)\n        extra=''\n        if tt==83: # shape4 has edge bounds + flags\n            eb, q = read_rect_val(pl, q)\n            flags=pl[q]; q+=1\n            extra=f' edge={eb} flags={flags}'\n        # fill styles: UI8 count or 0xFF+UI16\n        # For shape3/4 fills include RGBA and bitmap\n        # We'll scan for bitmap fill style: fillStyleType 0x40-0x43 then UI16 bitmapId\n        # Crude: search after bounds\n        rest=pl[q:]\n        fills=[]\n        # first byte fill count\n        if rest:\n            n=rest[0]; i=1\n            if n==0xff:\n                n=struct.unpack('<H', rest[1:3])[0]; i=3\n            # parse n fills if small\n            try:\n                for fi in range(min(n,8)):\n                    ftype=rest[i]; i+=1\n                    if ftype==0x00: # solid\n                        if tt in (32,83): # RGBA\n                            i+=4\n                        else:\n                            i+=3\n                    elif ftype in (0x10,0x12,0x13):\n                        # gradient: matrix + gradient\n                        break\n                    elif ftype in (0x40,0x41,0x42,0x43):\n                        bid=struct.unpack('<H', rest[i:i+2])[0]; i+=2\n                        fills.append((hex(ftype), bid))\n                        # skip matrix\n                        break\n                    else:\n                        break\n            except Exception as e:\n                fills.append(('err', str(e)))\n        print(f'  shape {cid} {name} bounds={bounds}{extra} fills~{fills} len={ln}')\n\nprint('\\n=== DefineText ===')\n# DefineText: id, bounds, matrix, glyphbits, advbits, records\nfor tt,name,ln,pl in tags:\n    if tt==11:\n        cid=struct.unpack('<H', pl[:2])[0]\n        bounds,q=read_rect_val(pl,2)\n        print('  text', cid, 'bounds', bounds, 'len', ln)\n        # dump remaining as ascii-ish\n        print('  payload hex head', pl[:40].hex())\n\nprint('\\n=== Font glyphs count / name ===')\nfor tt,name,ln,pl in tags:\n    if tt==88:\n        fid=struct.unpack('<H', pl[:2])[0]\n        e=pl.find(b'\\x00',2)\n        print(' FontName', fid, pl[2:e], 'copyright', pl[e+1:e+80])\n    if tt in (48,75):\n        cid=struct.unpack('<H', pl[:2])[0]\n        flags=pl[2]; lang=pl[3]\n        nlen=pl[4]\n        fname=pl[5:5+nlen]\n        print(' DefineFont3', cid, 'flags', hex(flags), 'name', fname, 'nlen', nlen)\n\nprint('\\n=== Sound details ===')\nfor tt,name,ln,pl in tags:\n    if tt==14:\n        cid, = struct.unpack('<H', pl[:2])\n        flags=pl[2]\n        rate=(flags>>2)&3\n        sz=(flags>>1)&1\n        stereo=flags&1\n        fmt=flags>>4\n        samples=struct.unpack('<I', pl[3:7])[0]\n        print(f' DefineSound id={cid} fmt={fmt} rate={rate} sz={sz} stereo={stereo} samples={samples} datalen={ln-7} head={pl[7:15].hex()}')\n        # fmt 2 = MP3\n        if fmt==2:\n            print('  mp3 frame head', pl[7:11].hex())\n\nprint('\\n=== JPEGTables / JPEG3 / Bits ===')\nfor tt,name,ln,pl in tags:\n    if tt==8:\n        print(' JPEGTables', ln)\n    if tt==35:\n        cid=struct.unpack('<H', pl[:2])[0]\n        aoff=struct.unpack('<I', pl[2:6])[0]\n        jpeg=pl[6:6+aoff]\n        print(' JPEG3', cid, 'jpeg', aoff, 'alpha', ln-6-aoff, 'soi', jpeg[:4])\n        # APP0\n    if tt==6:\n        cid=struct.unpack('<H', pl[:2])[0]\n        print(' DefineBits', cid, 'len', ln, 'head', pl[2:10])\n\n# lossless2 color table\nprint('\\n=== Lossless2 ===')\nimport zlib as Z\nfor tt,name,ln,pl in tags:\n    if tt==36:\n        cid=struct.unpack('<H', pl[:2])[0]\n        fmt=pl[2]\n        w,h=struct.unpack('<HH', pl[3:7])\n        rest=pl[7:]\n        print(f'  lossless2 {cid} fmt={fmt} {w}x{h} zlib={len(rest)}')\n\nprint('\\n=== trans_mc F1 empty? first place frame ===')\n# already know F1-9 empty\n\nprint('\\n=== strings in ABC for each class ===')\n# pull utf8 strings from DoABC\nfor tt,name,ln,pl in tags:\n    if tt==82:\n        flags=struct.unpack('<I', pl[:4])[0]\n        e=pl.find(b'\\x00',4)\n        abcname=pl[4:e].decode()\n        abc=pl[e+1:]\n        # ABC: minor u16 major u16 int_count ...\n        # skip to string pool: after int, uint, double pools\n        def u30(b,i):\n            val=0; shift=0\n            while True:\n                by=b[i]; i+=1\n                val |= (by&0x7f)<<shift\n                if not (by&0x80): break\n                shift+=7\n            return val,i\n        i=4 # skip minor/major\n        n,i=u30(abc,i) # int count\n        if n: n-=1\n        # skip ints s32\n        for _ in range(n):\n            _,i=u30(abc,i) # actually s32 but same encoding-ish\n        n,i=u30(abc,i) # uint\n        if n: n-=1\n        for _ in range(n):\n            _,i=u30(abc,i)\n        n,i=u30(abc,i) # double\n        if n: n-=1\n        i += n*8\n        n,i=u30(abc,i) # string count\n        strs=[]\n        cnt = 0 if n==0 else n-1\n        for _ in range(cnt):\n            ln2,i=u30(abc,i)\n            s=abc[i:i+ln2]; i+=ln2\n            try:\n                strs.append(s.decode('utf-8'))\n            except:\n                strs.append(repr(s))\n        print(f'\\nABC {abcname} strings ({len(strs)}):')\n        for s in strs:\n            if s and s not in ('Object','MovieClip','Event','flash.display','flash.events','addFrameScript','frame1','frame26','frame50','frame61','frame66','stop','dispatchEvent','COMPLETE','super','void'):\n                print('  ', s)\nPY\n","description":"Parse shape bounds, fonts, sounds, ABC strings"},"content":[],"locations":[]}
