n.*;\r\n   import flash.media.*;\r\n   import flash.net.*;\r\n   import flash.net.drm.*;\r\n   import flash.printing.*;\r\n   import flash.profiler.*;\r\n   import flash.sampler.*;\r\n   import flash.sensors.*;\r\n   import flash.system.*;\r\n   import flash.text.*;\r\n   import flash.text.engine.*;\r\n   import flash.text.ime.*;\r\n   import flash.ui.*;\r\n   import flash.utils.*;\r\n   import flash.xml.*;\r\n   \r\n   [Embed(source=\"/_assets/assets.swf\", symbol=\"symbol194\")]\r\n   public dynamic class game_start_mc_44 extends MovieClip\r\n   {\r\n      \r\n      public var nummc:MovieClip;\r\n      \r\n      public var winnermc:MovieClip;\r\n      \r\n      public var $round:int;\r\n      \r\n      public var $perfect:Boolean;\r\n      \r\n      public var $winnerX:Number;\r\n      \r\n      public var $winnerY:Number;\r\n      \r\n      public function game_start_mc_44()\r\n      {\r\n         super();\r\n         addFrameScript(0,this.frame1,26,this.frame27,27,this.frame28,54,this.frame55,57,this.frame58,87,this.frame88,189,this.frame190,199,this.frame200,200,this.frame201,209,this.frame210,262,this.frame263,308,this.frame309);\r\n      }\r\n      \r\n      internal function frame1() : *\r\n      {\r\n         this.$round = 1;\r\n         this.$perfect = false;\r\n         this.$winnerX = 30;\r\n         this.$winnerY = 90;\r\n         stop();\r\n      }\r\n      \r\n      internal function frame27() : *\r\n      {\r\n         if(this.$round < 1)\r\n         {\r\n            this.$round = 1;\r\n         }\r\n         if(this.$round > 5)\r\n         {\r\n            this.$round = 5;\r\n         }\r\n         if(Boolean(this.nummc))\r\n         {\r\n            this.nummc.gotoAndPlay(\"r\" + this.$round);\r\n         }\r\n      }\r\n      \r\n      internal function frame28() : *\r\n      {\r\n         if(Boolean(this.nummc))\r\n         {\r\n            this.nummc.gotoAndPlay(\"r\" + this.$round);\r\n         }\r\n      }\r\n      \r\n      internal function frame55() : *\r\n      {\r\n         dispatchEvent(new Event(\"fight_in\"));\r\n      }\r\n      \r\n      internal function frame58() : *\r\n      {\r\n         dispatchEvent(new Event(\"fight\"));\r\n      }\r\n      \r\n      internal function frame88() : *\r\n      {\r\n         stop();\r\n         dispatchEvent(new Event(Event.COMPLETE));\r\n      }\r\n      \r\n      internal function frame190() : *\r\n      {\r\n         stop();\r\n         dispatchEvent(new Event(Event.COMPLETE));\r\n      }\r\n      \r\n      internal function frame200() : *\r\n      {\r\n         if(Boolean(this.winnermc))\r\n         {\r\n            this.winnermc.x = this.$winnerX;\r\n            this.winnermc.y = this.$winnerY;\r\n            this.winnermc.isPerfect = this.$perfect;\r\n         }\r\n      }\r\n      \r\n      internal function frame201() : *\r\n      {\r\n         if(Boolean(this.winnermc))\r\n         {\r\n            this.winnermc.x = this.$winnerX;\r\n            this.winnermc.y = this.$winnerY;\r\n            this.winnermc.isPerfect = this.$perfect;\r\n         }\r\n      }\r\n      \r\n      internal function frame210() : *\r\n      {\r\n         stop();\r\n         this.winnermc.addEventListener(Event.COMPLETE,function(param1:Event):void\r\n         {\r\n            dispatchEvent(new Event(Event.COMPLETE));\r\n         },false,0,true);\r\n      }\r\n      \r\n      internal function frame263() : *\r\n      {\r\n         stop();\r\n         dispatchEvent(new Event(Event.COMPLETE));\r\n      }\r\n      \r\n      internal function frame309() : *\r\n      {\r\n         stop();\r\n         dispatchEvent(new Event(Event.COMPLETE));\r\n      }\r\n   }\r\n}\r\n\n","total_lines":148}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-cf1ba55d-004e-4db0-acd8-a5cfe31794f5-20","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→package fight_fla\n{\n   import flash.display.MovieClip;\n   import flash.events.Event;\n   \n   [Embed(source=\"/_assets/assets.swf\", symbol=\"symbol187\")]\n   public dynamic class 元件25_46 extends MovieClip\n   {\n      \n10→      public var isPerfect:Boolean;\n      \n      public function 元件25_46()\n      {\n         super();\n         addFrameScript(0,this.frame1,28,this.frame29,55,this.frame56);\n      }\n      \n      internal function frame1() : *\n      {\n20→         this.isPerfect = false;\n      }\n      \n      internal function frame29() : *\n      {\n         if(!this.isPerfect)\n         {\n            stop();\n            dispatchEvent(new Event(Event.COMPLETE));\n         }\n30→      }\n      \n      internal function frame56() : *\n      {\n         stop();\n         dispatchEvent(new Event(Event.COMPLETE));\n      }\n   }\n}\n\n40→"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→package fight_fla\n{\n   import flash.display.MovieClip;\n   import flash.events.Event;\n   \n   [Embed(source=\"/_assets/assets.swf\", symbol=\"symbol187\")]\n   public dynamic class 元件25_46 extends MovieClip\n   {\n      \n10→      public var isPerfect:Boolean;\n      \n      public function 元件25_46()\n      {\n         super();\n         addFrameScript(0,this.frame1,28,this.frame29,55,this.frame56);\n      }\n      \n      internal function frame1() : *\n      {\n20→         this.isPerfect = false;\n      }\n      \n      internal function frame29() : *\n      {\n         if(!this.isPerfect)\n         {\n            stop();\n            dispatchEvent(new Event(Event.COMPLETE));\n         }\n30→      }\n      \n      internal function frame56() : *\n      {\n         stop();\n         dispatchEvent(new Event(Event.COMPLETE));\n      }\n   }\n}\n\n40→","content_concise":"1→package fight_fla\n{\n   import flash.display.MovieClip;\n   import flash.events.Event;\n   \n   [Embed(source=\"/_assets/assets.swf\", symbol=\"symbol187\")]\n   public dynamic class 元件25_46 extends MovieClip\n   {\n      \n10→      public var isPerfect:Boolean;\n      \n      public function 元件25_46()\n      {\n         super();\n         addFrameScript(0,this.frame1,28,this.frame29,55,this.frame56);\n      }\n      \n      internal function frame1() : *\n      {\n20→         this.isPerfect = false;\n      }\n      \n      internal function frame29() : *\n      {\n         if(!this.isPerfect)\n         {\n            stop();\n            dispatchEvent(new Event(Event.COMPLETE));\n         }\n30→      }\n      \n      internal function frame56() : *\n      {\n         stop();\n         dispatchEvent(new Event(Event.COMPLETE));\n      }\n   }\n}\n\n40→","absolute_path":"/workspace/bvn-3.3/decompiled/ui/fight/scripts/fight_fla/元件25_46.as","offset":null,"raw_output":"package fight_fla\r\n{\r\n   import flash.display.MovieClip;\r\n   import flash.events.Event;\r\n   \r\n   [Embed(source=\"/_assets/assets.swf\", symbol=\"symbol187\")]\r\n   public dynamic class 元件25_46 extends MovieClip\r\n   {\r\n      \r\n      public var isPerfect:Boolean;\r\n      \r\n      public function 元件25_46()\r\n      {\r\n         super();\r\n         addFrameScript(0,this.frame1,28,this.frame29,55,this.frame56);\r\n      }\r\n      \r\n      internal function frame1() : *\r\n      {\r\n         this.isPerfect = false;\r\n      }\r\n      \r\n      internal function frame29() : *\r\n      {\r\n         if(!this.isPerfect)\r\n         {\r\n            stop();\r\n            dispatchEvent(new Event(Event.COMPLETE));\r\n         }\r\n      }\r\n      \r\n      internal function frame56() : *\r\n      {\r\n         stop();\r\n         dispatchEvent(new Event(Event.COMPLETE));\r\n      }\r\n   }\r\n}\r\n\n","total_lines":40}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-cf1ba55d-004e-4db0-acd8-a5cfe31794f5-22","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# `QiBar` — 气条 + 辅助气 + 辅助脸\n\n一句话目的：包 `qbar_mc`。主条显示 `FighterMain.qi`（0–300，三格），侧条 `fzqi`（0–100）满了播 `readymc`。脸是**辅助** `Assister.data`，不是出战角色。P2 `setDirect(-1)`。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/QiBar.as`（388 行，含脚本级 `InsBar` / `InsFzBar`）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造绑 `ui.fzqi1/fzqi2`；P2 `setDirect(-1)`；`initlize` → `setFighter(current, fuzhu)`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；KO/超时 `fadOut()`；`QI_BAR_MODE==TOP` 时 `setPosAndScale(120|675, 60, 0.8)`；死代码 `renderQibarPos` 会 `moveTo`/`moveResume`。\n10→- **Callees**：`AssetManager.I.getFighterFace(assister.data)`（默认 50×50）；`KyoUtils.drawDisplay`（BITMAP 把 `facemc` 烤成 Bitmap）；`GameUI.BITMAP_UI`。\n\n## SWF 槽（`qbar_mc`）\n\n| 实例 | 类 | 用途 |\n|---|---|---|\n| `barmc` | `qbar_barmc` | `bar.bar1..bar4` + `txtmc`（气格数） |\n| `fzqibar` | `qbar_fzqi_mc` | 辅助气，`barmc` 用 `scrollRect` 裁高度 |\n| `facemc` | `qbar_facemc` | `ct` 里塞辅助脸 |\n| `readymc` | MovieClip | fzqi 满条时 `mc.play()` |\n20→\n帧脚本：帧 1 `stop`；帧 15 / 38 `stop`+`COMPLETE`（fadin_fin / fadout_fin）。\n\n气格：`qbar_barmcgroup.bar1..4`。`qi/100` 映射到 0–3；`bar1`=0–100，`bar2`=100–200，`bar3`=200–300，`bar4` 在 ≥300 时 visible。`txtmc` 帧 = `int(process)+1`（1..4）。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `readymc` 不是 `readymc` 拼错成 ready-mc 以外的词，SWF 实例名就是 `readymc`。\n- `_orgPose`：构造时 `_ui.x/y`，`moveResume` 的目标。`setPosAndScale` **不**改它，TOP 模式挪走后 AUTO 的 `moveResume` 仍回 SWF 原位。\n30→- `_tweenSpd=0.5`：每逻辑帧走完一半剩余位移。`moveTo` 本包无调用。\n- `_moveType`：0=回原位，1=去指定点。与 `_moveFin` 一起防重入。\n- BITMAP 构造即 `gotoAndStop(\"fadin_fin\"); visible=false`。`fadIn` 只 `visible=true`，无淡入。\n- `setCacheBitmap`：非 BITMAP 才把 `facemc.cacheAsBitmap` 打开（淡入完成/瞬显）或关掉（动画中）。BITMAP 直接 return。\n- `InsBar.setProcess` 在 process 从 >2 掉到 ≤2 时**不**把 `bar3.scaleX` 收回；`bar3.visible=false` 所以看不见。?\n- `FighterMain.qiMax=300` 是 const；UI 用 `qi/100` 封顶 3，与之一致。`fzqiMax=100`，这里写死 `/100`。\n- 脸 `setFighter` 每次 `ct.addChild` **不**清旧孩子。`resetFight` 再 `initlize` 会叠一张。BITMAP 则重 `drawDisplay`，旧脸还在 `facemc` 子树里一起被烤进去。?\n\n## 逐行说明\n\n40→### 字段 / 构造（L17–59）\n\n`_bar=new InsBar(_ui.barmc)`，`_fzBar=new InsFzBar(_ui.fzqibar)`，`_fzReadyMc=_ui.readymc`。记下 `_orgPose`。听 `\"complete\"`。BITMAP：停在 `fadin_fin` 并隐藏。\n\n### `destory`（L61–75）\n\n卸 COMPLETE，`gotoAndStop(\"destory\")`，`_ui=null`。有 `_faceBp` 则 `bitmapData.dispose()`。`_fighter=null`。不 destory Ins*。\n\n### `uiPlayComplete`（L77–88）\n\n50→淡入完成：`visible=true` + `setCacheBitmap(true)`。淡出完成：`visible=false`。BITMAP 不播 MC，不依赖这条。\n\n### `setFighter`（L90–117）\n\n`param1`=出战 `FighterMain`（读 qi/fzqi），`param2`=该组 `Assister`。\n\n- `param2 && param2.data`：`AssetManager.getFighterFace`（`faceUrl`，默认 50×50）塞进 `_ui.facemc.ct`。没图就算了。\n- BITMAP：`KyoUtils.drawDisplay(_ui.facemc)` → `_faceBp`，按 `facemc` 的 x/y 放到 `_ui` 上；try `removeChild(facemc)`；再 `addChild(readymc)`（保证 ready 在脸 Bitmap 之上）。第二次 `setFighter` 会 **再** draw 一张 `_faceBp` 而不 dispose 旧的。?\n\n无辅助时 BITMAP 仍 draw 空 `facemc`。\n60→\n### `setCacheBitmap`（L119–126）\n\n`BITMAP_UI` return。否则 `facemc.cacheAsBitmap=param1`。淡入动画中 false，停住 true。\n\n### `setDirect`（L128–132）\n\n`_bar.setDirect` 翻气数字 `txtmc`。`_fzReadyMc.mc.scaleX` 按符号 ±1。fz 条、脸不在这里翻——P2 的 `fzqi2` SWF 已镜像。`_fzReadyMc.mc` 若 null 会 NPE；SWF 有 `mc`。\n\n### `render`（L134–165）\n70→\n1. `_qiRate = qi/100`，`>3` 钳成 3。\n2. 读当前 `_bar.getProcess()`，差的绝对值 <0.01 则贴死，否则 `process += delta*0.4`（与 EnergyBar 同系数）。\n3. `_fzBar.setProcess(fzqi/100)`——**无 lerp**，瞬时裁 scrollRect。\n4. `fz` 满（`>=1`）与 `readymc.visible` 不同才改 visible：满则 `mc.play()`，否则 `mc.gotoAndStop(1)`。避免每帧 `play()` 重开。\n\n`_fighter` 空则 NPE。`qi` 负会让 bar1.scaleX 负（可见性 `>0` 为 false，条藏）。\n\n### `renderAnimate`（L167–180）\n\n80→与 `FightBar.renderAnimate` 同构：`_isRenderAnimate` 闸，标签 `fadin_fin`/`fadout_fin` 关闸，否则 `nextFrame()`。BITMAP 从不置闸。\n\n### `fadIn`（L182–205）\n\n已显示 return。`_isFadIn=true`，`visible=true`。BITMAP 立刻 return（已在 fadin_fin）。否则 `param1` 真：关 cache、`\"fadin\"`、开动画；假：`\"fadin_fin\"` + 开 cache。\n\n`FightUI.fadIn` 在 TOP 模式强制 `param1=false`。\n\n### `fadOut`（L207–229）\n\n90→未显示 return。`_isFadIn=false`。BITMAP：`visible=false` return。否则带动画则 `\"fadout\"`+关 cache；否则直接 `visible=false`。\n\nKO 的 `playKO2`/`playTimeOver` 默认 `param1=true`，BITMAP 下就是藏。\n\n### `moveTo`（L231–246）\n\n目标 `(x,y,scale)`。若已在 type 1 且 `_moveFin` → return（到过就不再跟，即使目标变了也不追——zoom 来回穿 1.5 时第一次到位后卡住）。切到 type 1 时清 `_moveFin`。然后 `moving`。本包无调用。?\n\n### `moveResume`（L248–263）\n\n100→回 `_orgPose`、scale 1。type 0 + 已完成则 return。否则切 type 0 再 `moving`。\n\n### `moving`（L265–278）\n\n三轴都够近（|dx|<2、|dy|<2、|dScale|<0.2）则贴死并 `_moveFin=true`。**然后仍然**再跑一遍 `+= delta * 0.5`——贴死的那帧会被 0.5 插值拉开？贴死之后 `delta=0`，加 0 无害。未到位时每帧走一半。`scaleY` 跟 `scaleX`。\n\n### `setPosAndScale`（L280–286）\n\n瞬移，不改 `_orgPose` / `_moveType` / `_moveFin`。TOP 模式 `fadIn` 用。之后若有人 `moveResume` 会 tween 回底边原位。\n\n110→---\n\n### 脚本级 `InsBar`（L293–348）—— 气 0–300 四格\n\n构造即 `setProcess(0)`。\n\n#### `getProcess` / `ui`\n\n返回缓存 `_process`；`ui` 给外部（本文件没人读 `ui`）。\n\n120→#### `setProcess`（L317–342）\n\n写 `_process`。可见性：\n\n- `bar1.visible = process>0`\n- `bar2.visible = process>1`\n- `bar3.visible = process>2`\n- `bar4.visible = process>=3`（满 300 亮第 4 格，scale 不管）\n\n宽度：\n130→\n- `>2`：bar1=bar2=`scaleX=1`，bar3=`process-2`（反编译 `_temp_2` 连续赋值）。\n- `>1`：bar1=1，bar2=`process-1`（**不**改 bar3）。\n- else：bar1=`process`（**不**改 bar2/bar3）。\n\n`txtmc.gotoAndStop(int(process)+1)`：0→1，1.x→2，2.x→3，3→4。`int(2.0)+1=3`，刚进第三格数字就跳 3。\n\n#### `setDirect`（L344–347）\n\n`txtmc.scaleX` ±1。\n140→\n---\n\n### 脚本级 `InsFzBar`（L350–388）—— 辅助气竖条\n\n#### 构造（L361–370）\n\n`_loc2_ = barmc.getBounds(barmc)` **算了不用**。`_scroll = Rectangle(0,0,width,height)`，`_height=scroll.height`。然后 `barmc.scaleY=-1`，`barmc.y=barmc.height`：竖直翻转，让 `scrollRect` 从「视觉底部」往上长。?\n\n`getBounds` 丢弃可能是曾经用 bounds 当 scroll 原点，后改成 (0,0,width,height)。?\n150→\n#### `setProcess`（L382–387）\n\n`_process=param1`（期望 0–1）。`_scroll.height = param1 * _height`，赋回 `barmc.scrollRect`。`fzqi>100` 会超高；负 height 在 Flash 里行为未定义。正常 `renderFzQi` 把 fzqi 卡在 100。\n"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# `QiBar` — 气条 + 辅助气 + 辅助脸\n\n一句话目的：包 `qbar_mc`。主条显示 `FighterMain.qi`（0–300，三格），侧条 `fzqi`（0–100）满了播 `readymc`。脸是**辅助** `Assister.data`，不是出战角色。P2 `setDirect(-1)`。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/QiBar.as`（388 行，含脚本级 `InsBar` / `InsFzBar`）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造绑 `ui.fzqi1/fzqi2`；P2 `setDirect(-1)`；`initlize` → `setFighter(current, fuzhu)`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；KO/超时 `fadOut()`；`QI_BAR_MODE==TOP` 时 `setPosAndScale(120|675, 60, 0.8)`；死代码 `renderQibarPos` 会 `moveTo`/`moveResume`。\n10→- **Callees**：`AssetManager.I.getFighterFace(assister.data)`（默认 50×50）；`KyoUtils.drawDisplay`（BITMAP 把 `facemc` 烤成 Bitmap）；`GameUI.BITMAP_UI`。\n\n## SWF 槽（`qbar_mc`）\n\n| 实例 | 类 | 用途 |\n|---|---|---|\n| `barmc` | `qbar_barmc` | `bar.bar1..bar4` + `txtmc`（气格数） |\n| `fzqibar` | `qbar_fzqi_mc` | 辅助气，`barmc` 用 `scrollRect` 裁高度 |\n| `facemc` | `qbar_facemc` | `ct` 里塞辅助脸 |\n| `readymc` | MovieClip | fzqi 满条时 `mc.play()` |\n20→\n帧脚本：帧 1 `stop`；帧 15 / 38 `stop`+`COMPLETE`（fadin_fin / fadout_fin）。\n\n气格：`qbar_barmcgroup.bar1..4`。`qi/100` 映射到 0–3；`bar1`=0–100，`bar2`=100–200，`bar3`=200–300，`bar4` 在 ≥300 时 visible。`txtmc` 帧 = `int(process)+1`（1..4）。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `readymc` 不是 `readymc` 拼错成 ready-mc 以外的词，SWF 实例名就是 `readymc`。\n- `_orgPose`：构造时 `_ui.x/y`，`moveResume` 的目标。`setPosAndScale` **不**改它，TOP 模式挪走后 AUTO 的 `moveResume` 仍回 SWF 原位。\n30→- `_tweenSpd=0.5`：每逻辑帧走完一半剩余位移。`moveTo` 本包无调用。\n- `_moveType`：0=回原位，1=去指定点。与 `_moveFin` 一起防重入。\n- BITMAP 构造即 `gotoAndStop(\"fadin_fin\"); visible=false`。`fadIn` 只 `visible=true`，无淡入。\n- `setCacheBitmap`：非 BITMAP 才把 `facemc.cacheAsBitmap` 打开（淡入完成/瞬显）或关掉（动画中）。BITMAP 直接 return。\n- `InsBar.setProcess` 在 process 从 >2 掉到 ≤2 时**不**把 `bar3.scaleX` 收回；`bar3.visible=false` 所以看不见。?\n- `FighterMain.qiMax=300` 是 const；UI 用 `qi/100` 封顶 3，与之一致。`fzqiMax=100`，这里写死 `/100`。\n- 脸 `setFighter` 每次 `ct.addChild` **不**清旧孩子。`resetFight` 再 `initlize` 会叠一张。BITMAP 则重 `drawDisplay`，旧脸还在 `facemc` 子树里一起被烤进去。?\n\n## 逐行说明\n\n40→### 字段 / 构造（L17–59）\n\n`_bar=new InsBar(_ui.barmc)`，`_fzBar=new InsFzBar(_ui.fzqibar)`，`_fzReadyMc=_ui.readymc`。记下 `_orgPose`。听 `\"complete\"`。BITMAP：停在 `fadin_fin` 并隐藏。\n\n### `destory`（L61–75）\n\n卸 COMPLETE，`gotoAndStop(\"destory\")`，`_ui=null`。有 `_faceBp` 则 `bitmapData.dispose()`。`_fighter=null`。不 destory Ins*。\n\n### `uiPlayComplete`（L77–88）\n\n50→淡入完成：`visible=true` + `setCacheBitmap(true)`。淡出完成：`visible=false`。BITMAP 不播 MC，不依赖这条。\n\n### `setFighter`（L90–117）\n\n`param1`=出战 `FighterMain`（读 qi/fzqi），`param2`=该组 `Assister`。\n\n- `param2 && param2.data`：`AssetManager.getFighterFace`（`faceUrl`，默认 50×50）塞进 `_ui.facemc.ct`。没图就算了。\n- BITMAP：`KyoUtils.drawDisplay(_ui.facemc)` → `_faceBp`，按 `facemc` 的 x/y 放到 `_ui` 上；try `removeChild(facemc)`；再 `addChild(readymc)`（保证 ready 在脸 Bitmap 之上）。第二次 `setFighter` 会 **再** draw 一张 `_faceBp` 而不 dispose 旧的。?\n\n无辅助时 BITMAP 仍 draw 空 `facemc`。\n60→\n### `setCacheBitmap`（L119–126）\n\n`BITMAP_UI` return。否则 `facemc.cacheAsBitmap=param1`。淡入动画中 false，停住 true。\n\n### `setDirect`（L128–132）\n\n`_bar.setDirect` 翻气数字 `txtmc`。`_fzReadyMc.mc.scaleX` 按符号 ±1。fz 条、脸不在这里翻——P2 的 `fzqi2` SWF 已镜像。`_fzReadyMc.mc` 若 null 会 NPE；SWF 有 `mc`。\n\n### `render`（L134–165）\n70→\n1. `_qiRate = qi/100`，`>3` 钳成 3。\n2. 读当前 `_bar.getProcess()`，差的绝对值 <0.01 则贴死，否则 `process += delta*0.4`（与 EnergyBar 同系数）。\n3. `_fzBar.setProcess(fzqi/100)`——**无 lerp**，瞬时裁 scrollRect。\n4. `fz` 满（`>=1`）与 `readymc.visible` 不同才改 visible：满则 `mc.play()`，否则 `mc.gotoAndStop(1)`。避免每帧 `play()` 重开。\n\n`_fighter` 空则 NPE。`qi` 负会让 bar1.scaleX 负（可见性 `>0` 为 false，条藏）。\n\n### `renderAnimate`（L167–180）\n\n80→与 `FightBar.renderAnimate` 同构：`_isRenderAnimate` 闸，标签 `fadin_fin`/`fadout_fin` 关闸，否则 `nextFrame()`。BITMAP 从不置闸。\n\n### `fadIn`（L182–205）\n\n已显示 return。`_isFadIn=true`，`visible=true`。BITMAP 立刻 return（已在 fadin_fin）。否则 `param1` 真：关 cache、`\"fadin\"`、开动画；假：`\"fadin_fin\"` + 开 cache。\n\n`FightUI.fadIn` 在 TOP 模式强制 `param1=false`。\n\n### `fadOut`（L207–229）\n\n90→未显示 return。`_isFadIn=false`。BITMAP：`visible=false` return。否则带动画则 `\"fadout\"`+关 cache；否则直接 `visible=false`。\n\nKO 的 `playKO2`/`playTimeOver` 默认 `param1=true`，BITMAP 下就是藏。\n\n### `moveTo`（L231–246）\n\n目标 `(x,y,scale)`。若已在 type 1 且 `_moveFin` → return（到过就不再跟，即使目标变了也不追——zoom 来回穿 1.5 时第一次到位后卡住）。切到 type 1 时清 `_moveFin`。然后 `moving`。本包无调用。?\n\n### `moveResume`（L248–263）\n\n100→回 `_orgPose`、scale 1。type 0 + 已完成则 return。否则切 type 0 再 `moving`。\n\n### `moving`（L265–278）\n\n三轴都够近（|dx|<2、|dy|<2、|dScale|<0.2）则贴死并 `_moveFin=true`。**然后仍然**再跑一遍 `+= delta * 0.5`——贴死的那帧会被 0.5 插值拉开？贴死之后 `delta=0`，加 0 无害。未到位时每帧走一半。`scaleY` 跟 `scaleX`。\n\n### `setPosAndScale`（L280–286）\n\n瞬移，不改 `_orgPose` / `_moveType` / `_moveFin`。TOP 模式 `fadIn` 用。之后若有人 `moveResume` 会 tween 回底边原位。\n\n110→---\n\n### 脚本级 `InsBar`（L293–348）—— 气 0–300 四格\n\n构造即 `setProcess(0)`。\n\n#### `getProcess` / `ui`\n\n返回缓存 `_process`；`ui` 给外部（本文件没人读 `ui`）。\n\n120→#### `setProcess`（L317–342）\n\n写 `_process`。可见性：\n\n- `bar1.visible = process>0`\n- `bar2.visible = process>1`\n- `bar3.visible = process>2`\n- `bar4.visible = process>=3`（满 300 亮第 4 格，scale 不管）\n\n宽度：\n130→\n- `>2`：bar1=bar2=`scaleX=1`，bar3=`process-2`（反编译 `_temp_2` 连续赋值）。\n- `>1`：bar1=1，bar2=`process-1`（**不**改 bar3）。\n- else：bar1=`process`（**不**改 bar2/bar3）。\n\n`txtmc.gotoAndStop(int(process)+1)`：0→1，1.x→2，2.x→3，3→4。`int(2.0)+1=3`，刚进第三格数字就跳 3。\n\n#### `setDirect`（L344–347）\n\n`txtmc.scaleX` ±1。\n140→\n---\n\n### 脚本级 `InsFzBar`（L350–388）—— 辅助气竖条\n\n#### 构造（L361–370）\n\n`_loc2_ = barmc.getBounds(barmc)` **算了不用**。`_scroll = Rectangle(0,0,width,height)`，`_height=scroll.height`。然后 `barmc.scaleY=-1`，`barmc.y=barmc.height`：竖直翻转，让 `scrollRect` 从「视觉底部」往上长。?\n\n`getBounds` 丢弃可能是曾经用 bounds 当 scroll 原点，后改成 (0,0,width,height)。?\n150→\n#### `setProcess`（L382–387）\n\n`_process=param1`（期望 0–1）。`_scroll.height = param1 * _height`，赋回 `barmc.scrollRect`。`fzqi>100` 会超高；负 height 在 Flash 里行为未定义。正常 `renderFzQi` 把 fzqi 卡在 100。\n","content_concise":"1→# `QiBar` — 气条 + 辅助气 + 辅助脸\n\n一句话目的：包 `qbar_mc`。主条显示 `FighterMain.qi`（0–300，三格），侧条 `fzqi`（0–100）满了播 `readymc`。脸是**辅助** `Assister.data`，不是出战角色。P2 `setDirect(-1)`。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/QiBar.as`（388 行，含脚本级 `InsBar` / `InsFzBar`）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造绑 `ui.fzqi1/fzqi2`；P2 `setDirect(-1)`；`initlize` → `setFighter(current, fuzhu)`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；KO/超时 `fadOut()`；`QI_BAR_MODE==TOP` 时 `setPosAndScale(120|675, 60, 0.8)`；死代码 `renderQibarPos` 会 `moveTo`/`moveResume`。\n10→- **Callees**：`AssetManager.I.getFighterFace(assister.data)`（默认 50×50）；`KyoUtils.drawDisplay`（BITMAP 把 `facemc` 烤成 Bitmap）；`GameUI.BITMAP_UI`。\n\n## SWF 槽（`qbar_mc`）\n\n| 实例 | 类 | 用途 |\n|---|---|---|\n| `barmc` | `qbar_barmc` | `bar.bar1..bar4` + `txtmc`（气格数） |\n| `fzqibar` | `qbar_fzqi_mc` | 辅助气，`barmc` 用 `scrollRect` 裁高度 |\n| `facemc` | `qbar_facemc` | `ct` 里塞辅助脸 |\n| `readymc` | MovieClip | fzqi 满条时 `mc.play()` |\n20→\n帧脚本：帧 1 `stop`；帧 15 / 38 `stop`+`COMPLETE`（fadin_fin / fadout_fin）。\n\n气格：`qbar_barmcgroup.bar1..4`。`qi/100` 映射到 0–3；`bar1`=0–100，`bar2`=100–200，`bar3`=200–300，`bar4` 在 ≥300 时 visible。`txtmc` 帧 = `int(process)+1`（1..4）。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `readymc` 不是 `readymc` 拼错成 ready-mc 以外的词，SWF 实例名就是 `readymc`。\n- `_orgPose`：构造时 `_ui.x/y`，`moveResume` 的目标。`setPosAndScale` **不**改它，TOP 模式挪走后 AUTO 的 `moveResume` 仍回 SWF 原位。\n30→- `_tweenSpd=0.5`：每逻辑帧走完一半剩余位移。`moveTo` 本包无调用。\n- `_moveType`：0=回原位，1=去指定点。与 `_moveFin` 一起防重入。\n- BITMAP 构造即 `gotoAndStop(\"fadin_fin\"); visible=false`。`fadIn` 只 `visible=true`，无淡入。\n- `setCacheBitmap`：非 BITMAP 才把 `facemc.cacheAsBitmap` 打开（淡入完成/瞬显）或关掉（动画中）。BITMAP 直接 return。\n- `InsBar.setProcess` 在 process 从 >2 掉到 ≤2 时**不**把 `bar3.scaleX` 收回；`bar3.visible=false` 所以看不见。?\n- `FighterMain.qiMax=300` 是 const；UI 用 `qi/100` 封顶 3，与之一致。`fzqiMax=100`，这里写死 `/100`。\n- 脸 `setFighter` 每次 `ct.addChild` **不**清旧孩子。`resetFight` 再 `initlize` 会叠一张。BITMAP 则重 `drawDisplay`，旧脸还在 `facemc` 子树里一起被烤进去。?\n\n## 逐行说明\n\n40→### 字段 / 构造（L17–59）\n\n`_bar=new InsBar(_ui.barmc)`，`_fzBar=new InsFzBar(_ui.fzqibar)`，`_fzReadyMc=_ui.readymc`。记下 `_orgPose`。听 `\"complete\"`。BITMAP：停在 `fadin_fin` 并隐藏。\n\n### `destory`（L61–75）\n\n卸 COMPLETE，`gotoAndStop(\"destory\")`，`_ui=null`。有 `_faceBp` 则 `bitmapData.dispose()`。`_fighter=null`。不 destory Ins*。\n\n### `uiPlayComplete`（L77–88）\n\n50→淡入完成：`visible=true` + `setCacheBitmap(true)`。淡出完成：`visible=false`。BITMAP 不播 MC，不依赖这条。\n\n### `setFighter`（L90–117）\n\n`param1`=出战 `FighterMain`（读 qi/fzqi），`param2`=该组 `Assister`。\n\n- `param2 && param2.data`：`AssetManager.getFighterFace`（`faceUrl`，默认 50×50）塞进 `_ui.facemc.ct`。没图就算了。\n- BITMAP：`KyoUtils.drawDisplay(_ui.facemc)` → `_faceBp`，按 `facemc` 的 x/y 放到 `_ui` 上；try `removeChild(facemc)`；再 `addChild(readymc)`（保证 ready 在脸 Bitmap 之上）。第二次 `setFighter` 会 **再** draw 一张 `_faceBp` 而不 dispose 旧的。?\n\n无辅助时 BITMAP 仍 draw 空 `facemc`。\n60→\n### `setCacheBitmap`（L119–126）\n\n`BITMAP_UI` return。否则 `facemc.cacheAsBitmap=param1`。淡入动画中 false，停住 true。\n\n### `setDirect`（L128–132）\n\n`_bar.setDirect` 翻气数字 `txtmc`。`_fzReadyMc.mc.scaleX` 按符号 ±1。fz 条、脸不在这里翻——P2 的 `fzqi2` SWF 已镜像。`_fzReadyMc.mc` 若 null 会 NPE；SWF 有 `mc`。\n\n### `render`（L134–165）\n70→\n1. `_qiRate = qi/100`，`>3` 钳成 3。\n2. 读当前 `_bar.getProcess()`，差的绝对值 <0.01 则贴死，否则 `process += delta*0.4`（与 EnergyBar 同系数）。\n3. `_fzBar.setProcess(fzqi/100)`——**无 lerp**，瞬时裁 scrollRect。\n4. `fz` 满（`>=1`）与 `readymc.visible` 不同才改 visible：满则 `mc.play()`，否则 `mc.gotoAndStop(1)`。避免每帧 `play()` 重开。\n\n`_fighter` 空则 NPE。`qi` 负会让 bar1.scaleX 负（可见性 `>0` 为 false，条藏）。\n\n### `renderAnimate`（L167–180）\n\n80→与 `FightBar.renderAnimate` 同构：`_isRenderAnimate` 闸，标签 `fadin_fin`/`fadout_fin` 关闸，否则 `nextFrame()`。BITMAP 从不置闸。\n\n### `fadIn`（L182–205）\n\n已显示 return。`_isFadIn=true`，`visible=true`。BITMAP 立刻 return（已在 fadin_fin）。否则 `param1` 真：关 cache、`\"fadin\"`、开动画；假：`\"fadin_fin\"` + 开 cache。\n\n`FightUI.fadIn` 在 TOP 模式强制 `param1=false`。\n\n### `fadOut`（L207–229）\n\n90→未显示 return。`_isFadIn=false`。BITMAP：`visible=false` return。否则带动画则 `\"fadout\"`+关 cache；否则直接 `visible=false`。\n\nKO 的 `playKO2`/`playTimeOver` 默认 `param1=true`，BITMAP 下就是藏。\n\n### `moveTo`（L231–246）\n\n目标 `(x,y,scale)`。若已在 type 1 且 `_moveFin` → return（到过就不再跟，即使目标变了也不追——zoom 来回穿 1.5 时第一次到位后卡住）。切到 type 1 时清 `_moveFin`。然后 `moving`。本包无调用。?\n\n### `moveResume`（L248–263）\n\n100→回 `_orgPose`、scale 1。type 0 + 已完成则 return。否则切 type 0 再 `moving`。\n\n### `moving`（L265–278）\n\n三轴都够近（|dx|<2、|dy|<2、|dScale|<0.2）则贴死并 `_moveFin=true`。**然后仍然**再跑一遍 `+= delta * 0.5`——贴死的那帧会被 0.5 插值拉开？贴死之后 `delta=0`，加 0 无害。未到位时每帧走一半。`scaleY` 跟 `scaleX`。\n\n### `setPosAndScale`（L280–286）\n\n瞬移，不改 `_orgPose` / `_moveType` / `_moveFin`。TOP 模式 `fadIn` 用。之后若有人 `moveResume` 会 tween 回底边原位。\n\n110→---\n\n### 脚本级 `InsBar`（L293–348）—— 气 0–300 四格\n\n构造即 `setProcess(0)`。\n\n#### `getProcess` / `ui`\n\n返回缓存 `_process`；`ui` 给外部（本文件没人读 `ui`）。\n\n120→#### `setProcess`（L317–342）\n\n写 `_process`。可见性：\n\n- `bar1.visible = process>0`\n- `bar2.visible = process>1`\n- `bar3.visible = process>2`\n- `bar4.visible = process>=3`（满 300 亮第 4 格，scale 不管）\n\n宽度：\n130→\n- `>2`：bar1=bar2=`scaleX=1`，bar3=`process-2`（反编译 `_temp_2` 连续赋值）。\n- `>1`：bar1=1，bar2=`process-1`（**不**改 bar3）。\n- else：bar1=`process`（**不**改 bar2/bar3）。\n\n`txtmc.gotoAndStop(int(process)+1)`：0→1，1.x→2，2.x→3，3→4。`int(2.0)+1=3`，刚进第三格数字就跳 3。\n\n#### `setDirect`（L344–347）\n\n`txtmc.scaleX` ±1。\n140→\n---\n\n### 脚本级 `InsFzBar`（L350–388）—— 辅助气竖条\n\n#### 构造（L361–370）\n\n`_loc2_ = barmc.getBounds(barmc)` **算了不用**。`_scroll = Rectangle(0,0,width,height)`，`_height=scroll.height`。然后 `barmc.scaleY=-1`，`barmc.y=barmc.height`：竖直翻转，让 `scrollRect` 从「视觉底部」往上长。?\n\n`getBounds` 丢弃可能是曾经用 bounds 当 scroll 原点，后改成 (0,0,width,height)。?\n150→\n#### `setProcess`（L382–387）\n\n`_process=param1`（期望 0–1）。`_scroll.height = param1 * _height`，赋回 `barmc.scrollRect`。`fzqi>100` 会超高；负 height 在 Flash 里行为未定义。正常 `renderFzQi` 把 fzqi 卡在 100。\n","absolute_path":"/workspace/bvn-3.3/reverse/line-by-line/engine/game/bvn/ui/fight/QiBar.md","offset":null,"raw_output":"# `QiBar` — 气条 + 辅助气 + 辅助脸\n\n一句话目的：包 `qbar_mc`。主条显示 `FighterMain.qi`（0–300，三格），侧条 `fzqi`（0–100）满了播 `readymc`。脸是**辅助** `Assister.data`，不是出战角色。P2 `setDirect(-1)`。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/QiBar.as`（388 行，含脚本级 `InsBar` / `InsFzBar`）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造绑 `ui.fzqi1/fzqi2`；P2 `setDirect(-1)`；`initlize` → `setFighter(current, fuzhu)`；`render`/`renderAnimate`/`fadIn`/`fadOut`/`destory`；KO/超时 `fadOut()`；`QI_BAR_MODE==TOP` 时 `setPosAndScale(120|675, 60, 0.8)`；死代码 `renderQibarPos` 会 `moveTo`/`moveResume`。\n- **Callees**：`AssetManager.I.getFighterFace(assister.data)`（默认 50×50）；`KyoUtils.drawDisplay`（BITMAP 把 `facemc` 烤成 Bitmap）；`GameUI.BITMAP_UI`。\n\n## SWF 槽（`qbar_mc`）\n\n| 实例 | 类 | 用途 |\n|---|---|---|\n| `barmc` | `qbar_barmc` | `bar.bar1..bar4` + `txtmc`（气格数） |\n| `fzqibar` | `qbar_fzqi_mc` | 辅助气，`barmc` 用 `scrollRect` 裁高度 |\n| `facemc` | `qbar_facemc` | `ct` 里塞辅助脸 |\n| `readymc` | MovieClip | fzqi 满条时 `mc.play()` |\n\n帧脚本：帧 1 `stop`；帧 15 / 38 `stop`+`COMPLETE`（fadin_fin / fadout_fin）。\n\n气格：`qbar_barmcgroup.bar1..4`。`qi/100` 映射到 0–3；`bar1`=0–100，`bar2`=100–200，`bar3`=200–300，`bar4` 在 ≥300 时 visible。`txtmc` 帧 = `int(process)+1`（1..4）。\n\n## 命名备注\n\n- `destory` / `fadIn` / `fadOut`：原拼写。\n- `readymc` 不是 `readymc` 拼错成 ready-mc 以外的词，SWF 实例名就是 `readymc`。\n- `_orgPose`：构造时 `_ui.x/y`，`moveResume` 的目标。`setPosAndScale` **不**改它，TOP 模式挪走后 AUTO 的 `moveResume` 仍回 SWF 原位。\n- `_tweenSpd=0.5`：每逻辑帧走完一半剩余位移。`moveTo` 本包无调用。\n- `_moveType`：0=回原位，1=去指定点。与 `_moveFin` 一起防重入。\n- BITMAP 构造即 `gotoAndStop(\"fadin_fin\"); visible=false`。`fadIn` 只 `visible=true`，无淡入。\n- `setCacheBitmap`：非 BITMAP 才把 `facemc.cacheAsBitmap` 打开（淡入完成/瞬显）或关掉（动画中）。BITMAP 直接 return。\n- `InsBar.setProcess` 在 process 从 >2 掉到 ≤2 时**不**把 `bar3.scaleX` 收回；`bar3.visible=false` 所以看不见。?\n- `FighterMain.qiMax=300` 是 const；UI 用 `qi/100` 封顶 3，与之一致。`fzqiMax=100`，这里写死 `/100`。\n- 脸 `setFighter` 每次 `ct.addChild` **不**清旧孩子。`resetFight` 再 `initlize` 会叠一张。BITMAP 则重 `drawDisplay`，旧脸还在 `facemc` 子树里一起被烤进去。?\n\n## 逐行说明\n\n### 字段 / 构造（L17–59）\n\n`_bar=new InsBar(_ui.barmc)`，`_fzBar=new InsFzBar(_ui.fzqibar)`，`_fzReadyMc=_ui.readymc`。记下 `_orgPose`。听 `\"complete\"`。BITMAP：停在 `fadin_fin` 并隐藏。\n\n### `destory`（L61–75）\n\n卸 COMPLETE，`gotoAndStop(\"destory\")`，`_ui=null`。有 `_faceBp` 则 `bitmapData.dispose()`。`_fighter=null`。不 destory Ins*。\n\n### `uiPlayComplete`（L77–88）\n\n淡入完成：`visible=true` + `setCacheBitmap(true)`。淡出完成：`visible=false`。BITMAP 不播 MC，不依赖这条。\n\n### `setFighter`（L90–117）\n\n`param1`=出战 `FighterMain`（读 qi/fzqi），`param2`=该组 `Assister`。\n\n- `param2 && param2.data`：`AssetManager.getFighterFace`（`faceUrl`，默认 50×50）塞进 `_ui.facemc.ct`。没图就算了。\n- BITMAP：`KyoUtils.drawDisplay(_ui.facemc)` → `_faceBp`，按 `facemc` 的 x/y 放到 `_ui` 上；try `removeChild(facemc)`；再 `addChild(readymc)`（保证 ready 在脸 Bitmap 之上）。第二次 `setFighter` 会 **再** draw 一张 `_faceBp` 而不 dispose 旧的。?\n\n无辅助时 BITMAP 仍 draw 空 `facemc`。\n\n### `setCacheBitmap`（L119–126）\n\n`BITMAP_UI` return。否则 `facemc.cacheAsBitmap=param1`。淡入动画中 false，停住 true。\n\n### `setDirect`（L128–132）\n\n`_bar.setDirect` 翻气数字 `txtmc`。`_fzReadyMc.mc.scaleX` 按符号 ±1。fz 条、脸不在这里翻——P2 的 `fzqi2` SWF 已镜像。`_fzReadyMc.mc` 若 null 会 NPE；SWF 有 `mc`。\n\n### `render`（L134–165）\n\n1. `_qiRate = qi/100`，`>3` 钳成 3。\n2. 读当前 `_bar.getProcess()`，差的绝对值 <0.01 则贴死，否则 `process += delta*0.4`（与 EnergyBar 同系数）。\n3. `_fzBar.setProcess(fzqi/100)`——**无 lerp**，瞬时裁 scrollRect。\n4. `fz` 满（`>=1`）与 `readymc.visible` 不同才改 visible：满则 `mc.play()`，否则 `mc.gotoAndStop(1)`。避免每帧 `play()` 重开。\n\n`_fighter` 空则 NPE。`qi` 负会让 bar1.scaleX 负（可见性 `>0` 为 false，条藏）。\n\n### `renderAnimate`（L167–180）\n\n与 `FightBar.renderAnimate` 同构：`_isRenderAnimate` 闸，标签 `fadin_fin`/`fadout_fin` 关闸，否则 `nextFrame()`。BITMAP 从不置闸。\n\n### `fadIn`（L182–205）\n\n已显示 return。`_isFadIn=true`，`visible=true`。BITMAP 立刻 return（已在 fadin_fin）。否则 `param1` 真：关 cache、`\"fadin\"`、开动画；假：`\"fadin_fin\"` + 开 cache。\n\n`FightUI.fadIn` 在 TOP 模式强制 `param1=false`。\n\n### `fadOut`（L207–229）\n\n未显示 return。`_isFadIn=false`。BITMAP：`visible=false` return。否则带动画则 `\"fadout\"`+关 cache；否则直接 `visible=false`。\n\nKO 的 `playKO2`/`playTimeOver` 默认 `param1=true`，BITMAP 下就是藏。\n\n### `moveTo`（L231–246）\n\n目标 `(x,y,scale)`。若已在 type 1 且 `_moveFin` → return（到过就不再跟，即使目标变了也不追——zoom 来回穿 1.5 时第一次到位后卡住）。切到 type 1 时清 `_moveFin`。然后 `moving`。本包无调用。?\n\n### `moveResume`（L248–263）\n\n回 `_orgPose`、scale 1。type 0 + 已完成则 return。否则切 type 0 再 `moving`。\n\n### `moving`（L265–278）\n\n三轴都够近（|dx|<2、|dy|<2、|dScale|<0.2）则贴死并 `_moveFin=true`。**然后仍然**再跑一遍 `+= delta * 0.5`——贴死的那帧会被 0.5 插值拉开？贴死之后 `delta=0`，加 0 无害。未到位时每帧走一半。`scaleY` 跟 `scaleX`。\n\n### `setPosAndScale`（L280–286）\n\n瞬移，不改 `_orgPose` / `_moveType` / `_moveFin`。TOP 模式 `fadIn` 用。之后若有人 `moveResume` 会 tween 回底边原位。\n\n---\n\n### 脚本级 `InsBar`（L293–348）—— 气 0–300 四格\n\n构造即 `setProcess(0)`。\n\n#### `getProcess` / `ui`\n\n返回缓存 `_process`；`ui` 给外部（本文件没人读 `ui`）。\n\n#### `setProcess`（L317–342）\n\n写 `_process`。可见性：\n\n- `bar1.visible = process>0`\n- `bar2.visible = process>1`\n- `bar3.visible = process>2`\n- `bar4.visible = process>=3`（满 300 亮第 4 格，scale 不管）\n\n宽度：\n\n- `>2`：bar1=bar2=`scaleX=1`，bar3=`process-2`（反编译 `_temp_2` 连续赋值）。\n- `>1`：bar1=1，bar2=`process-1`（**不**改 bar3）。\n- else：bar1=`process`（**不**改 bar2/bar3）。\n\n`txtmc.gotoAndStop(int(process)+1)`：0→1，1.x→2，2.x→3，3→4。`int(2.0)+1=3`，刚进第三格数字就跳 3。\n\n#### `setDirect`（L344–347）\n\n`txtmc.scaleX` ±1。\n\n---\n\n### 脚本级 `InsFzBar`（L350–388）—— 辅助气竖条\n\n#### 构造（L361–370）\n\n`_loc2_ = barmc.getBounds(barmc)` **算了不用**。`_scroll = Rectangle(0,0,width,height)`，`_height=scroll.height`。然后 `barmc.scaleY=-1`，`barmc.y=barmc.height`：竖直翻转，让 `scrollRect` 从「视觉底部」往上长。?\n\n`getBounds` 丢弃可能是曾经用 bounds 当 scroll 原点，后改成 (0,0,width,height)。?\n\n#### `setProcess`（L382–387）\n\n`_process=param1`（期望 0–1）。`_scroll.height = param1 * _height`，赋回 `barmc.scrollRect`。`fzqi>100` 会超高；负 height 在 Flash 里行为未定义。正常 `renderFzQi` 把 fzqi 卡在 100。\n","total_lines":154}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-cf1ba55d-004e-4db0-acd8-a5cfe31794f5-23","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# `HitsUI` — 连击数字（屏幕固定位）\n\n一句话目的：包 `hits_mc`。用 `MCNumber(hits_num_mc)` 显示连击数，走 SWF 标签 `fadin` / `update` / `fadout`。P1=`hits1` 会按数字宽度把整块往右推，避免多位数盖住左边。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/HitsUI.as`（76 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new HitsUI(ui.hits1/hits2)`；`showHits(n, team)` → `show(n)`；`hideHits(team)` → `hide()`；`destory`。\n10→- **上游**：`FighterEventCtrl.addHits` 在 `GameLogic.addHits` 返回 **>1** 才 `showHits`（第一击不弹）。`onHurtResume` / `onHurtDown` → `hideHits(uiID)`。`uiID` 是 team 1/2，不是 fighter 实例 id。\n- **Callees**：`ResUtils.I.getItemClass(ResUtils.I.fight, \"hits_num_mc\")`；`net.play5d.kyo.display.MCNumber`。\n\n## 不是世界坐标\n\n`hits_mc` 是 `ui_fight` 上的屏幕布局。本类 **不**调 `GameState.getGameSpriteGlobalPosition`。那条 API 给 `FightUI.getPlayerPos` 的 `player_pos_p1/p2` 用。部分总览把「hits 数字跟角色」写在本类上，与源码不符。\n\n`hits_mc` 帧脚本（`decompiled/ui/fight/scripts/hits_mc.as`）：\n\n| 帧 | 脚本 |\n20→|---|---|\n| 1 | `stop(); visible=false` |\n| 10 | `visible=true`（fadin 中途显） |\n| 20 | `stop`（fadin 完） |\n| 38 | `stop`（update 完） |\n| 56 | `gotoAndStop(1)`（fadout 完回隐） |\n\n`gotoAndPlay(\"fadin\"|\"update\"|\"fadout\")` 靠 Flash 时间轴自己跑，**不**经 `FightUI.renderAnimate`。\n\n## 命名备注\n30→\n- `destory`：try 从 `ct` 摘 `_txtmc`，null 引用。不 `stop` MC。\n- `_orgPos`：构造时 `hits_mc` 的 x/y。只有 **实例名 `\"hits1\"`** 才按数字宽度改 `_mc.x`；`hits2` 不动块，只把数字本身左移。\n- `MCNumber(cls, 0, 1, 35)`：初始 0、数字从 MC 帧 `startFrame+digit`（帧 1=0？帧 1+0=1 是 0 的字形）、每格宽 35、`bits=0` 不补零。位数变长时 `width` 变。\n- `_txtmc.x = -width + 45`：数字右对齐到一个 45px 锚点。\n- `hits1`：`_mc.x = _orgPos.x - _txtmc.x`。因为 `_txtmc.x` 是负数（`-width+45`），整块往右移 `width-45`，多位数向右长。\n- 已显示再 `show` 走 `\"update\"` 弹一下，不重播 fadin。\n- `hide` 不关 `_txtmc`，fadout 播完 SWF 自己 `gotoAndStop(1)` 藏。\n\n## 逐行说明\n40→\n### 字段 / 构造（L9–26）\n\n`_mc`=`hits_mc`（带 `ct`、`hitsmc`）。取 `hits_num_mc` Class，`new MCNumber(..., 0, 1, 35)` 放进 `_mc.ct`。记下 `_orgPos`。此时数字是 0 但 MC 帧 1 `visible=false`。\n\n### `destory`（L28–46）\n\n有 `_txtmc` 则 try `ct.removeChild`。null `_txtmc`/`_mc`/`_orgPos`。`FightUI.destory` 稍后 `ui.removeChildren()` 会把 `hits_mc` 也摘掉。\n\n### `show`（L48–64）\n50→\n1. `_txtmc.number = param1`：重建每位数字 MC（`MCNumber` setter 先 remove 旧的）。\n2. `_txtmc.x = -width + 45`。\n3. **仅** `_mc.name==\"hits1\"`：`_mc.x = _orgPos.x - _txtmc.x`。`hits2` 的 name 是 `\"hits2\"`，不进。\n4. 已 `_isShow`：`gotoAndPlay(\"update\")` return（连击 +1 的跳动）。\n5. 否则 `_isShow=true`，`gotoAndPlay(\"fadin\")`。\n\n`param1` 类型 `int`，`MCNumber.number` 是 `uint`，负数会绕成大正数。正常 hits≥2。\n\n### `hide`（L66–74）\n60→\n未显示 return。`_isShow=false`，`gotoAndPlay(\"fadout\")`。连击中途再 `show` 可以打断 fadout 重 fadin（`_isShow` 已 false）。SWF 若正在 fadout 被 fadin 切开，时间轴从 fadin 标签重来。\n"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# `HitsUI` — 连击数字（屏幕固定位）\n\n一句话目的：包 `hits_mc`。用 `MCNumber(hits_num_mc)` 显示连击数，走 SWF 标签 `fadin` / `update` / `fadout`。P1=`hits1` 会按数字宽度把整块往右推，避免多位数盖住左边。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/HitsUI.as`（76 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new HitsUI(ui.hits1/hits2)`；`showHits(n, team)` → `show(n)`；`hideHits(team)` → `hide()`；`destory`。\n10→- **上游**：`FighterEventCtrl.addHits` 在 `GameLogic.addHits` 返回 **>1** 才 `showHits`（第一击不弹）。`onHurtResume` / `onHurtDown` → `hideHits(uiID)`。`uiID` 是 team 1/2，不是 fighter 实例 id。\n- **Callees**：`ResUtils.I.getItemClass(ResUtils.I.fight, \"hits_num_mc\")`；`net.play5d.kyo.display.MCNumber`。\n\n## 不是世界坐标\n\n`hits_mc` 是 `ui_fight` 上的屏幕布局。本类 **不**调 `GameState.getGameSpriteGlobalPosition`。那条 API 给 `FightUI.getPlayerPos` 的 `player_pos_p1/p2` 用。部分总览把「hits 数字跟角色」写在本类上，与源码不符。\n\n`hits_mc` 帧脚本（`decompiled/ui/fight/scripts/hits_mc.as`）：\n\n| 帧 | 脚本 |\n20→|---|---|\n| 1 | `stop(); visible=false` |\n| 10 | `visible=true`（fadin 中途显） |\n| 20 | `stop`（fadin 完） |\n| 38 | `stop`（update 完） |\n| 56 | `gotoAndStop(1)`（fadout 完回隐） |\n\n`gotoAndPlay(\"fadin\"|\"update\"|\"fadout\")` 靠 Flash 时间轴自己跑，**不**经 `FightUI.renderAnimate`。\n\n## 命名备注\n30→\n- `destory`：try 从 `ct` 摘 `_txtmc`，null 引用。不 `stop` MC。\n- `_orgPos`：构造时 `hits_mc` 的 x/y。只有 **实例名 `\"hits1\"`** 才按数字宽度改 `_mc.x`；`hits2` 不动块，只把数字本身左移。\n- `MCNumber(cls, 0, 1, 35)`：初始 0、数字从 MC 帧 `startFrame+digit`（帧 1=0？帧 1+0=1 是 0 的字形）、每格宽 35、`bits=0` 不补零。位数变长时 `width` 变。\n- `_txtmc.x = -width + 45`：数字右对齐到一个 45px 锚点。\n- `hits1`：`_mc.x = _orgPos.x - _txtmc.x`。因为 `_txtmc.x` 是负数（`-width+45`），整块往右移 `width-45`，多位数向右长。\n- 已显示再 `show` 走 `\"update\"` 弹一下，不重播 fadin。\n- `hide` 不关 `_txtmc`，fadout 播完 SWF 自己 `gotoAndStop(1)` 藏。\n\n## 逐行说明\n40→\n### 字段 / 构造（L9–26）\n\n`_mc`=`hits_mc`（带 `ct`、`hitsmc`）。取 `hits_num_mc` Class，`new MCNumber(..., 0, 1, 35)` 放进 `_mc.ct`。记下 `_orgPos`。此时数字是 0 但 MC 帧 1 `visible=false`。\n\n### `destory`（L28–46）\n\n有 `_txtmc` 则 try `ct.removeChild`。null `_txtmc`/`_mc`/`_orgPos`。`FightUI.destory` 稍后 `ui.removeChildren()` 会把 `hits_mc` 也摘掉。\n\n### `show`（L48–64）\n50→\n1. `_txtmc.number = param1`：重建每位数字 MC（`MCNumber` setter 先 remove 旧的）。\n2. `_txtmc.x = -width + 45`。\n3. **仅** `_mc.name==\"hits1\"`：`_mc.x = _orgPos.x - _txtmc.x`。`hits2` 的 name 是 `\"hits2\"`，不进。\n4. 已 `_isShow`：`gotoAndPlay(\"update\")` return（连击 +1 的跳动）。\n5. 否则 `_isShow=true`，`gotoAndPlay(\"fadin\")`。\n\n`param1` 类型 `int`，`MCNumber.number` 是 `uint`，负数会绕成大正数。正常 hits≥2。\n\n### `hide`（L66–74）\n60→\n未显示 return。`_isShow=false`，`gotoAndPlay(\"fadout\")`。连击中途再 `show` 可以打断 fadout 重 fadin（`_isShow` 已 false）。SWF 若正在 fadout 被 fadin 切开，时间轴从 fadin 标签重来。\n","content_concise":"1→# `HitsUI` — 连击数字（屏幕固定位）\n\n一句话目的：包 `hits_mc`。用 `MCNumber(hits_num_mc)` 显示连击数，走 SWF 标签 `fadin` / `update` / `fadout`。P1=`hits1` 会按数字宽度把整块往右推，避免多位数盖住左边。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/HitsUI.as`（76 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new HitsUI(ui.hits1/hits2)`；`showHits(n, team)` → `show(n)`；`hideHits(team)` → `hide()`；`destory`。\n10→- **上游**：`FighterEventCtrl.addHits` 在 `GameLogic.addHits` 返回 **>1** 才 `showHits`（第一击不弹）。`onHurtResume` / `onHurtDown` → `hideHits(uiID)`。`uiID` 是 team 1/2，不是 fighter 实例 id。\n- **Callees**：`ResUtils.I.getItemClass(ResUtils.I.fight, \"hits_num_mc\")`；`net.play5d.kyo.display.MCNumber`。\n\n## 不是世界坐标\n\n`hits_mc` 是 `ui_fight` 上的屏幕布局。本类 **不**调 `GameState.getGameSpriteGlobalPosition`。那条 API 给 `FightUI.getPlayerPos` 的 `player_pos_p1/p2` 用。部分总览把「hits 数字跟角色」写在本类上，与源码不符。\n\n`hits_mc` 帧脚本（`decompiled/ui/fight/scripts/hits_mc.as`）：\n\n| 帧 | 脚本 |\n20→|---|---|\n| 1 | `stop(); visible=false` |\n| 10 | `visible=true`（fadin 中途显） |\n| 20 | `stop`（fadin 完） |\n| 38 | `stop`（update 完） |\n| 56 | `gotoAndStop(1)`（fadout 完回隐） |\n\n`gotoAndPlay(\"fadin\"|\"update\"|\"fadout\")` 靠 Flash 时间轴自己跑，**不**经 `FightUI.renderAnimate`。\n\n## 命名备注\n30→\n- `destory`：try 从 `ct` 摘 `_txtmc`，null 引用。不 `stop` MC。\n- `_orgPos`：构造时 `hits_mc` 的 x/y。只有 **实例名 `\"hits1\"`** 才按数字宽度改 `_mc.x`；`hits2` 不动块，只把数字本身左移。\n- `MCNumber(cls, 0, 1, 35)`：初始 0、数字从 MC 帧 `startFrame+digit`（帧 1=0？帧 1+0=1 是 0 的字形）、每格宽 35、`bits=0` 不补零。位数变长时 `width` 变。\n- `_txtmc.x = -width + 45`：数字右对齐到一个 45px 锚点。\n- `hits1`：`_mc.x = _orgPos.x - _txtmc.x`。因为 `_txtmc.x` 是负数（`-width+45`），整块往右移 `width-45`，多位数向右长。\n- 已显示再 `show` 走 `\"update\"` 弹一下，不重播 fadin。\n- `hide` 不关 `_txtmc`，fadout 播完 SWF 自己 `gotoAndStop(1)` 藏。\n\n## 逐行说明\n40→\n### 字段 / 构造（L9–26）\n\n`_mc`=`hits_mc`（带 `ct`、`hitsmc`）。取 `hits_num_mc` Class，`new MCNumber(..., 0, 1, 35)` 放进 `_mc.ct`。记下 `_orgPos`。此时数字是 0 但 MC 帧 1 `visible=false`。\n\n### `destory`（L28–46）\n\n有 `_txtmc` 则 try `ct.removeChild`。null `_txtmc`/`_mc`/`_orgPos`。`FightUI.destory` 稍后 `ui.removeChildren()` 会把 `hits_mc` 也摘掉。\n\n### `show`（L48–64）\n50→\n1. `_txtmc.number = param1`：重建每位数字 MC（`MCNumber` setter 先 remove 旧的）。\n2. `_txtmc.x = -width + 45`。\n3. **仅** `_mc.name==\"hits1\"`：`_mc.x = _orgPos.x - _txtmc.x`。`hits2` 的 name 是 `\"hits2\"`，不进。\n4. 已 `_isShow`：`gotoAndPlay(\"update\")` return（连击 +1 的跳动）。\n5. 否则 `_isShow=true`，`gotoAndPlay(\"fadin\")`。\n\n`param1` 类型 `int`，`MCNumber.number` 是 `uint`，负数会绕成大正数。正常 hits≥2。\n\n### `hide`（L66–74）\n60→\n未显示 return。`_isShow=false`，`gotoAndPlay(\"fadout\")`。连击中途再 `show` 可以打断 fadout 重 fadin（`_isShow` 已 false）。SWF 若正在 fadout 被 fadin 切开，时间轴从 fadin 标签重来。\n","absolute_path":"/workspace/bvn-3.3/reverse/line-by-line/engine/game/bvn/ui/fight/HitsUI.md","offset":null,"raw_output":"# `HitsUI` — 连击数字（屏幕固定位）\n\n一句话目的：包 `hits_mc`。用 `MCNumber(hits_num_mc)` 显示连击数，走 SWF 标签 `fadin` / `update` / `fadout`。P1=`hits1` 会按数字宽度把整块往右推，避免多位数盖住左边。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/HitsUI.as`（76 行）\n\n## Callers / callees\n\n- **Callers**：只 `FightUI`。构造 `new HitsUI(ui.hits1/hits2)`；`showHits(n, team)` → `show(n)`；`hideHits(team)` → `hide()`；`destory`。\n- **上游**：`FighterEventCtrl.addHits` 在 `GameLogic.addHits` 返回 **>1** 才 `showHits`（第一击不弹）。`onHurtResume` / `onHurtDown` → `hideHits(uiID)`。`uiID` 是 team 1/2，不是 fighter 实例 id。\n- **Callees**：`ResUtils.I.getItemClass(ResUtils.I.fight, \"hits_num_mc\")`；`net.play5d.kyo.display.MCNumber`。\n\n## 不是世界坐标\n\n`hits_mc` 是 `ui_fight` 上的屏幕布局。本类 **不**调 `GameState.getGameSpriteGlobalPosition`。那条 API 给 `FightUI.getPlayerPos` 的 `player_pos_p1/p2` 用。部分总览把「hits 数字跟角色」写在本类上，与源码不符。\n\n`hits_mc` 帧脚本（`decompiled/ui/fight/scripts/hits_mc.as`）：\n\n| 帧 | 脚本 |\n|---|---|\n| 1 | `stop(); visible=false` |\n| 10 | `visible=true`（fadin 中途显） |\n| 20 | `stop`（fadin 完） |\n| 38 | `stop`（update 完） |\n| 56 | `gotoAndStop(1)`（fadout 完回隐） |\n\n`gotoAndPlay(\"fadin\"|\"update\"|\"fadout\")` 靠 Flash 时间轴自己跑，**不**经 `FightUI.renderAnimate`。\n\n## 命名备注\n\n- `destory`：try 从 `ct` 摘 `_txtmc`，null 引用。不 `stop` MC。\n- `_orgPos`：构造时 `hits_mc` 的 x/y。只有 **实例名 `\"hits1\"`** 才按数字宽度改 `_mc.x`；`hits2` 不动块，只把数字本身左移。\n- `MCNumber(cls, 0, 1, 35)`：初始 0、数字从 MC 帧 `startFrame+digit`（帧 1=0？帧 1+0=1 是 0 的字形）、每格宽 35、`bits=0` 不补零。位数变长时 `width` 变。\n- `_txtmc.x = -width + 45`：数字右对齐到一个 45px 锚点。\n- `hits1`：`_mc.x = _orgPos.x - _txtmc.x`。因为 `_txtmc.x` 是负数（`-width+45`），整块往右移 `width-45`，多位数向右长。\n- 已显示再 `show` 走 `\"update\"` 弹一下，不重播 fadin。\n- `hide` 不关 `_txtmc`，fadout 播完 SWF 自己 `gotoAndStop(1)` 藏。\n\n## 逐行说明\n\n### 字段 / 构造（L9–26）\n\n`_mc`=`hits_mc`（带 `ct`、`hitsmc`）。取 `hits_num_mc` Class，`new MCNumber(..., 0, 1, 35)` 放进 `_mc.ct`。记下 `_orgPos`。此时数字是 0 但 MC 帧 1 `visible=false`。\n\n### `destory`（L28–46）\n\n有 `_txtmc` 则 try `ct.removeChild`。null `_txtmc`/`_mc`/`_orgPos`。`FightUI.destory` 稍后 `ui.removeChildren()` 会把 `hits_mc` 也摘掉。\n\n### `show`（L48–64）\n\n1. `_txtmc.number = param1`：重建每位数字 MC（`MCNumber` setter 先 remove 旧的）。\n2. `_txtmc.x = -width + 45`。\n3. **仅** `_mc.name==\"hits1\"`：`_mc.x = _orgPos.x - _txtmc.x`。`hits2` 的 name 是 `\"hits2\"`，不进。\n4. 已 `_isShow`：`gotoAndPlay(\"update\")` return（连击 +1 的跳动）。\n5. 否则 `_isShow=true`，`gotoAndPlay(\"fadin\")`。\n\n`param1` 类型 `int`，`MCNumber.number` 是 `uint`，负数会绕成大正数。正常 hits≥2。\n\n### `hide`（L66–74）\n\n未显示 return。`_isShow=false`，`gotoAndPlay(\"fadout\")`。连击中途再 `show` 可以打断 fadout 重 fadin（`_isShow` 已 false）。SWF 若正在 fadout 被 fadin 切开，时间轴从 fadin 标签重来。\n","total_lines":62}},"locations":[]}
{"type":"tool_call_update","toolCallId":"call-cf1ba55d-004e-4db0-acd8-a5cfe31794f5-21","status":"completed","content":[{"type":"content","content":{"type":"text","text":"1→# `FightUI` — 战斗 HUD 根（`IGameUI`）\n\n一句话目的：实现 `IGameUI`。从 `ResUtils.fight` 实例化 `ui_fight`，装配顶部血条组、两侧气条、连击数字、开场/KO MC、屏外角色标记和暂停框。`GameUI.initFight` 创建，`GameState` 把它挂在镜头层**外面**（屏幕坐标 800×600）。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightUI.as`（579 行）\n\n## Callers / callees\n\n- **Callers**\n10→  - `GameUI.initFight`：`new FightUI()` + `setVolume(config.soundVolume)` + `initlize(p1Group, p2Group)`。已有 `FightUI` 则复用，不 destory。\n  - `GameUI.render` → `IGameUI.render`；按 30fps 语义再 `renderAnimate`。`GameState.render` 每逻辑帧调 `gameUI.render()`。\n  - `GameUI.fadIn` → `FightUI.fadIn()`（默认 `true`）再 `setVolume`。`GameUI.fadOut` **误调** `fadIn()`，终场不走这条。\n  - `GameStartCtrl`：intro 结束 `showStart(cb)`；skip 且尚未 FIGHT 时 `fadIn(true)`。\n  - `GameEndCtrl`：`showEnd(cb, {winner,loser})` 或 `{drawGame:true}`；结束 `clearStartAndEnd`；KO 路径再 `fadOut(false)`。\n  - `FighterEventCtrl.addHits`：hits>1 才 `showHits(hits, teamUiID)`；`removeHits` → `hideHits(uiID)`。\n  - `GameCtrl.pause(true)` / `resume(true)`：菜单暂停才转到 `FightUI.pause` / `resume`。无参 `pause()`（KO 顿帧）**不**弹暂停框。\n  - `GameCtrl.buildGame` 练习模式：`GameUI.I.fadIn()`（立刻出 HUD，无 ROUND/FIGHT）。\n- **Callees**\n  - 子件：`FightBar`、`QiBar`×2、`HitsUI`×2、`PauseDialog`。\n20→  - `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\"|\"player_pos_p1\"|\"player_pos_p2\")`。\n  - `EffectCtrl`：`freezeEnabled`、`doEffectById(\"hit_end\")`、`shine`、`BGEffect(\"kobg\")`、`shake`、`slowDown`/`slowDownResume`。\n  - `GameCtrl.I`：`pause`/`resume`（无参顿帧）、`gameRunData`、`gameState.cameraFocusOne` / `getGameSpriteGlobalPosition` / `camera.getZoom`。\n  - `SoundCtrl.I.playSwcSound`：`snd_over_hit`、`snd_ko` / `snd_ko_bs`（同包 SWC，无 import）。\n  - `GameEvent`：街机听 `\"SCORE_UPDATE\"`。\n  - `GameMode.isAcrade` / `isSingleMode`；`GameData.I.score`；`GameConfig.GAME_SIZE` / `FPS_GAME`。\n\n## HUD 布局 / SWF\n\n全部来自 `ResUtils.fight`（嵌入 `fight_swf$…`，链接名见 `decompiled/ui/fight/scripts/`）。**不**走 `ResUtils` 常量表。\n30→\n```\nGameState（Istage Sprite）\n├── map.bgLayer\n├── _gameLayer          ← GameCamera 作用对象\n│   ├── mapLayer / _playerLayer / front*\n└── ui_fight            ← FightUI.ui，屏幕空间，不随镜头滚\n    ├── hpbarmc         FightBar：P1 左 / P2 右 / 计时正中\n    │   ├── face1 / face2     FightFaceGroup（3 槽头像）\n    │   ├── bar1 / bar2       FighterHpBar（绿条+红拖尾）\n40→    │   ├── energy1 / energy2 EnergyBar（体力 energy，不是气）\n    │   ├── timemc            FightTimeUI\n    │   ├── win_p1 / win_p2   WinUI 胜场灯\n    │   └── scoremc           FightScoreUI（街机才亮）\n    ├── fzqi1 / fzqi2   QiBar：气 0–300 + 辅助 fzqi + 辅助脸\n    ├── hits1 / hits2   HitsUI：连击数字（屏幕固定位，不跟角色）\n    ├── startKOmc       fight_fla.game_start_mc_44：ROUND/FIGHT/KO/…\n    ├── player_pos_p1/p2 代码 addChild，zoom≤1.8 时标屏外角色\n    └── PauseDialog     代码 addChild，菜单暂停\n```\n50→\nP1 一律左侧（`face1`/`bar1`/`energy1`/`fzqi1`/`hits1`/`win_p1`），P2 右侧并 `setDirect(-1)`。计时在 `hpbarmc.timemc` 水平居中。气条 SWF 默认贴底；`QI_BAR_MODE==TOP` 才会被代码挪到血条附近 `(120,60)` / `(675,60)` scale 0.8。\n\n`startKOmc` 时间轴由 `renderStartAndKO` 按动画帧 `nextFrame()` 推进（`gotoAndStop` 标签后靠代码走帧，不是 `play()`）。\n\n## 命名备注 / 符号对照\n\n- 拼写：`destory`、`initlize`、`fadIn`/`fadOut`、`isAcrade` 全工程如此。\n- `QI_BAR_MODE`：语义对齐 `FightQiBarMode`（0=AUTO / 1=TOP / 2=BOTTOM），但**本包没有任何写入**，始终默认 `0`。`FightQiBarMode` 类本身也没被 import。\n- `renderQibarPos`：按 zoom 把 AUTO 气条挪到顶部或还原——**从未被调用**（`render` 只调 `renderPlayerPosUI`）。AUTO 的动态位移是死代码。?\n60→- `BITMAP_UI`：`GameUI.BITMAP_UI=true` 且本包无写入。血条/气条走位图烘焙路径，MC fadIn 动画基本不播。\n- `showStart` 的 `onFight`：收到 `\"fight\"` 只卸监听，**空体**。真正开操作靠 `\"complete\"` → `GameStartCtrl` 清 `_uiPlaying`。\n- `EffectCtrl.shake(5,0,1.5)`：第三参是**毫秒**。`FighterEffectCtrl.shake` 会 `*1000`，这里直接传 `1.5`，衰减极快（见 `EffectCtrl.md`）。几乎确定是 bug。\n- `getPlayerPos` 下沿钳制写成了 `x = GAME_SIZE.x-5` 而不是 `y`。?\n- `player_pos_*` 用 `getGameSpriteGlobalPosition(..., 0, -50)`。`GameState.md` 把这条写成「hits 数字」不准确——连击是 `hits_mc` 的 SWF 布局坐标，不跟角色。\n- `setTimeout(playKO2, 500)` 是墙钟 500ms，不受 `GameCtrl.pause` / slowDown 影响。\n- `actionState` 直接比数字：12/13=必杀、22=击飞、30=死（`FighterActionState`）。\n- `snd_ko` / `snd_ko_bs` / `snd_over_hit`：main.swf 嵌入 MP3，`SoundCtrl.playSwcSound`。\n\n## 开场 / KO 时间线（`startKOmc`）\n70→\n`fight_fla.game_start_mc_44` 字段：`$round`、`$perfect`、`$winnerX`、`$winnerY`（本类不写 `$winnerY`，SWF 默认 90）。\n\n| 代码 `gotoAndStop` | 条件 | 派发 |\n|---|---|---|\n| `\"start\"` | round < 5 | `\"fight\"`（帧 58）、`\"complete\"`（帧 88） |\n| `\"start_final\"` | round≥5 | 同上结构 |\n| `\"ko\"` | 非超时 KO | `\"complete\"`（帧 190 一带） |\n| `\"timeover\"` | `isTimerOver` | `\"complete\"` |\n| `\"drawgame\"` | 超时且平局 | `\"complete\"` |\n80→| `\"winner\"` | 胜者条 | 子 MC `winnermc` COMPLETE 再向上派 |\n| 帧 1 | `clearStartAndEnd` | `stop` |\n\n`renderStartAndKO`：当前帧标签 `\"stop\"` 则停；标签 `\"go:xxx\"` 则 `gotoAndStop(xxx)`（SWF 内部跳转约定）；否则 `nextFrame()`。\n\n`game_start_mc_44` 其它脚本帧：27/28 按 `$round` 播 `nummc` 的 `\"r1\"..\"r5\"`；55 派 `\"fight_in\"`（本类不听）；58 `\"fight\"`；200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并写 `isPerfect`；210 把 `winnermc` 的 COMPLETE 转发出去。\n\n## `IGameUI` 对照\n\n`decompiled/.../ui/IGameUI.as`。本类全部实现，另多一个 `showWins`（接口没有）。\n90→\n| 接口 | 本类 | 谁调 |\n|---|---|---|\n| `setVolume` | 写 `ui.soundTransform` | `GameUI.initFight` / `fadIn` |\n| `destory` | 拆子件 + `removeChildren` | `GameUI.destory` ← `GameState.destory` |\n| `fadIn(Boolean=true)` | 血条+气条 | `showStart`、`GameUI.fadIn`、`GameStartCtrl.skip` |\n| `fadOut(Boolean=true)` | 同上 | `GameEndCtrl` `getUI().fadOut(false)`；KO 中途只 fadOut 气条 |\n| `getUI` | 返回 `ui_fight` | `GameUI.getUIDisplay` |\n| `render` | 血/气/屏外标/终场 | `GameUI.render` 每逻辑帧 |\n| `renderAnimate` | 淡入淡出 + startKOmc 走帧 | `GameUI` 30fps 语义 |\n100→| `showHits(n, team)` / `hideHits(team)` | HitsUI | `FighterEventCtrl` |\n| `showStart(cb, params)` | ROUND/FIGHT | `GameStartCtrl`（params 丢弃） |\n| `showEnd(cb, obj)` | KO / TIMEOVER / DRAW | `GameEndCtrl` |\n| `clearStartAndEnd` | `gotoAndStop(1)` | `GameEndCtrl` cinema 收尾 |\n| `pause` / `resume` | `PauseDialog` | 仅 `GameCtrl.pause/resume(true)` |\n\n`GameUI.fadOut()` 自己写成 `_ui.fadIn()`，等于废函数。终场不经过它。\n\n## 两种 pause\n\n110→| | `GameCtrl.pause()` | `GameCtrl.pause(true)` |\n|---|---|---|\n| 谁调 | `FightUI.playKO`、`EffectCtrl.freeze` | ESC / 失焦 |\n| `_isRenderGame` | false（物理停） | false |\n| `_isPauseGame` | 不变 | true，整段 `GameCtrl.render` return |\n| `FightUI.pause` | **不调** | 弹 `PauseDialog` |\n| HUD `render` | 仍走（`GameState.render` 在 pause 闸之前？否：`_isPauseGame` 在 EffectCtrl 之前 return，**菜单暂停时 HUD 也停**） | 停 |\n| KO 顿帧 | HUD 仍 render（`_isPauseGame` 仍 false），`renderEnd` / 气条 fadOut 动画靠 `renderAnimate`——但 `GameUI.render` 在 `GameState.render` 里，而 `GameCtrl.render` 顺序是：菜单闸 → EffectCtrl → gameState.render → `_isRenderGame` 闸。无参 pause 只关 `_isRenderGame`，**HUD 继续**。 |\n\n`PauseDialog`：半透明全屏底 + `SetBtnGroup` 三项 GAME TITLE / MOVE LIST / CONTINUE。TITLE 走 `GameUI.confrim(\"BACK TITLE?\",\"返回到主菜单？\")`（拼写 `confrim`）；MOVE LIST 叠 `MoveListSp`；CONTINUE → `GameCtrl.I.resume(true)`。\n120→\n## KO / 超时 cinema 时序\n\n```\nGameEndCtrl.showEnd(cb, {winner, loser} | {drawGame:true})\n        │\n        ├─ isTimerOver\n        │     playTimeOver()                    // 不 pause、不关 freeze\n        │       startKOmc \"timeover\" + 气条 fadOut\n        │       complete → timeoverBack\n130→        │            ├─ drawGame: playDrawGame \"drawgame\" → complete → cb\n        │            └─ 否则 _playOver=true, delay=1s → renderEnd 切胜者 → cb\n        │\n        └─ else playKO(loser)\n              freezeEnabled=false\n              hit_end + shine(白,0.5) + cameraFocusOne(loser)\n              GameCtrl.pause()                  // 顿帧\n              任一方 12/13 → BGEffect(\"kobg\",2) + 稍后 snd_ko_bs\n              shake(5,0,1.5)  + snd_over_hit    // 1.5ms bug\n              500ms 墙钟 → playKO2 \"ko\" + snd_ko + 气条 fadOut\n140→              complete → koBack: freezeEnabled=true, resume(), _playOver=true\n              renderEnd 等 loser 22→slowDown(2,0) → 30→delay 1s/2s\n              delay 到 0: cameraFocusOne(winner) + showWinner\n                         单挑 showWins；直接 cb（winner MC 可能还在播）\n```\n\n`GameEndCtrl` 同时 hold 最多 10s，cb 把 hold 清 0。之后等 `isAllowWinState` 才 `winner.win()`，再 transIn，最后 `clearStartAndEnd` + `fadOut(false)`。\n\n## 逐行说明\n\n150→### 静态 / 实例字段（L27–59）\n\n- `QI_BAR_MODE`：气条贴边策略。未赋值 → 0。\n- `ui`：`ui_fight` 根，公开给 `getUI()` / `GameState.addChild`。\n- `_fightbar`：顶部整条 HUD。\n- `_qibar1` / `_qibar2`：绑 `ui.fzqi1` / `fzqi2`。P2 构造里 `setDirect(-1)`。\n- `_hits1` / `_hits2`：绑 `ui.hits1` / `hits2`。`showHits` 用 team 1/2 选。\n- `_endParam`：`showEnd` 的 `{winner,loser,drawGame,finishBack}`。播完置 null。\n- `_renderEnd`：`render()` 里跑 `renderEnd` 的闸。\n- `_playOver`：KO / TIMEOVER MC 的 `\"complete\"` 之后才 true，开始等击飞落地。\n160→- `_showWinnerDelay`：落地后再等 N 逻辑帧才切胜者镜头。单位=游戏帧。\n- `_drawGame`：超时平局走 `playDrawGame`，不进胜者条。\n- `_isSlowDown`：击飞慢动作只开一次。\n- `_pauseDialog`：懒创建。\n- `_flyTimer`：`getTimer()` 记下进入 `HURT_FLYING` 的墙钟，用来决定胜者 delay 1s 还是 2s。\n- `_p1PosUI` / `_p2PosUI`：`player_pos_p1` / `player_pos_p2`，默认 `visible=false`。\n\n### 构造（L61–83）\n\n1. `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\")` → `ui`。\n170→2. `new FightBar(ui.hpbarmc)`。\n3. `new QiBar(ui.fzqi1)` / `new QiBar(ui.fzqi2)`，P2 `setDirect(-1)`。\n4. `new HitsUI(ui.hits1)` / `new HitsUI(ui.hits2)`。\n5. 再 `createDisplayObject` 两个 `player_pos_*`，隐藏后 `ui.addChild`。\n6. **仅** `GameMode.isAcrade()`（mode 10/20/30）：`trace(\"fightUI.initlize\")`（文案像 init，实际在构造）、`_fightbar.initScore()`、听 `\"SCORE_UPDATE\"`。VS/练习不显示分数。\n\n此时角色还没绑，等 `initlize`。`GameUI` 构造完立刻 `setVolume`。\n\n### `initlize`（L85–91）\n\n180→`param1`=P1 `GameRunFighterGroup`，`param2`=P2。\n\n- `_fightbar.setFighter`：脸/HP/体力。\n- `_qibar1.setFighter(currentFighter, fuzhu)`：气条跟**当前出战**角色，脸用**辅助** `Assister.data`。\n- `_qibar2` 同理。\n- `updateScore(null)`：即使没听事件也刷一次（非街机 `_score` 为 null，空操作）。\n\n`GameState.initFight` 与 `resetFight`（下一回合 / 组队换人）都会再进这里。`GameUI` 复用同一 `FightUI` 实例。\n\n### `setVolume`（L93–98）\n190→\n读 `ui.soundTransform`，改 `volume`，写回。`startKOmc` 里若有时间轴音效走这条。`GameUI.fadIn` 每次都重设为 `config.soundVolume`。\n\n### `showWins`（L100–103）\n\n转发 `_fightbar.showWin(fighter, wins)`。`IGameUI` **没有**这个方法；只有本类 `renderEnd` 在 `isSingleMode` 时自调。组队不亮胜场灯。\n\n### `updateScore`（L105–108）\n\n`GameEvent` `\"SCORE_UPDATE\"` 或 `initlize` 调用。写 `_fightbar.setScore(GameData.I.score)`。`param1` 未用。\n200→\n### `destory`（L110–156）\n\n顺序：\n\n1. `GameEvent.removeEventListener(\"SCORE_UPDATE\", updateScore)`（非街机也 remove，harmless）。\n2. `_pauseDialog.destory()`。\n3. `_fightbar` / `_qibar1` / `_qibar2` / `_hits1` / `_hits2` 各自 `destory` 后置 null。\n4. `ui.removeChildren()` + `ui.stopAllMovieClips()`，catch 后 `trace(e)`。`ui=null`。\n\n210→**不清**：`_p1PosUI`/`_p2PosUI`（随 `removeChildren` 摘掉，不单独 destory）、`_endParam`、终场标志、`QI_BAR_MODE`。`GameState.destory` → `GameUI.destory` 进这里。下一场 `GameUI.initFight` 会 `new FightUI()`（因为 `_ui` 已被 destory 置空？`GameUI.destory` 只调 `_ui.destory()` **不清 `_ui` 引用**——再 `initFight` 时 `_ui` 仍是已掏空的 `FightUI`，`_ui is FightUI` 为真，**不会 new**，只再 `initlize`。`ui` 已 null，后续 `render`/`fadIn` 会 NPE）。?\n\n实际战斗结束走 `goStage` 拆掉整个 `GameState`（连带 `new GameUI()`），这条脏复用只在「同一 `GameState` 上 destory UI 再 initFight」时触发，本包没有这条路径。?\n\n### `getUI`（L158–161）\n\n返回 `ui`。`GameUI.getUIDisplay` / `GameState.addChild` 用。`IGameUI` 要求。\n\n### `render`（L163–174）—— 逻辑帧\n\n220→`GameUI.render` 每游戏帧（默认 60）进来，**不受** `GameCtrl._isRenderGame` 影响（`GameState.render` 在 EffectCtrl 之后、主逻辑之前）。菜单暂停 `_isPauseGame` 时 `GameCtrl.render` 提前 return，本函数也不跑。\n\n1. `_fightbar.render()`：HP / 体力 / 计时。\n2. `_qibar1/2.render()`：气、辅助气。\n3. `camera.getZoom()` → `renderPlayerPosUI`。\n4. `_renderEnd` 则 `renderEnd()`（KO 后等击飞落地、切胜者）。\n\n**不**调 `renderQibarPos`。HitsUI 无 per-frame render（靠 MC `gotoAndPlay`）。\n\n### `renderQibarPos`（L176–192）—— 死代码\n230→\n`QI_BAR_MODE != 0` 直接 return。AUTO 且 `zoom < 1.5`：气条 `moveTo(120,60,0.8)` / `(675,60,0.8)`（贴顶缩小）；否则 `moveResume()` 回构造时记下的原位。本包 `render` 从不调用。?\n\n### `renderAnimate`（L194–200）\n\n`GameUI` 按 `ceil(FPS_GAME/30)-1` 抽帧（60fps 隔一帧）。转发 FightBar / 两条 QiBar 的 fad 动画，再 `renderStartAndKO()`。Hits / startKOmc 的 `gotoAndPlay` 走的是 Flash 自己的帧频，不经这里；但 `startKOmc` 被 `gotoAndStop` 后要靠这里 `nextFrame()`。\n\n### `renderStartAndKO`（L202–223）\n\n`_loc2_ = ui.startKOmc`，null 则 return（正常不会）。\n240→\n- 有 `currentFrameLabel`：\n  - `\"stop\"` → return（停在标签，等下次 `gotoAndStop` 切段）。\n  - 含 `\"go:\"` → `gotoAndStop(split(\"go:\")[1])` 后 return（SWF 用标签驱动跳转）。\n- 否则 `nextFrame()`。\n\n`showStart`/`playKO`/`playTimeOver`/`showWinner` 都是 `gotoAndStop` 到段首，之后全靠这条往前爬，爬到脚本帧 `stop()+dispatchEvent(COMPLETE)`。\n\n### `fadIn`（L225–240）\n\n250→`param1` 默认 true = 播 MC 淡入。先 `_fightbar.fadIn(param1)`。\n\n- `QI_BAR_MODE == 1`（TOP）：两条气条 `fadIn(false)`（瞬显）再 `setPosAndScale` 到顶部缩小位。**忽略** `param1`。\n- 否则（AUTO/BOTTOM/默认 0）：气条 `fadIn(param1)`，留在 SWF 原位。\n\n`BITMAP_UI` 时子件自己把动画短路成 `visible=true`。练习 `GameUI.fadIn`、`showStart` 内部、`GameStartCtrl.skip` 都会进。\n\nBOTTOM(2) 与 AUTO 在这条上行为相同（都不改坐标）。\n\n### `fadOut`（L242–247）\n260→\n三条都 `fadOut(param1)`。`GameEndCtrl` 终场 `fadOut(false)`：BITMAP 路径直接藏子件；非 BITMAP 血条 `visible=false`，气条同。KO 中途 `playKO2` / `playTimeOver` 只 fadOut 气条（默认 true）。\n\n### `showHits`（L249–253）\n\n`param1`=连击数，`param2`=team UI id。`==1` 用 `_hits1` 否则 `_hits2`。`FighterEventCtrl`：team.id 1→1、2→2。第一下 hits==1 时事件层就不调这里。\n\n### `hideHits`（L255–259）\n\n`param1` 同样是 team uiID。受击结束 / 倒地 `removeHits` 进来。连打中途不 hide。\n270→\n### `showStart`（L261–288）\n\n闭包：`finishBack`、`params`（**未使用**）、`onFight`、`startComplete`。\n\n1. `fadIn()`（默认带动画）。\n2. `round = gameRunData.round`。\n3. `startKOmc.y = -50`（偏上）。\n4. `$round = round`。SWF 帧 27 把 round clamp 到 1–5 再让 `nummc.gotoAndPlay(\"r\"+round)`。\n5. `gotoAndStop(round < 5 ? \"start\" : \"start_final\")`。第 5 回合（先到 2 胜的 BO3 里少见；生存/组队回合能到 5+）走 FINAL。\n280→6. 听 `\"fight\"` → `onFight` 只 `removeEventListener`。帧 58 派这个，本类不当闸。\n7. 若有 `finishBack`，听 `\"complete\"`（帧 88）再回调。`GameStartCtrl` 用它清 `_uiPlaying`。\n\n`params` 形参对齐 `IGameUI.showStart(Function, Object)`，本实现丢弃。\n\n### `showEnd`（L290–311）\n\n`param1`=完成回调，`param2`=`{winner, loser, drawGame?}`。\n\n1. `_endParam = param2 || {}`，再挂 `finishBack`。\n290→2. `_drawGame = param2 ? param2.drawGame : false`。`param2` 刚被空对象兜底，但这里又用原 `param2`——若调用方传 `null`，`_endParam={}` 而 `_drawGame=false`。`GameEndCtrl` 总传对象。\n3. `_renderEnd=true`，`_playOver=false`。\n4. `gameRunData.isTimerOver` → `playTimeOver()`，否则 `playKO(param2.loser)`（平局 `drawGame` 且超时才走 timeover；非超时平局本包不存在）。\n\n`GameEndCtrl` 同时 `_holdFrame=10*FPS_GAME`，UI 回调把 hold 清 0 以提前结束等待。\n\n### `playKO`（L313–352）\n\n闭包 `playKO2`：`startKOmc.y=0`，`gotoAndStop(\"ko\")`，听 `\"complete\"`→`koBack`，`snd_ko_bs` 或 `snd_ko`，两条气条 `fadOut()`。\n\n300→立即：\n\n1. `_showWinnerDelay=0`。\n2. `EffectCtrl.I.freezeEnabled=false`：挡住 KO 期间的 hit-stop，避免再 `GameCtrl.pause` 套娃。\n3. `_isSlowDown=false`。\n4. 有 `loser`：`doEffectById(\"hit_end\", loser.x, loser.y)`、`shine(0xFFFFFF, 0.5)`、`cameraFocusOne(loser.getDisplay())`（zoom 3.5）。\n5. `GameCtrl.I.pause()`：**顿帧**（`_isRenderGame=false`），不是菜单。镜头/特效/本 UI `render` 仍走。\n6. 扫双方 `currentFighter`：任一方 `actionState==12||13`（必杀/超必）→ `bsKO=true`，`BGEffect(\"kobg\", 2)`。\n7. `shake(5, 0, 1.5)`：X 振幅 5、Y 0、时长 **1.5ms**。`param3<=0` 才会被 `EffectCtrl` 收成 500；1.5 原样用，lose 分母接近 0 → `ceil` 后至少 1，一两拍动画帧就抖完。?\n8. `snd_over_hit`。\n310→9. `setTimeout(playKO2, 500)`：真实 500ms 后才出 KO 大字。顿帧不影响 timeout。\n\n无 loser（? 正常 KO 总有）则没有 hit_end / 特写，仍 pause + shake。\n\n### `koBack`（L354–361）\n\n`freezeEnabled=true`（写了**两遍**），卸 `\"complete\"`，`_playOver=true`，`GameCtrl.I.resume()` 恢复物理。之后 `renderEnd` 才能看击飞。\n\n### `playTimeOver`（L363–370）\n\n320→**不** `pause()`、**不**关 `freezeEnabled`。`startKOmc.y=0`，`gotoAndStop(\"timeover\")`，听 `timeoverBack`，气条 fadOut。超时路径角色仍按逻辑帧落地（`GameCtrl.timeover` 已 `actionEnable=false`）。\n\n### `timeoverBack`（L372–385）\n\n`freezeEnabled=true`（超时路径本来就没关）。卸监听。\n\n- `_drawGame`：`playDrawGame()`，`_showWinnerDelay=0`（**不**置 `_playOver`，`renderEnd` 一直早退，不切胜者）。\n- 否则：`_playOver=true`，`_showWinnerDelay = 1 * FPS_GAME`（约 1 秒后出胜者，**不等** `actionState==30`）。超时败者可能还站着。\n\n### `playDrawGame`（L387–392）\n330→\n`gotoAndStop(\"drawgame\")`，听 `drawGameBack`。\n\n### `drawGameBack`（L394–401）\n\n卸监听。`_endParam.finishBack != null` 才调。不改 `_renderEnd` / `_endParam`（随后 `GameEndCtrl` `clearStartAndEnd`）。\n\n### `renderEnd`（L403–471）—— KO 后逻辑\n\n每逻辑帧。闸：`!_playOver` 或 `!_endParam` return。\n340→\n**已有 delay（`_showWinnerDelay>0`）**：减 1。到 ≤0：\n\n1. `_endParam.winner` 有则 `cameraFocusOne(winner)`、`showWinner(winner)`（无 callback）。\n2. `GameMode.isSingleMode()`（20/21/22）才 `showWins(winner, getWins(winner))`。组队/生存不亮灯。\n3. `_endParam` 仍在则 **直接** `_endParam.finishBack()`——**不**判 null。`GameEndCtrl` 总有 cb。\n4. `_renderEnd=false`，`_endParam=null`。\n5. `return`（即使 delay 刚到 0 也不掉到下面的击飞逻辑）。\n\n**delay==0 且尚未启动**：看 `_endParam.loser`。\n350→\n- `actionState==22`（`HURT_FLYING`）且尚未慢动作：`_isSlowDown=true`，`EffectCtrl.slowDown(2, 0)`（rate 2、时长 0=不自动恢复），记下 `_flyTimer=getTimer()`。\n- `actionState==30`（`DEAD`）：\n  - 若曾经慢动作：飞了不到 2000ms → delay=`2*FPS_GAME`，否则 `1*FPS_GAME`。然后 `slowDownResume()`。\n  - 否则（没经过 22，例如抓死/原地倒）：delay=`2*FPS_GAME`，仍 `slowDownResume()`（没 slow 过也 harmless）。\n\n超时非平局在 `timeoverBack` 已设 delay=1s，本段 loser 逻辑会被 delay 分支抢先，**不再**等 DEAD。KO 路径 delay 一直为 0 直到落地，所以会等 22→30。\n\n败者若永远不到 30（? 死亡动画卡死），`_playOver` 已 true 但 delay 起不来，`GameEndCtrl` 的 10s hold 到期后仍会 `clearStartAndEnd` / 进 win pose——UI 可能没播 winner。?\n\n360→### `clearStartAndEnd`（L473–476）\n\n`startKOmc.gotoAndStop(1)`（SWF 帧 1 `stop` 并复位 `$round=1` 等）。`GameEndCtrl` 在 cinema 收尾调用。不卸还在的 COMPLETE 监听（正常已卸）。\n\n### `pause`（L478–486）\n\n懒 `new PauseDialog()` 并 `ui.addChild`。每次 `show()`：visible、开键、箭头落在 CONTINUE（index 2）。`GameCtrl.pause(true)` 在 intro/outro 期间会推迟到 intro 结束（`_gameStartAndPause`），所以开场 FIGHT 播着时 ESC 先不弹框。\n\n### `resume`（L488–495）\n\n370→无 dialog 则 return。否则 `hide()`（藏、关键、`GameUI.closeConfrim`）。CONTINUE 按钮走 `GameCtrl.resume(true)` → 这里。\n\n### `showWinner`（L497–526）\n\n`startKOmc.y=30`。`teamid = winner.team.id`，无 winner/team 当 1。\n\n- team 1：`$winnerX=30`（左）。\n- team 2：`$winnerX=546`（右）。\n- 其它 team id：不写 `$winnerX`，沿用 SWF 默认 30。\n\n380→`$perfect = winner.hp >= winner.hpMax`。超时残留满血也算 perfect。`gotoAndStop(\"winner\")`。SWF 帧 200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并设 `isPerfect`。\n\n`back` 非 null 才听 `\"complete\"`。`renderEnd` 不传 back——胜者条播完不经这里通知 `GameEndCtrl`（对方靠 10s hold / UI 里 `showEnd` 的 finishBack 已在 delay 归零时调过，**winner MC 可能还在播**）。?\n\n### `renderPlayerPosUI`（L528–554）\n\n`param1`=当前 zoom。\n\n- `zoom > 1.8`：两个标记 `visible=false` 后 return。近景不需要屏外箭头。反编译 `_temp_1` 是连续赋值的临时名。\n- 否则取 `p1FighterGroup.currentFighter` / P2，有则 `getPlayerPos` 写 x/y 并 `visible=true`。\n390→- 某侧 current 为 null（组队换人间隙）不会把该侧 visible 设回 false。?\n\n### `getPlayerPos`（L556–576）\n\n`GameState.getGameSpriteGlobalPosition(sprite, 0, -50)`：屏幕坐标，Y 偏 -50（标在头顶）。公式：`((-scroll.x + x + ox) * zoom, (-scroll.y + y + oy) * zoom)`。\n\n钳制：\n\n- `x < 20` → 20；`x > GAME_SIZE.x-20`（780）→ 780。\n- `y < 60` → 60（避开顶 HUD）。\n400→- `y > GAME_SIZE.y-5`（595）→ **`x = GAME_SIZE.x-5`（795）**。明显笔误，本应改 y。角色飞出屏幕底部时标记会跳到右缘。?\n\n返回同一 `Point` 对象（调用方立刻读 x/y，P1/P2 顺序调用会覆盖，但每侧读完就写进 MC，安全）。\n"}}],"rawOutput":{"type":"ReadFile","FileContent":{"content":"1→# `FightUI` — 战斗 HUD 根（`IGameUI`）\n\n一句话目的：实现 `IGameUI`。从 `ResUtils.fight` 实例化 `ui_fight`，装配顶部血条组、两侧气条、连击数字、开场/KO MC、屏外角色标记和暂停框。`GameUI.initFight` 创建，`GameState` 把它挂在镜头层**外面**（屏幕坐标 800×600）。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightUI.as`（579 行）\n\n## Callers / callees\n\n- **Callers**\n10→  - `GameUI.initFight`：`new FightUI()` + `setVolume(config.soundVolume)` + `initlize(p1Group, p2Group)`。已有 `FightUI` 则复用，不 destory。\n  - `GameUI.render` → `IGameUI.render`；按 30fps 语义再 `renderAnimate`。`GameState.render` 每逻辑帧调 `gameUI.render()`。\n  - `GameUI.fadIn` → `FightUI.fadIn()`（默认 `true`）再 `setVolume`。`GameUI.fadOut` **误调** `fadIn()`，终场不走这条。\n  - `GameStartCtrl`：intro 结束 `showStart(cb)`；skip 且尚未 FIGHT 时 `fadIn(true)`。\n  - `GameEndCtrl`：`showEnd(cb, {winner,loser})` 或 `{drawGame:true}`；结束 `clearStartAndEnd`；KO 路径再 `fadOut(false)`。\n  - `FighterEventCtrl.addHits`：hits>1 才 `showHits(hits, teamUiID)`；`removeHits` → `hideHits(uiID)`。\n  - `GameCtrl.pause(true)` / `resume(true)`：菜单暂停才转到 `FightUI.pause` / `resume`。无参 `pause()`（KO 顿帧）**不**弹暂停框。\n  - `GameCtrl.buildGame` 练习模式：`GameUI.I.fadIn()`（立刻出 HUD，无 ROUND/FIGHT）。\n- **Callees**\n  - 子件：`FightBar`、`QiBar`×2、`HitsUI`×2、`PauseDialog`。\n20→  - `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\"|\"player_pos_p1\"|\"player_pos_p2\")`。\n  - `EffectCtrl`：`freezeEnabled`、`doEffectById(\"hit_end\")`、`shine`、`BGEffect(\"kobg\")`、`shake`、`slowDown`/`slowDownResume`。\n  - `GameCtrl.I`：`pause`/`resume`（无参顿帧）、`gameRunData`、`gameState.cameraFocusOne` / `getGameSpriteGlobalPosition` / `camera.getZoom`。\n  - `SoundCtrl.I.playSwcSound`：`snd_over_hit`、`snd_ko` / `snd_ko_bs`（同包 SWC，无 import）。\n  - `GameEvent`：街机听 `\"SCORE_UPDATE\"`。\n  - `GameMode.isAcrade` / `isSingleMode`；`GameData.I.score`；`GameConfig.GAME_SIZE` / `FPS_GAME`。\n\n## HUD 布局 / SWF\n\n全部来自 `ResUtils.fight`（嵌入 `fight_swf$…`，链接名见 `decompiled/ui/fight/scripts/`）。**不**走 `ResUtils` 常量表。\n30→\n```\nGameState（Istage Sprite）\n├── map.bgLayer\n├── _gameLayer          ← GameCamera 作用对象\n│   ├── mapLayer / _playerLayer / front*\n└── ui_fight            ← FightUI.ui，屏幕空间，不随镜头滚\n    ├── hpbarmc         FightBar：P1 左 / P2 右 / 计时正中\n    │   ├── face1 / face2     FightFaceGroup（3 槽头像）\n    │   ├── bar1 / bar2       FighterHpBar（绿条+红拖尾）\n40→    │   ├── energy1 / energy2 EnergyBar（体力 energy，不是气）\n    │   ├── timemc            FightTimeUI\n    │   ├── win_p1 / win_p2   WinUI 胜场灯\n    │   └── scoremc           FightScoreUI（街机才亮）\n    ├── fzqi1 / fzqi2   QiBar：气 0–300 + 辅助 fzqi + 辅助脸\n    ├── hits1 / hits2   HitsUI：连击数字（屏幕固定位，不跟角色）\n    ├── startKOmc       fight_fla.game_start_mc_44：ROUND/FIGHT/KO/…\n    ├── player_pos_p1/p2 代码 addChild，zoom≤1.8 时标屏外角色\n    └── PauseDialog     代码 addChild，菜单暂停\n```\n50→\nP1 一律左侧（`face1`/`bar1`/`energy1`/`fzqi1`/`hits1`/`win_p1`），P2 右侧并 `setDirect(-1)`。计时在 `hpbarmc.timemc` 水平居中。气条 SWF 默认贴底；`QI_BAR_MODE==TOP` 才会被代码挪到血条附近 `(120,60)` / `(675,60)` scale 0.8。\n\n`startKOmc` 时间轴由 `renderStartAndKO` 按动画帧 `nextFrame()` 推进（`gotoAndStop` 标签后靠代码走帧，不是 `play()`）。\n\n## 命名备注 / 符号对照\n\n- 拼写：`destory`、`initlize`、`fadIn`/`fadOut`、`isAcrade` 全工程如此。\n- `QI_BAR_MODE`：语义对齐 `FightQiBarMode`（0=AUTO / 1=TOP / 2=BOTTOM），但**本包没有任何写入**，始终默认 `0`。`FightQiBarMode` 类本身也没被 import。\n- `renderQibarPos`：按 zoom 把 AUTO 气条挪到顶部或还原——**从未被调用**（`render` 只调 `renderPlayerPosUI`）。AUTO 的动态位移是死代码。?\n60→- `BITMAP_UI`：`GameUI.BITMAP_UI=true` 且本包无写入。血条/气条走位图烘焙路径，MC fadIn 动画基本不播。\n- `showStart` 的 `onFight`：收到 `\"fight\"` 只卸监听，**空体**。真正开操作靠 `\"complete\"` → `GameStartCtrl` 清 `_uiPlaying`。\n- `EffectCtrl.shake(5,0,1.5)`：第三参是**毫秒**。`FighterEffectCtrl.shake` 会 `*1000`，这里直接传 `1.5`，衰减极快（见 `EffectCtrl.md`）。几乎确定是 bug。\n- `getPlayerPos` 下沿钳制写成了 `x = GAME_SIZE.x-5` 而不是 `y`。?\n- `player_pos_*` 用 `getGameSpriteGlobalPosition(..., 0, -50)`。`GameState.md` 把这条写成「hits 数字」不准确——连击是 `hits_mc` 的 SWF 布局坐标，不跟角色。\n- `setTimeout(playKO2, 500)` 是墙钟 500ms，不受 `GameCtrl.pause` / slowDown 影响。\n- `actionState` 直接比数字：12/13=必杀、22=击飞、30=死（`FighterActionState`）。\n- `snd_ko` / `snd_ko_bs` / `snd_over_hit`：main.swf 嵌入 MP3，`SoundCtrl.playSwcSound`。\n\n## 开场 / KO 时间线（`startKOmc`）\n70→\n`fight_fla.game_start_mc_44` 字段：`$round`、`$perfect`、`$winnerX`、`$winnerY`（本类不写 `$winnerY`，SWF 默认 90）。\n\n| 代码 `gotoAndStop` | 条件 | 派发 |\n|---|---|---|\n| `\"start\"` | round < 5 | `\"fight\"`（帧 58）、`\"complete\"`（帧 88） |\n| `\"start_final\"` | round≥5 | 同上结构 |\n| `\"ko\"` | 非超时 KO | `\"complete\"`（帧 190 一带） |\n| `\"timeover\"` | `isTimerOver` | `\"complete\"` |\n| `\"drawgame\"` | 超时且平局 | `\"complete\"` |\n80→| `\"winner\"` | 胜者条 | 子 MC `winnermc` COMPLETE 再向上派 |\n| 帧 1 | `clearStartAndEnd` | `stop` |\n\n`renderStartAndKO`：当前帧标签 `\"stop\"` 则停；标签 `\"go:xxx\"` 则 `gotoAndStop(xxx)`（SWF 内部跳转约定）；否则 `nextFrame()`。\n\n`game_start_mc_44` 其它脚本帧：27/28 按 `$round` 播 `nummc` 的 `\"r1\"..\"r5\"`；55 派 `\"fight_in\"`（本类不听）；58 `\"fight\"`；200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并写 `isPerfect`；210 把 `winnermc` 的 COMPLETE 转发出去。\n\n## `IGameUI` 对照\n\n`decompiled/.../ui/IGameUI.as`。本类全部实现，另多一个 `showWins`（接口没有）。\n90→\n| 接口 | 本类 | 谁调 |\n|---|---|---|\n| `setVolume` | 写 `ui.soundTransform` | `GameUI.initFight` / `fadIn` |\n| `destory` | 拆子件 + `removeChildren` | `GameUI.destory` ← `GameState.destory` |\n| `fadIn(Boolean=true)` | 血条+气条 | `showStart`、`GameUI.fadIn`、`GameStartCtrl.skip` |\n| `fadOut(Boolean=true)` | 同上 | `GameEndCtrl` `getUI().fadOut(false)`；KO 中途只 fadOut 气条 |\n| `getUI` | 返回 `ui_fight` | `GameUI.getUIDisplay` |\n| `render` | 血/气/屏外标/终场 | `GameUI.render` 每逻辑帧 |\n| `renderAnimate` | 淡入淡出 + startKOmc 走帧 | `GameUI` 30fps 语义 |\n100→| `showHits(n, team)` / `hideHits(team)` | HitsUI | `FighterEventCtrl` |\n| `showStart(cb, params)` | ROUND/FIGHT | `GameStartCtrl`（params 丢弃） |\n| `showEnd(cb, obj)` | KO / TIMEOVER / DRAW | `GameEndCtrl` |\n| `clearStartAndEnd` | `gotoAndStop(1)` | `GameEndCtrl` cinema 收尾 |\n| `pause` / `resume` | `PauseDialog` | 仅 `GameCtrl.pause/resume(true)` |\n\n`GameUI.fadOut()` 自己写成 `_ui.fadIn()`，等于废函数。终场不经过它。\n\n## 两种 pause\n\n110→| | `GameCtrl.pause()` | `GameCtrl.pause(true)` |\n|---|---|---|\n| 谁调 | `FightUI.playKO`、`EffectCtrl.freeze` | ESC / 失焦 |\n| `_isRenderGame` | false（物理停） | false |\n| `_isPauseGame` | 不变 | true，整段 `GameCtrl.render` return |\n| `FightUI.pause` | **不调** | 弹 `PauseDialog` |\n| HUD `render` | 仍走（`GameState.render` 在 pause 闸之前？否：`_isPauseGame` 在 EffectCtrl 之前 return，**菜单暂停时 HUD 也停**） | 停 |\n| KO 顿帧 | HUD 仍 render（`_isPauseGame` 仍 false），`renderEnd` / 气条 fadOut 动画靠 `renderAnimate`——但 `GameUI.render` 在 `GameState.render` 里，而 `GameCtrl.render` 顺序是：菜单闸 → EffectCtrl → gameState.render → `_isRenderGame` 闸。无参 pause 只关 `_isRenderGame`，**HUD 继续**。 |\n\n`PauseDialog`：半透明全屏底 + `SetBtnGroup` 三项 GAME TITLE / MOVE LIST / CONTINUE。TITLE 走 `GameUI.confrim(\"BACK TITLE?\",\"返回到主菜单？\")`（拼写 `confrim`）；MOVE LIST 叠 `MoveListSp`；CONTINUE → `GameCtrl.I.resume(true)`。\n120→\n## KO / 超时 cinema 时序\n\n```\nGameEndCtrl.showEnd(cb, {winner, loser} | {drawGame:true})\n        │\n        ├─ isTimerOver\n        │     playTimeOver()                    // 不 pause、不关 freeze\n        │       startKOmc \"timeover\" + 气条 fadOut\n        │       complete → timeoverBack\n130→        │            ├─ drawGame: playDrawGame \"drawgame\" → complete → cb\n        │            └─ 否则 _playOver=true, delay=1s → renderEnd 切胜者 → cb\n        │\n        └─ else playKO(loser)\n              freezeEnabled=false\n              hit_end + shine(白,0.5) + cameraFocusOne(loser)\n              GameCtrl.pause()                  // 顿帧\n              任一方 12/13 → BGEffect(\"kobg\",2) + 稍后 snd_ko_bs\n              shake(5,0,1.5)  + snd_over_hit    // 1.5ms bug\n              500ms 墙钟 → playKO2 \"ko\" + snd_ko + 气条 fadOut\n140→              complete → koBack: freezeEnabled=true, resume(), _playOver=true\n              renderEnd 等 loser 22→slowDown(2,0) → 30→delay 1s/2s\n              delay 到 0: cameraFocusOne(winner) + showWinner\n                         单挑 showWins；直接 cb（winner MC 可能还在播）\n```\n\n`GameEndCtrl` 同时 hold 最多 10s，cb 把 hold 清 0。之后等 `isAllowWinState` 才 `winner.win()`，再 transIn，最后 `clearStartAndEnd` + `fadOut(false)`。\n\n## 逐行说明\n\n150→### 静态 / 实例字段（L27–59）\n\n- `QI_BAR_MODE`：气条贴边策略。未赋值 → 0。\n- `ui`：`ui_fight` 根，公开给 `getUI()` / `GameState.addChild`。\n- `_fightbar`：顶部整条 HUD。\n- `_qibar1` / `_qibar2`：绑 `ui.fzqi1` / `fzqi2`。P2 构造里 `setDirect(-1)`。\n- `_hits1` / `_hits2`：绑 `ui.hits1` / `hits2`。`showHits` 用 team 1/2 选。\n- `_endParam`：`showEnd` 的 `{winner,loser,drawGame,finishBack}`。播完置 null。\n- `_renderEnd`：`render()` 里跑 `renderEnd` 的闸。\n- `_playOver`：KO / TIMEOVER MC 的 `\"complete\"` 之后才 true，开始等击飞落地。\n160→- `_showWinnerDelay`：落地后再等 N 逻辑帧才切胜者镜头。单位=游戏帧。\n- `_drawGame`：超时平局走 `playDrawGame`，不进胜者条。\n- `_isSlowDown`：击飞慢动作只开一次。\n- `_pauseDialog`：懒创建。\n- `_flyTimer`：`getTimer()` 记下进入 `HURT_FLYING` 的墙钟，用来决定胜者 delay 1s 还是 2s。\n- `_p1PosUI` / `_p2PosUI`：`player_pos_p1` / `player_pos_p2`，默认 `visible=false`。\n\n### 构造（L61–83）\n\n1. `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\")` → `ui`。\n170→2. `new FightBar(ui.hpbarmc)`。\n3. `new QiBar(ui.fzqi1)` / `new QiBar(ui.fzqi2)`，P2 `setDirect(-1)`。\n4. `new HitsUI(ui.hits1)` / `new HitsUI(ui.hits2)`。\n5. 再 `createDisplayObject` 两个 `player_pos_*`，隐藏后 `ui.addChild`。\n6. **仅** `GameMode.isAcrade()`（mode 10/20/30）：`trace(\"fightUI.initlize\")`（文案像 init，实际在构造）、`_fightbar.initScore()`、听 `\"SCORE_UPDATE\"`。VS/练习不显示分数。\n\n此时角色还没绑，等 `initlize`。`GameUI` 构造完立刻 `setVolume`。\n\n### `initlize`（L85–91）\n\n180→`param1`=P1 `GameRunFighterGroup`，`param2`=P2。\n\n- `_fightbar.setFighter`：脸/HP/体力。\n- `_qibar1.setFighter(currentFighter, fuzhu)`：气条跟**当前出战**角色，脸用**辅助** `Assister.data`。\n- `_qibar2` 同理。\n- `updateScore(null)`：即使没听事件也刷一次（非街机 `_score` 为 null，空操作）。\n\n`GameState.initFight` 与 `resetFight`（下一回合 / 组队换人）都会再进这里。`GameUI` 复用同一 `FightUI` 实例。\n\n### `setVolume`（L93–98）\n190→\n读 `ui.soundTransform`，改 `volume`，写回。`startKOmc` 里若有时间轴音效走这条。`GameUI.fadIn` 每次都重设为 `config.soundVolume`。\n\n### `showWins`（L100–103）\n\n转发 `_fightbar.showWin(fighter, wins)`。`IGameUI` **没有**这个方法；只有本类 `renderEnd` 在 `isSingleMode` 时自调。组队不亮胜场灯。\n\n### `updateScore`（L105–108）\n\n`GameEvent` `\"SCORE_UPDATE\"` 或 `initlize` 调用。写 `_fightbar.setScore(GameData.I.score)`。`param1` 未用。\n200→\n### `destory`（L110–156）\n\n顺序：\n\n1. `GameEvent.removeEventListener(\"SCORE_UPDATE\", updateScore)`（非街机也 remove，harmless）。\n2. `_pauseDialog.destory()`。\n3. `_fightbar` / `_qibar1` / `_qibar2` / `_hits1` / `_hits2` 各自 `destory` 后置 null。\n4. `ui.removeChildren()` + `ui.stopAllMovieClips()`，catch 后 `trace(e)`。`ui=null`。\n\n210→**不清**：`_p1PosUI`/`_p2PosUI`（随 `removeChildren` 摘掉，不单独 destory）、`_endParam`、终场标志、`QI_BAR_MODE`。`GameState.destory` → `GameUI.destory` 进这里。下一场 `GameUI.initFight` 会 `new FightUI()`（因为 `_ui` 已被 destory 置空？`GameUI.destory` 只调 `_ui.destory()` **不清 `_ui` 引用**——再 `initFight` 时 `_ui` 仍是已掏空的 `FightUI`，`_ui is FightUI` 为真，**不会 new**，只再 `initlize`。`ui` 已 null，后续 `render`/`fadIn` 会 NPE）。?\n\n实际战斗结束走 `goStage` 拆掉整个 `GameState`（连带 `new GameUI()`），这条脏复用只在「同一 `GameState` 上 destory UI 再 initFight」时触发，本包没有这条路径。?\n\n### `getUI`（L158–161）\n\n返回 `ui`。`GameUI.getUIDisplay` / `GameState.addChild` 用。`IGameUI` 要求。\n\n### `render`（L163–174）—— 逻辑帧\n\n220→`GameUI.render` 每游戏帧（默认 60）进来，**不受** `GameCtrl._isRenderGame` 影响（`GameState.render` 在 EffectCtrl 之后、主逻辑之前）。菜单暂停 `_isPauseGame` 时 `GameCtrl.render` 提前 return，本函数也不跑。\n\n1. `_fightbar.render()`：HP / 体力 / 计时。\n2. `_qibar1/2.render()`：气、辅助气。\n3. `camera.getZoom()` → `renderPlayerPosUI`。\n4. `_renderEnd` 则 `renderEnd()`（KO 后等击飞落地、切胜者）。\n\n**不**调 `renderQibarPos`。HitsUI 无 per-frame render（靠 MC `gotoAndPlay`）。\n\n### `renderQibarPos`（L176–192）—— 死代码\n230→\n`QI_BAR_MODE != 0` 直接 return。AUTO 且 `zoom < 1.5`：气条 `moveTo(120,60,0.8)` / `(675,60,0.8)`（贴顶缩小）；否则 `moveResume()` 回构造时记下的原位。本包 `render` 从不调用。?\n\n### `renderAnimate`（L194–200）\n\n`GameUI` 按 `ceil(FPS_GAME/30)-1` 抽帧（60fps 隔一帧）。转发 FightBar / 两条 QiBar 的 fad 动画，再 `renderStartAndKO()`。Hits / startKOmc 的 `gotoAndPlay` 走的是 Flash 自己的帧频，不经这里；但 `startKOmc` 被 `gotoAndStop` 后要靠这里 `nextFrame()`。\n\n### `renderStartAndKO`（L202–223）\n\n`_loc2_ = ui.startKOmc`，null 则 return（正常不会）。\n240→\n- 有 `currentFrameLabel`：\n  - `\"stop\"` → return（停在标签，等下次 `gotoAndStop` 切段）。\n  - 含 `\"go:\"` → `gotoAndStop(split(\"go:\")[1])` 后 return（SWF 用标签驱动跳转）。\n- 否则 `nextFrame()`。\n\n`showStart`/`playKO`/`playTimeOver`/`showWinner` 都是 `gotoAndStop` 到段首，之后全靠这条往前爬，爬到脚本帧 `stop()+dispatchEvent(COMPLETE)`。\n\n### `fadIn`（L225–240）\n\n250→`param1` 默认 true = 播 MC 淡入。先 `_fightbar.fadIn(param1)`。\n\n- `QI_BAR_MODE == 1`（TOP）：两条气条 `fadIn(false)`（瞬显）再 `setPosAndScale` 到顶部缩小位。**忽略** `param1`。\n- 否则（AUTO/BOTTOM/默认 0）：气条 `fadIn(param1)`，留在 SWF 原位。\n\n`BITMAP_UI` 时子件自己把动画短路成 `visible=true`。练习 `GameUI.fadIn`、`showStart` 内部、`GameStartCtrl.skip` 都会进。\n\nBOTTOM(2) 与 AUTO 在这条上行为相同（都不改坐标）。\n\n### `fadOut`（L242–247）\n260→\n三条都 `fadOut(param1)`。`GameEndCtrl` 终场 `fadOut(false)`：BITMAP 路径直接藏子件；非 BITMAP 血条 `visible=false`，气条同。KO 中途 `playKO2` / `playTimeOver` 只 fadOut 气条（默认 true）。\n\n### `showHits`（L249–253）\n\n`param1`=连击数，`param2`=team UI id。`==1` 用 `_hits1` 否则 `_hits2`。`FighterEventCtrl`：team.id 1→1、2→2。第一下 hits==1 时事件层就不调这里。\n\n### `hideHits`（L255–259）\n\n`param1` 同样是 team uiID。受击结束 / 倒地 `removeHits` 进来。连打中途不 hide。\n270→\n### `showStart`（L261–288）\n\n闭包：`finishBack`、`params`（**未使用**）、`onFight`、`startComplete`。\n\n1. `fadIn()`（默认带动画）。\n2. `round = gameRunData.round`。\n3. `startKOmc.y = -50`（偏上）。\n4. `$round = round`。SWF 帧 27 把 round clamp 到 1–5 再让 `nummc.gotoAndPlay(\"r\"+round)`。\n5. `gotoAndStop(round < 5 ? \"start\" : \"start_final\")`。第 5 回合（先到 2 胜的 BO3 里少见；生存/组队回合能到 5+）走 FINAL。\n280→6. 听 `\"fight\"` → `onFight` 只 `removeEventListener`。帧 58 派这个，本类不当闸。\n7. 若有 `finishBack`，听 `\"complete\"`（帧 88）再回调。`GameStartCtrl` 用它清 `_uiPlaying`。\n\n`params` 形参对齐 `IGameUI.showStart(Function, Object)`，本实现丢弃。\n\n### `showEnd`（L290–311）\n\n`param1`=完成回调，`param2`=`{winner, loser, drawGame?}`。\n\n1. `_endParam = param2 || {}`，再挂 `finishBack`。\n290→2. `_drawGame = param2 ? param2.drawGame : false`。`param2` 刚被空对象兜底，但这里又用原 `param2`——若调用方传 `null`，`_endParam={}` 而 `_drawGame=false`。`GameEndCtrl` 总传对象。\n3. `_renderEnd=true`，`_playOver=false`。\n4. `gameRunData.isTimerOver` → `playTimeOver()`，否则 `playKO(param2.loser)`（平局 `drawGame` 且超时才走 timeover；非超时平局本包不存在）。\n\n`GameEndCtrl` 同时 `_holdFrame=10*FPS_GAME`，UI 回调把 hold 清 0 以提前结束等待。\n\n### `playKO`（L313–352）\n\n闭包 `playKO2`：`startKOmc.y=0`，`gotoAndStop(\"ko\")`，听 `\"complete\"`→`koBack`，`snd_ko_bs` 或 `snd_ko`，两条气条 `fadOut()`。\n\n300→立即：\n\n1. `_showWinnerDelay=0`。\n2. `EffectCtrl.I.freezeEnabled=false`：挡住 KO 期间的 hit-stop，避免再 `GameCtrl.pause` 套娃。\n3. `_isSlowDown=false`。\n4. 有 `loser`：`doEffectById(\"hit_end\", loser.x, loser.y)`、`shine(0xFFFFFF, 0.5)`、`cameraFocusOne(loser.getDisplay())`（zoom 3.5）。\n5. `GameCtrl.I.pause()`：**顿帧**（`_isRenderGame=false`），不是菜单。镜头/特效/本 UI `render` 仍走。\n6. 扫双方 `currentFighter`：任一方 `actionState==12||13`（必杀/超必）→ `bsKO=true`，`BGEffect(\"kobg\", 2)`。\n7. `shake(5, 0, 1.5)`：X 振幅 5、Y 0、时长 **1.5ms**。`param3<=0` 才会被 `EffectCtrl` 收成 500；1.5 原样用，lose 分母接近 0 → `ceil` 后至少 1，一两拍动画帧就抖完。?\n8. `snd_over_hit`。\n310→9. `setTimeout(playKO2, 500)`：真实 500ms 后才出 KO 大字。顿帧不影响 timeout。\n\n无 loser（? 正常 KO 总有）则没有 hit_end / 特写，仍 pause + shake。\n\n### `koBack`（L354–361）\n\n`freezeEnabled=true`（写了**两遍**），卸 `\"complete\"`，`_playOver=true`，`GameCtrl.I.resume()` 恢复物理。之后 `renderEnd` 才能看击飞。\n\n### `playTimeOver`（L363–370）\n\n320→**不** `pause()`、**不**关 `freezeEnabled`。`startKOmc.y=0`，`gotoAndStop(\"timeover\")`，听 `timeoverBack`，气条 fadOut。超时路径角色仍按逻辑帧落地（`GameCtrl.timeover` 已 `actionEnable=false`）。\n\n### `timeoverBack`（L372–385）\n\n`freezeEnabled=true`（超时路径本来就没关）。卸监听。\n\n- `_drawGame`：`playDrawGame()`，`_showWinnerDelay=0`（**不**置 `_playOver`，`renderEnd` 一直早退，不切胜者）。\n- 否则：`_playOver=true`，`_showWinnerDelay = 1 * FPS_GAME`（约 1 秒后出胜者，**不等** `actionState==30`）。超时败者可能还站着。\n\n### `playDrawGame`（L387–392）\n330→\n`gotoAndStop(\"drawgame\")`，听 `drawGameBack`。\n\n### `drawGameBack`（L394–401）\n\n卸监听。`_endParam.finishBack != null` 才调。不改 `_renderEnd` / `_endParam`（随后 `GameEndCtrl` `clearStartAndEnd`）。\n\n### `renderEnd`（L403–471）—— KO 后逻辑\n\n每逻辑帧。闸：`!_playOver` 或 `!_endParam` return。\n340→\n**已有 delay（`_showWinnerDelay>0`）**：减 1。到 ≤0：\n\n1. `_endParam.winner` 有则 `cameraFocusOne(winner)`、`showWinner(winner)`（无 callback）。\n2. `GameMode.isSingleMode()`（20/21/22）才 `showWins(winner, getWins(winner))`。组队/生存不亮灯。\n3. `_endParam` 仍在则 **直接** `_endParam.finishBack()`——**不**判 null。`GameEndCtrl` 总有 cb。\n4. `_renderEnd=false`，`_endParam=null`。\n5. `return`（即使 delay 刚到 0 也不掉到下面的击飞逻辑）。\n\n**delay==0 且尚未启动**：看 `_endParam.loser`。\n350→\n- `actionState==22`（`HURT_FLYING`）且尚未慢动作：`_isSlowDown=true`，`EffectCtrl.slowDown(2, 0)`（rate 2、时长 0=不自动恢复），记下 `_flyTimer=getTimer()`。\n- `actionState==30`（`DEAD`）：\n  - 若曾经慢动作：飞了不到 2000ms → delay=`2*FPS_GAME`，否则 `1*FPS_GAME`。然后 `slowDownResume()`。\n  - 否则（没经过 22，例如抓死/原地倒）：delay=`2*FPS_GAME`，仍 `slowDownResume()`（没 slow 过也 harmless）。\n\n超时非平局在 `timeoverBack` 已设 delay=1s，本段 loser 逻辑会被 delay 分支抢先，**不再**等 DEAD。KO 路径 delay 一直为 0 直到落地，所以会等 22→30。\n\n败者若永远不到 30（? 死亡动画卡死），`_playOver` 已 true 但 delay 起不来，`GameEndCtrl` 的 10s hold 到期后仍会 `clearStartAndEnd` / 进 win pose——UI 可能没播 winner。?\n\n360→### `clearStartAndEnd`（L473–476）\n\n`startKOmc.gotoAndStop(1)`（SWF 帧 1 `stop` 并复位 `$round=1` 等）。`GameEndCtrl` 在 cinema 收尾调用。不卸还在的 COMPLETE 监听（正常已卸）。\n\n### `pause`（L478–486）\n\n懒 `new PauseDialog()` 并 `ui.addChild`。每次 `show()`：visible、开键、箭头落在 CONTINUE（index 2）。`GameCtrl.pause(true)` 在 intro/outro 期间会推迟到 intro 结束（`_gameStartAndPause`），所以开场 FIGHT 播着时 ESC 先不弹框。\n\n### `resume`（L488–495）\n\n370→无 dialog 则 return。否则 `hide()`（藏、关键、`GameUI.closeConfrim`）。CONTINUE 按钮走 `GameCtrl.resume(true)` → 这里。\n\n### `showWinner`（L497–526）\n\n`startKOmc.y=30`。`teamid = winner.team.id`，无 winner/team 当 1。\n\n- team 1：`$winnerX=30`（左）。\n- team 2：`$winnerX=546`（右）。\n- 其它 team id：不写 `$winnerX`，沿用 SWF 默认 30。\n\n380→`$perfect = winner.hp >= winner.hpMax`。超时残留满血也算 perfect。`gotoAndStop(\"winner\")`。SWF 帧 200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并设 `isPerfect`。\n\n`back` 非 null 才听 `\"complete\"`。`renderEnd` 不传 back——胜者条播完不经这里通知 `GameEndCtrl`（对方靠 10s hold / UI 里 `showEnd` 的 finishBack 已在 delay 归零时调过，**winner MC 可能还在播**）。?\n\n### `renderPlayerPosUI`（L528–554）\n\n`param1`=当前 zoom。\n\n- `zoom > 1.8`：两个标记 `visible=false` 后 return。近景不需要屏外箭头。反编译 `_temp_1` 是连续赋值的临时名。\n- 否则取 `p1FighterGroup.currentFighter` / P2，有则 `getPlayerPos` 写 x/y 并 `visible=true`。\n390→- 某侧 current 为 null（组队换人间隙）不会把该侧 visible 设回 false。?\n\n### `getPlayerPos`（L556–576）\n\n`GameState.getGameSpriteGlobalPosition(sprite, 0, -50)`：屏幕坐标，Y 偏 -50（标在头顶）。公式：`((-scroll.x + x + ox) * zoom, (-scroll.y + y + oy) * zoom)`。\n\n钳制：\n\n- `x < 20` → 20；`x > GAME_SIZE.x-20`（780）→ 780。\n- `y < 60` → 60（避开顶 HUD）。\n400→- `y > GAME_SIZE.y-5`（595）→ **`x = GAME_SIZE.x-5`（795）**。明显笔误，本应改 y。角色飞出屏幕底部时标记会跳到右缘。?\n\n返回同一 `Point` 对象（调用方立刻读 x/y，P1/P2 顺序调用会覆盖，但每侧读完就写进 MC，安全）。\n","content_concise":"1→# `FightUI` — 战斗 HUD 根（`IGameUI`）\n\n一句话目的：实现 `IGameUI`。从 `ResUtils.fight` 实例化 `ui_fight`，装配顶部血条组、两侧气条、连击数字、开场/KO MC、屏外角色标记和暂停框。`GameUI.initFight` 创建，`GameState` 把它挂在镜头层**外面**（屏幕坐标 800×600）。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightUI.as`（579 行）\n\n## Callers / callees\n\n- **Callers**\n10→  - `GameUI.initFight`：`new FightUI()` + `setVolume(config.soundVolume)` + `initlize(p1Group, p2Group)`。已有 `FightUI` 则复用，不 destory。\n  - `GameUI.render` → `IGameUI.render`；按 30fps 语义再 `renderAnimate`。`GameState.render` 每逻辑帧调 `gameUI.render()`。\n  - `GameUI.fadIn` → `FightUI.fadIn()`（默认 `true`）再 `setVolume`。`GameUI.fadOut` **误调** `fadIn()`，终场不走这条。\n  - `GameStartCtrl`：intro 结束 `showStart(cb)`；skip 且尚未 FIGHT 时 `fadIn(true)`。\n  - `GameEndCtrl`：`showEnd(cb, {winner,loser})` 或 `{drawGame:true}`；结束 `clearStartAndEnd`；KO 路径再 `fadOut(false)`。\n  - `FighterEventCtrl.addHits`：hits>1 才 `showHits(hits, teamUiID)`；`removeHits` → `hideHits(uiID)`。\n  - `GameCtrl.pause(true)` / `resume(true)`：菜单暂停才转到 `FightUI.pause` / `resume`。无参 `pause()`（KO 顿帧）**不**弹暂停框。\n  - `GameCtrl.buildGame` 练习模式：`GameUI.I.fadIn()`（立刻出 HUD，无 ROUND/FIGHT）。\n- **Callees**\n  - 子件：`FightBar`、`QiBar`×2、`HitsUI`×2、`PauseDialog`。\n20→  - `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\"|\"player_pos_p1\"|\"player_pos_p2\")`。\n  - `EffectCtrl`：`freezeEnabled`、`doEffectById(\"hit_end\")`、`shine`、`BGEffect(\"kobg\")`、`shake`、`slowDown`/`slowDownResume`。\n  - `GameCtrl.I`：`pause`/`resume`（无参顿帧）、`gameRunData`、`gameState.cameraFocusOne` / `getGameSpriteGlobalPosition` / `camera.getZoom`。\n  - `SoundCtrl.I.playSwcSound`：`snd_over_hit`、`snd_ko` / `snd_ko_bs`（同包 SWC，无 import）。\n  - `GameEvent`：街机听 `\"SCORE_UPDATE\"`。\n  - `GameMode.isAcrade` / `isSingleMode`；`GameData.I.score`；`GameConfig.GAME_SIZE` / `FPS_GAME`。\n\n## HUD 布局 / SWF\n\n全部来自 `ResUtils.fight`（嵌入 `fight_swf$…`，链接名见 `decompiled/ui/fight/scripts/`）。**不**走 `ResUtils` 常量表。\n30→\n```\nGameState（Istage Sprite）\n├── map.bgLayer\n├── _gameLayer          ← GameCamera 作用对象\n│   ├── mapLayer / _playerLayer / front*\n└── ui_fight            ← FightUI.ui，屏幕空间，不随镜头滚\n    ├── hpbarmc         FightBar：P1 左 / P2 右 / 计时正中\n    │   ├── face1 / face2     FightFaceGroup（3 槽头像）\n    │   ├── bar1 / bar2       FighterHpBar（绿条+红拖尾）\n40→    │   ├── energy1 / energy2 EnergyBar（体力 energy，不是气）\n    │   ├── timemc            FightTimeUI\n    │   ├── win_p1 / win_p2   WinUI 胜场灯\n    │   └── scoremc           FightScoreUI（街机才亮）\n    ├── fzqi1 / fzqi2   QiBar：气 0–300 + 辅助 fzqi + 辅助脸\n    ├── hits1 / hits2   HitsUI：连击数字（屏幕固定位，不跟角色）\n    ├── startKOmc       fight_fla.game_start_mc_44：ROUND/FIGHT/KO/…\n    ├── player_pos_p1/p2 代码 addChild，zoom≤1.8 时标屏外角色\n    └── PauseDialog     代码 addChild，菜单暂停\n```\n50→\nP1 一律左侧（`face1`/`bar1`/`energy1`/`fzqi1`/`hits1`/`win_p1`），P2 右侧并 `setDirect(-1)`。计时在 `hpbarmc.timemc` 水平居中。气条 SWF 默认贴底；`QI_BAR_MODE==TOP` 才会被代码挪到血条附近 `(120,60)` / `(675,60)` scale 0.8。\n\n`startKOmc` 时间轴由 `renderStartAndKO` 按动画帧 `nextFrame()` 推进（`gotoAndStop` 标签后靠代码走帧，不是 `play()`）。\n\n## 命名备注 / 符号对照\n\n- 拼写：`destory`、`initlize`、`fadIn`/`fadOut`、`isAcrade` 全工程如此。\n- `QI_BAR_MODE`：语义对齐 `FightQiBarMode`（0=AUTO / 1=TOP / 2=BOTTOM），但**本包没有任何写入**，始终默认 `0`。`FightQiBarMode` 类本身也没被 import。\n- `renderQibarPos`：按 zoom 把 AUTO 气条挪到顶部或还原——**从未被调用**（`render` 只调 `renderPlayerPosUI`）。AUTO 的动态位移是死代码。?\n60→- `BITMAP_UI`：`GameUI.BITMAP_UI=true` 且本包无写入。血条/气条走位图烘焙路径，MC fadIn 动画基本不播。\n- `showStart` 的 `onFight`：收到 `\"fight\"` 只卸监听，**空体**。真正开操作靠 `\"complete\"` → `GameStartCtrl` 清 `_uiPlaying`。\n- `EffectCtrl.shake(5,0,1.5)`：第三参是**毫秒**。`FighterEffectCtrl.shake` 会 `*1000`，这里直接传 `1.5`，衰减极快（见 `EffectCtrl.md`）。几乎确定是 bug。\n- `getPlayerPos` 下沿钳制写成了 `x = GAME_SIZE.x-5` 而不是 `y`。?\n- `player_pos_*` 用 `getGameSpriteGlobalPosition(..., 0, -50)`。`GameState.md` 把这条写成「hits 数字」不准确——连击是 `hits_mc` 的 SWF 布局坐标，不跟角色。\n- `setTimeout(playKO2, 500)` 是墙钟 500ms，不受 `GameCtrl.pause` / slowDown 影响。\n- `actionState` 直接比数字：12/13=必杀、22=击飞、30=死（`FighterActionState`）。\n- `snd_ko` / `snd_ko_bs` / `snd_over_hit`：main.swf 嵌入 MP3，`SoundCtrl.playSwcSound`。\n\n## 开场 / KO 时间线（`startKOmc`）\n70→\n`fight_fla.game_start_mc_44` 字段：`$round`、`$perfect`、`$winnerX`、`$winnerY`（本类不写 `$winnerY`，SWF 默认 90）。\n\n| 代码 `gotoAndStop` | 条件 | 派发 |\n|---|---|---|\n| `\"start\"` | round < 5 | `\"fight\"`（帧 58）、`\"complete\"`（帧 88） |\n| `\"start_final\"` | round≥5 | 同上结构 |\n| `\"ko\"` | 非超时 KO | `\"complete\"`（帧 190 一带） |\n| `\"timeover\"` | `isTimerOver` | `\"complete\"` |\n| `\"drawgame\"` | 超时且平局 | `\"complete\"` |\n80→| `\"winner\"` | 胜者条 | 子 MC `winnermc` COMPLETE 再向上派 |\n| 帧 1 | `clearStartAndEnd` | `stop` |\n\n`renderStartAndKO`：当前帧标签 `\"stop\"` 则停；标签 `\"go:xxx\"` 则 `gotoAndStop(xxx)`（SWF 内部跳转约定）；否则 `nextFrame()`。\n\n`game_start_mc_44` 其它脚本帧：27/28 按 `$round` 播 `nummc` 的 `\"r1\"..\"r5\"`；55 派 `\"fight_in\"`（本类不听）；58 `\"fight\"`；200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并写 `isPerfect`；210 把 `winnermc` 的 COMPLETE 转发出去。\n\n## `IGameUI` 对照\n\n`decompiled/.../ui/IGameUI.as`。本类全部实现，另多一个 `showWins`（接口没有）。\n90→\n| 接口 | 本类 | 谁调 |\n|---|---|---|\n| `setVolume` | 写 `ui.soundTransform` | `GameUI.initFight` / `fadIn` |\n| `destory` | 拆子件 + `removeChildren` | `GameUI.destory` ← `GameState.destory` |\n| `fadIn(Boolean=true)` | 血条+气条 | `showStart`、`GameUI.fadIn`、`GameStartCtrl.skip` |\n| `fadOut(Boolean=true)` | 同上 | `GameEndCtrl` `getUI().fadOut(false)`；KO 中途只 fadOut 气条 |\n| `getUI` | 返回 `ui_fight` | `GameUI.getUIDisplay` |\n| `render` | 血/气/屏外标/终场 | `GameUI.render` 每逻辑帧 |\n| `renderAnimate` | 淡入淡出 + startKOmc 走帧 | `GameUI` 30fps 语义 |\n100→| `showHits(n, team)` / `hideHits(team)` | HitsUI | `FighterEventCtrl` |\n| `showStart(cb, params)` | ROUND/FIGHT | `GameStartCtrl`（params 丢弃） |\n| `showEnd(cb, obj)` | KO / TIMEOVER / DRAW | `GameEndCtrl` |\n| `clearStartAndEnd` | `gotoAndStop(1)` | `GameEndCtrl` cinema 收尾 |\n| `pause` / `resume` | `PauseDialog` | 仅 `GameCtrl.pause/resume(true)` |\n\n`GameUI.fadOut()` 自己写成 `_ui.fadIn()`，等于废函数。终场不经过它。\n\n## 两种 pause\n\n110→| | `GameCtrl.pause()` | `GameCtrl.pause(true)` |\n|---|---|---|\n| 谁调 | `FightUI.playKO`、`EffectCtrl.freeze` | ESC / 失焦 |\n| `_isRenderGame` | false（物理停） | false |\n| `_isPauseGame` | 不变 | true，整段 `GameCtrl.render` return |\n| `FightUI.pause` | **不调** | 弹 `PauseDialog` |\n| HUD `render` | 仍走（`GameState.render` 在 pause 闸之前？否：`_isPauseGame` 在 EffectCtrl 之前 return，**菜单暂停时 HUD 也停**） | 停 |\n| KO 顿帧 | HUD 仍 render（`_isPauseGame` 仍 false），`renderEnd` / 气条 fadOut 动画靠 `renderAnimate`——但 `GameUI.render` 在 `GameState.render` 里，而 `GameCtrl.render` 顺序是：菜单闸 → EffectCtrl → gameState.render → `_isRenderGame` 闸。无参 pause 只关 `_isRenderGame`，**HUD 继续**。 |\n\n`PauseDialog`：半透明全屏底 + `SetBtnGroup` 三项 GAME TITLE / MOVE LIST / CONTINUE。TITLE 走 `GameUI.confrim(\"BACK TITLE?\",\"返回到主菜单？\")`（拼写 `confrim`）；MOVE LIST 叠 `MoveListSp`；CONTINUE → `GameCtrl.I.resume(true)`。\n120→\n## KO / 超时 cinema 时序\n\n```\nGameEndCtrl.showEnd(cb, {winner, loser} | {drawGame:true})\n        │\n        ├─ isTimerOver\n        │     playTimeOver()                    // 不 pause、不关 freeze\n        │       startKOmc \"timeover\" + 气条 fadOut\n        │       complete → timeoverBack\n130→        │            ├─ drawGame: playDrawGame \"drawgame\" → complete → cb\n        │            └─ 否则 _playOver=true, delay=1s → renderEnd 切胜者 → cb\n        │\n        └─ else playKO(loser)\n              freezeEnabled=false\n              hit_end + shine(白,0.5) + cameraFocusOne(loser)\n              GameCtrl.pause()                  // 顿帧\n              任一方 12/13 → BGEffect(\"kobg\",2) + 稍后 snd_ko_bs\n              shake(5,0,1.5)  + snd_over_hit    // 1.5ms bug\n              500ms 墙钟 → playKO2 \"ko\" + snd_ko + 气条 fadOut\n140→              complete → koBack: freezeEnabled=true, resume(), _playOver=true\n              renderEnd 等 loser 22→slowDown(2,0) → 30→delay 1s/2s\n              delay 到 0: cameraFocusOne(winner) + showWinner\n                         单挑 showWins；直接 cb（winner MC 可能还在播）\n```\n\n`GameEndCtrl` 同时 hold 最多 10s，cb 把 hold 清 0。之后等 `isAllowWinState` 才 `winner.win()`，再 transIn，最后 `clearStartAndEnd` + `fadOut(false)`。\n\n## 逐行说明\n\n150→### 静态 / 实例字段（L27–59）\n\n- `QI_BAR_MODE`：气条贴边策略。未赋值 → 0。\n- `ui`：`ui_fight` 根，公开给 `getUI()` / `GameState.addChild`。\n- `_fightbar`：顶部整条 HUD。\n- `_qibar1` / `_qibar2`：绑 `ui.fzqi1` / `fzqi2`。P2 构造里 `setDirect(-1)`。\n- `_hits1` / `_hits2`：绑 `ui.hits1` / `hits2`。`showHits` 用 team 1/2 选。\n- `_endParam`：`showEnd` 的 `{winner,loser,drawGame,finishBack}`。播完置 null。\n- `_renderEnd`：`render()` 里跑 `renderEnd` 的闸。\n- `_playOver`：KO / TIMEOVER MC 的 `\"complete\"` 之后才 true，开始等击飞落地。\n160→- `_showWinnerDelay`：落地后再等 N 逻辑帧才切胜者镜头。单位=游戏帧。\n- `_drawGame`：超时平局走 `playDrawGame`，不进胜者条。\n- `_isSlowDown`：击飞慢动作只开一次。\n- `_pauseDialog`：懒创建。\n- `_flyTimer`：`getTimer()` 记下进入 `HURT_FLYING` 的墙钟，用来决定胜者 delay 1s 还是 2s。\n- `_p1PosUI` / `_p2PosUI`：`player_pos_p1` / `player_pos_p2`，默认 `visible=false`。\n\n### 构造（L61–83）\n\n1. `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\")` → `ui`。\n170→2. `new FightBar(ui.hpbarmc)`。\n3. `new QiBar(ui.fzqi1)` / `new QiBar(ui.fzqi2)`，P2 `setDirect(-1)`。\n4. `new HitsUI(ui.hits1)` / `new HitsUI(ui.hits2)`。\n5. 再 `createDisplayObject` 两个 `player_pos_*`，隐藏后 `ui.addChild`。\n6. **仅** `GameMode.isAcrade()`（mode 10/20/30）：`trace(\"fightUI.initlize\")`（文案像 init，实际在构造）、`_fightbar.initScore()`、听 `\"SCORE_UPDATE\"`。VS/练习不显示分数。\n\n此时角色还没绑，等 `initlize`。`GameUI` 构造完立刻 `setVolume`。\n\n### `initlize`（L85–91）\n\n180→`param1`=P1 `GameRunFighterGroup`，`param2`=P2。\n\n- `_fightbar.setFighter`：脸/HP/体力。\n- `_qibar1.setFighter(currentFighter, fuzhu)`：气条跟**当前出战**角色，脸用**辅助** `Assister.data`。\n- `_qibar2` 同理。\n- `updateScore(null)`：即使没听事件也刷一次（非街机 `_score` 为 null，空操作）。\n\n`GameState.initFight` 与 `resetFight`（下一回合 / 组队换人）都会再进这里。`GameUI` 复用同一 `FightUI` 实例。\n\n### `setVolume`（L93–98）\n190→\n读 `ui.soundTransform`，改 `volume`，写回。`startKOmc` 里若有时间轴音效走这条。`GameUI.fadIn` 每次都重设为 `config.soundVolume`。\n\n### `showWins`（L100–103）\n\n转发 `_fightbar.showWin(fighter, wins)`。`IGameUI` **没有**这个方法；只有本类 `renderEnd` 在 `isSingleMode` 时自调。组队不亮胜场灯。\n\n### `updateScore`（L105–108）\n\n`GameEvent` `\"SCORE_UPDATE\"` 或 `initlize` 调用。写 `_fightbar.setScore(GameData.I.score)`。`param1` 未用。\n200→\n### `destory`（L110–156）\n\n顺序：\n\n1. `GameEvent.removeEventListener(\"SCORE_UPDATE\", updateScore)`（非街机也 remove，harmless）。\n2. `_pauseDialog.destory()`。\n3. `_fightbar` / `_qibar1` / `_qibar2` / `_hits1` / `_hits2` 各自 `destory` 后置 null。\n4. `ui.removeChildren()` + `ui.stopAllMovieClips()`，catch 后 `trace(e)`。`ui=null`。\n\n210→**不清**：`_p1PosUI`/`_p2PosUI`（随 `removeChildren` 摘掉，不单独 destory）、`_endParam`、终场标志、`QI_BAR_MODE`。`GameState.destory` → `GameUI.destory` 进这里。下一场 `GameUI.initFight` 会 `new FightUI()`（因为 `_ui` 已被 destory 置空？`GameUI.destory` 只调 `_ui.destory()` **不清 `_ui` 引用**——再 `initFight` 时 `_ui` 仍是已掏空的 `FightUI`，`_ui is FightUI` 为真，**不会 new**，只再 `initlize`。`ui` 已 null，后续 `render`/`fadIn` 会 NPE）。?\n\n实际战斗结束走 `goStage` 拆掉整个 `GameState`（连带 `new GameUI()`），这条脏复用只在「同一 `GameState` 上 destory UI 再 initFight」时触发，本包没有这条路径。?\n\n### `getUI`（L158–161）\n\n返回 `ui`。`GameUI.getUIDisplay` / `GameState.addChild` 用。`IGameUI` 要求。\n\n### `render`（L163–174）—— 逻辑帧\n\n220→`GameUI.render` 每游戏帧（默认 60）进来，**不受** `GameCtrl._isRenderGame` 影响（`GameState.render` 在 EffectCtrl 之后、主逻辑之前）。菜单暂停 `_isPauseGame` 时 `GameCtrl.render` 提前 return，本函数也不跑。\n\n1. `_fightbar.render()`：HP / 体力 / 计时。\n2. `_qibar1/2.render()`：气、辅助气。\n3. `camera.getZoom()` → `renderPlayerPosUI`。\n4. `_renderEnd` 则 `renderEnd()`（KO 后等击飞落地、切胜者）。\n\n**不**调 `renderQibarPos`。HitsUI 无 per-frame render（靠 MC `gotoAndPlay`）。\n\n### `renderQibarPos`（L176–192）—— 死代码\n230→\n`QI_BAR_MODE != 0` 直接 return。AUTO 且 `zoom < 1.5`：气条 `moveTo(120,60,0.8)` / `(675,60,0.8)`（贴顶缩小）；否则 `moveResume()` 回构造时记下的原位。本包 `render` 从不调用。?\n\n### `renderAnimate`（L194–200）\n\n`GameUI` 按 `ceil(FPS_GAME/30)-1` 抽帧（60fps 隔一帧）。转发 FightBar / 两条 QiBar 的 fad 动画，再 `renderStartAndKO()`。Hits / startKOmc 的 `gotoAndPlay` 走的是 Flash 自己的帧频，不经这里；但 `startKOmc` 被 `gotoAndStop` 后要靠这里 `nextFrame()`。\n\n### `renderStartAndKO`（L202–223）\n\n`_loc2_ = ui.startKOmc`，null 则 return（正常不会）。\n240→\n- 有 `currentFrameLabel`：\n  - `\"stop\"` → return（停在标签，等下次 `gotoAndStop` 切段）。\n  - 含 `\"go:\"` → `gotoAndStop(split(\"go:\")[1])` 后 return（SWF 用标签驱动跳转）。\n- 否则 `nextFrame()`。\n\n`showStart`/`playKO`/`playTimeOver`/`showWinner` 都是 `gotoAndStop` 到段首，之后全靠这条往前爬，爬到脚本帧 `stop()+dispatchEvent(COMPLETE)`。\n\n### `fadIn`（L225–240）\n\n250→`param1` 默认 true = 播 MC 淡入。先 `_fightbar.fadIn(param1)`。\n\n- `QI_BAR_MODE == 1`（TOP）：两条气条 `fadIn(false)`（瞬显）再 `setPosAndScale` 到顶部缩小位。**忽略** `param1`。\n- 否则（AUTO/BOTTOM/默认 0）：气条 `fadIn(param1)`，留在 SWF 原位。\n\n`BITMAP_UI` 时子件自己把动画短路成 `visible=true`。练习 `GameUI.fadIn`、`showStart` 内部、`GameStartCtrl.skip` 都会进。\n\nBOTTOM(2) 与 AUTO 在这条上行为相同（都不改坐标）。\n\n### `fadOut`（L242–247）\n260→\n三条都 `fadOut(param1)`。`GameEndCtrl` 终场 `fadOut(false)`：BITMAP 路径直接藏子件；非 BITMAP 血条 `visible=false`，气条同。KO 中途 `playKO2` / `playTimeOver` 只 fadOut 气条（默认 true）。\n\n### `showHits`（L249–253）\n\n`param1`=连击数，`param2`=team UI id。`==1` 用 `_hits1` 否则 `_hits2`。`FighterEventCtrl`：team.id 1→1、2→2。第一下 hits==1 时事件层就不调这里。\n\n### `hideHits`（L255–259）\n\n`param1` 同样是 team uiID。受击结束 / 倒地 `removeHits` 进来。连打中途不 hide。\n270→\n### `showStart`（L261–288）\n\n闭包：`finishBack`、`params`（**未使用**）、`onFight`、`startComplete`。\n\n1. `fadIn()`（默认带动画）。\n2. `round = gameRunData.round`。\n3. `startKOmc.y = -50`（偏上）。\n4. `$round = round`。SWF 帧 27 把 round clamp 到 1–5 再让 `nummc.gotoAndPlay(\"r\"+round)`。\n5. `gotoAndStop(round < 5 ? \"start\" : \"start_final\")`。第 5 回合（先到 2 胜的 BO3 里少见；生存/组队回合能到 5+）走 FINAL。\n280→6. 听 `\"fight\"` → `onFight` 只 `removeEventListener`。帧 58 派这个，本类不当闸。\n7. 若有 `finishBack`，听 `\"complete\"`（帧 88）再回调。`GameStartCtrl` 用它清 `_uiPlaying`。\n\n`params` 形参对齐 `IGameUI.showStart(Function, Object)`，本实现丢弃。\n\n### `showEnd`（L290–311）\n\n`param1`=完成回调，`param2`=`{winner, loser, drawGame?}`。\n\n1. `_endParam = param2 || {}`，再挂 `finishBack`。\n290→2. `_drawGame = param2 ? param2.drawGame : false`。`param2` 刚被空对象兜底，但这里又用原 `param2`——若调用方传 `null`，`_endParam={}` 而 `_drawGame=false`。`GameEndCtrl` 总传对象。\n3. `_renderEnd=true`，`_playOver=false`。\n4. `gameRunData.isTimerOver` → `playTimeOver()`，否则 `playKO(param2.loser)`（平局 `drawGame` 且超时才走 timeover；非超时平局本包不存在）。\n\n`GameEndCtrl` 同时 `_holdFrame=10*FPS_GAME`，UI 回调把 hold 清 0 以提前结束等待。\n\n### `playKO`（L313–352）\n\n闭包 `playKO2`：`startKOmc.y=0`，`gotoAndStop(\"ko\")`，听 `\"complete\"`→`koBack`，`snd_ko_bs` 或 `snd_ko`，两条气条 `fadOut()`。\n\n300→立即：\n\n1. `_showWinnerDelay=0`。\n2. `EffectCtrl.I.freezeEnabled=false`：挡住 KO 期间的 hit-stop，避免再 `GameCtrl.pause` 套娃。\n3. `_isSlowDown=false`。\n4. 有 `loser`：`doEffectById(\"hit_end\", loser.x, loser.y)`、`shine(0xFFFFFF, 0.5)`、`cameraFocusOne(loser.getDisplay())`（zoom 3.5）。\n5. `GameCtrl.I.pause()`：**顿帧**（`_isRenderGame=false`），不是菜单。镜头/特效/本 UI `render` 仍走。\n6. 扫双方 `currentFighter`：任一方 `actionState==12||13`（必杀/超必）→ `bsKO=true`，`BGEffect(\"kobg\", 2)`。\n7. `shake(5, 0, 1.5)`：X 振幅 5、Y 0、时长 **1.5ms**。`param3<=0` 才会被 `EffectCtrl` 收成 500；1.5 原样用，lose 分母接近 0 → `ceil` 后至少 1，一两拍动画帧就抖完。?\n8. `snd_over_hit`。\n310→9. `setTimeout(playKO2, 500)`：真实 500ms 后才出 KO 大字。顿帧不影响 timeout。\n\n无 loser（? 正常 KO 总有）则没有 hit_end / 特写，仍 pause + shake。\n\n### `koBack`（L354–361）\n\n`freezeEnabled=true`（写了**两遍**），卸 `\"complete\"`，`_playOver=true`，`GameCtrl.I.resume()` 恢复物理。之后 `renderEnd` 才能看击飞。\n\n### `playTimeOver`（L363–370）\n\n320→**不** `pause()`、**不**关 `freezeEnabled`。`startKOmc.y=0`，`gotoAndStop(\"timeover\")`，听 `timeoverBack`，气条 fadOut。超时路径角色仍按逻辑帧落地（`GameCtrl.timeover` 已 `actionEnable=false`）。\n\n### `timeoverBack`（L372–385）\n\n`freezeEnabled=true`（超时路径本来就没关）。卸监听。\n\n- `_drawGame`：`playDrawGame()`，`_showWinnerDelay=0`（**不**置 `_playOver`，`renderEnd` 一直早退，不切胜者）。\n- 否则：`_playOver=true`，`_showWinnerDelay = 1 * FPS_GAME`（约 1 秒后出胜者，**不等** `actionState==30`）。超时败者可能还站着。\n\n### `playDrawGame`（L387–392）\n330→\n`gotoAndStop(\"drawgame\")`，听 `drawGameBack`。\n\n### `drawGameBack`（L394–401）\n\n卸监听。`_endParam.finishBack != null` 才调。不改 `_renderEnd` / `_endParam`（随后 `GameEndCtrl` `clearStartAndEnd`）。\n\n### `renderEnd`（L403–471）—— KO 后逻辑\n\n每逻辑帧。闸：`!_playOver` 或 `!_endParam` return。\n340→\n**已有 delay（`_showWinnerDelay>0`）**：减 1。到 ≤0：\n\n1. `_endParam.winner` 有则 `cameraFocusOne(winner)`、`showWinner(winner)`（无 callback）。\n2. `GameMode.isSingleMode()`（20/21/22）才 `showWins(winner, getWins(winner))`。组队/生存不亮灯。\n3. `_endParam` 仍在则 **直接** `_endParam.finishBack()`——**不**判 null。`GameEndCtrl` 总有 cb。\n4. `_renderEnd=false`，`_endParam=null`。\n5. `return`（即使 delay 刚到 0 也不掉到下面的击飞逻辑）。\n\n**delay==0 且尚未启动**：看 `_endParam.loser`。\n350→\n- `actionState==22`（`HURT_FLYING`）且尚未慢动作：`_isSlowDown=true`，`EffectCtrl.slowDown(2, 0)`（rate 2、时长 0=不自动恢复），记下 `_flyTimer=getTimer()`。\n- `actionState==30`（`DEAD`）：\n  - 若曾经慢动作：飞了不到 2000ms → delay=`2*FPS_GAME`，否则 `1*FPS_GAME`。然后 `slowDownResume()`。\n  - 否则（没经过 22，例如抓死/原地倒）：delay=`2*FPS_GAME`，仍 `slowDownResume()`（没 slow 过也 harmless）。\n\n超时非平局在 `timeoverBack` 已设 delay=1s，本段 loser 逻辑会被 delay 分支抢先，**不再**等 DEAD。KO 路径 delay 一直为 0 直到落地，所以会等 22→30。\n\n败者若永远不到 30（? 死亡动画卡死），`_playOver` 已 true 但 delay 起不来，`GameEndCtrl` 的 10s hold 到期后仍会 `clearStartAndEnd` / 进 win pose——UI 可能没播 winner。?\n\n360→### `clearStartAndEnd`（L473–476）\n\n`startKOmc.gotoAndStop(1)`（SWF 帧 1 `stop` 并复位 `$round=1` 等）。`GameEndCtrl` 在 cinema 收尾调用。不卸还在的 COMPLETE 监听（正常已卸）。\n\n### `pause`（L478–486）\n\n懒 `new PauseDialog()` 并 `ui.addChild`。每次 `show()`：visible、开键、箭头落在 CONTINUE（index 2）。`GameCtrl.pause(true)` 在 intro/outro 期间会推迟到 intro 结束（`_gameStartAndPause`），所以开场 FIGHT 播着时 ESC 先不弹框。\n\n### `resume`（L488–495）\n\n370→无 dialog 则 return。否则 `hide()`（藏、关键、`GameUI.closeConfrim`）。CONTINUE 按钮走 `GameCtrl.resume(true)` → 这里。\n\n### `showWinner`（L497–526）\n\n`startKOmc.y=30`。`teamid = winner.team.id`，无 winner/team 当 1。\n\n- team 1：`$winnerX=30`（左）。\n- team 2：`$winnerX=546`（右）。\n- 其它 team id：不写 `$winnerX`，沿用 SWF 默认 30。\n\n380→`$perfect = winner.hp >= winner.hpMax`。超时残留满血也算 perfect。`gotoAndStop(\"winner\")`。SWF 帧 200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并设 `isPerfect`。\n\n`back` 非 null 才听 `\"complete\"`。`renderEnd` 不传 back——胜者条播完不经这里通知 `GameEndCtrl`（对方靠 10s hold / UI 里 `showEnd` 的 finishBack 已在 delay 归零时调过，**winner MC 可能还在播**）。?\n\n### `renderPlayerPosUI`（L528–554）\n\n`param1`=当前 zoom。\n\n- `zoom > 1.8`：两个标记 `visible=false` 后 return。近景不需要屏外箭头。反编译 `_temp_1` 是连续赋值的临时名。\n- 否则取 `p1FighterGroup.currentFighter` / P2，有则 `getPlayerPos` 写 x/y 并 `visible=true`。\n390→- 某侧 current 为 null（组队换人间隙）不会把该侧 visible 设回 false。?\n\n### `getPlayerPos`（L556–576）\n\n`GameState.getGameSpriteGlobalPosition(sprite, 0, -50)`：屏幕坐标，Y 偏 -50（标在头顶）。公式：`((-scroll.x + x + ox) * zoom, (-scroll.y + y + oy) * zoom)`。\n\n钳制：\n\n- `x < 20` → 20；`x > GAME_SIZE.x-20`（780）→ 780。\n- `y < 60` → 60（避开顶 HUD）。\n400→- `y > GAME_SIZE.y-5`（595）→ **`x = GAME_SIZE.x-5`（795）**。明显笔误，本应改 y。角色飞出屏幕底部时标记会跳到右缘。?\n\n返回同一 `Point` 对象（调用方立刻读 x/y，P1/P2 顺序调用会覆盖，但每侧读完就写进 MC，安全）。\n","absolute_path":"/workspace/bvn-3.3/reverse/line-by-line/engine/game/bvn/ui/fight/FightUI.md","offset":null,"raw_output":"# `FightUI` — 战斗 HUD 根（`IGameUI`）\n\n一句话目的：实现 `IGameUI`。从 `ResUtils.fight` 实例化 `ui_fight`，装配顶部血条组、两侧气条、连击数字、开场/KO MC、屏外角色标记和暂停框。`GameUI.initFight` 创建，`GameState` 把它挂在镜头层**外面**（屏幕坐标 800×600）。\n\n源文件：`decompiled/main/scripts/net/play5d/game/bvn/ui/fight/FightUI.as`（579 行）\n\n## Callers / callees\n\n- **Callers**\n  - `GameUI.initFight`：`new FightUI()` + `setVolume(config.soundVolume)` + `initlize(p1Group, p2Group)`。已有 `FightUI` 则复用，不 destory。\n  - `GameUI.render` → `IGameUI.render`；按 30fps 语义再 `renderAnimate`。`GameState.render` 每逻辑帧调 `gameUI.render()`。\n  - `GameUI.fadIn` → `FightUI.fadIn()`（默认 `true`）再 `setVolume`。`GameUI.fadOut` **误调** `fadIn()`，终场不走这条。\n  - `GameStartCtrl`：intro 结束 `showStart(cb)`；skip 且尚未 FIGHT 时 `fadIn(true)`。\n  - `GameEndCtrl`：`showEnd(cb, {winner,loser})` 或 `{drawGame:true}`；结束 `clearStartAndEnd`；KO 路径再 `fadOut(false)`。\n  - `FighterEventCtrl.addHits`：hits>1 才 `showHits(hits, teamUiID)`；`removeHits` → `hideHits(uiID)`。\n  - `GameCtrl.pause(true)` / `resume(true)`：菜单暂停才转到 `FightUI.pause` / `resume`。无参 `pause()`（KO 顿帧）**不**弹暂停框。\n  - `GameCtrl.buildGame` 练习模式：`GameUI.I.fadIn()`（立刻出 HUD，无 ROUND/FIGHT）。\n- **Callees**\n  - 子件：`FightBar`、`QiBar`×2、`HitsUI`×2、`PauseDialog`。\n  - `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\"|\"player_pos_p1\"|\"player_pos_p2\")`。\n  - `EffectCtrl`：`freezeEnabled`、`doEffectById(\"hit_end\")`、`shine`、`BGEffect(\"kobg\")`、`shake`、`slowDown`/`slowDownResume`。\n  - `GameCtrl.I`：`pause`/`resume`（无参顿帧）、`gameRunData`、`gameState.cameraFocusOne` / `getGameSpriteGlobalPosition` / `camera.getZoom`。\n  - `SoundCtrl.I.playSwcSound`：`snd_over_hit`、`snd_ko` / `snd_ko_bs`（同包 SWC，无 import）。\n  - `GameEvent`：街机听 `\"SCORE_UPDATE\"`。\n  - `GameMode.isAcrade` / `isSingleMode`；`GameData.I.score`；`GameConfig.GAME_SIZE` / `FPS_GAME`。\n\n## HUD 布局 / SWF\n\n全部来自 `ResUtils.fight`（嵌入 `fight_swf$…`，链接名见 `decompiled/ui/fight/scripts/`）。**不**走 `ResUtils` 常量表。\n\n```\nGameState（Istage Sprite）\n├── map.bgLayer\n├── _gameLayer          ← GameCamera 作用对象\n│   ├── mapLayer / _playerLayer / front*\n└── ui_fight            ← FightUI.ui，屏幕空间，不随镜头滚\n    ├── hpbarmc         FightBar：P1 左 / P2 右 / 计时正中\n    │   ├── face1 / face2     FightFaceGroup（3 槽头像）\n    │   ├── bar1 / bar2       FighterHpBar（绿条+红拖尾）\n    │   ├── energy1 / energy2 EnergyBar（体力 energy，不是气）\n    │   ├── timemc            FightTimeUI\n    │   ├── win_p1 / win_p2   WinUI 胜场灯\n    │   └── scoremc           FightScoreUI（街机才亮）\n    ├── fzqi1 / fzqi2   QiBar：气 0–300 + 辅助 fzqi + 辅助脸\n    ├── hits1 / hits2   HitsUI：连击数字（屏幕固定位，不跟角色）\n    ├── startKOmc       fight_fla.game_start_mc_44：ROUND/FIGHT/KO/…\n    ├── player_pos_p1/p2 代码 addChild，zoom≤1.8 时标屏外角色\n    └── PauseDialog     代码 addChild，菜单暂停\n```\n\nP1 一律左侧（`face1`/`bar1`/`energy1`/`fzqi1`/`hits1`/`win_p1`），P2 右侧并 `setDirect(-1)`。计时在 `hpbarmc.timemc` 水平居中。气条 SWF 默认贴底；`QI_BAR_MODE==TOP` 才会被代码挪到血条附近 `(120,60)` / `(675,60)` scale 0.8。\n\n`startKOmc` 时间轴由 `renderStartAndKO` 按动画帧 `nextFrame()` 推进（`gotoAndStop` 标签后靠代码走帧，不是 `play()`）。\n\n## 命名备注 / 符号对照\n\n- 拼写：`destory`、`initlize`、`fadIn`/`fadOut`、`isAcrade` 全工程如此。\n- `QI_BAR_MODE`：语义对齐 `FightQiBarMode`（0=AUTO / 1=TOP / 2=BOTTOM），但**本包没有任何写入**，始终默认 `0`。`FightQiBarMode` 类本身也没被 import。\n- `renderQibarPos`：按 zoom 把 AUTO 气条挪到顶部或还原——**从未被调用**（`render` 只调 `renderPlayerPosUI`）。AUTO 的动态位移是死代码。?\n- `BITMAP_UI`：`GameUI.BITMAP_UI=true` 且本包无写入。血条/气条走位图烘焙路径，MC fadIn 动画基本不播。\n- `showStart` 的 `onFight`：收到 `\"fight\"` 只卸监听，**空体**。真正开操作靠 `\"complete\"` → `GameStartCtrl` 清 `_uiPlaying`。\n- `EffectCtrl.shake(5,0,1.5)`：第三参是**毫秒**。`FighterEffectCtrl.shake` 会 `*1000`，这里直接传 `1.5`，衰减极快（见 `EffectCtrl.md`）。几乎确定是 bug。\n- `getPlayerPos` 下沿钳制写成了 `x = GAME_SIZE.x-5` 而不是 `y`。?\n- `player_pos_*` 用 `getGameSpriteGlobalPosition(..., 0, -50)`。`GameState.md` 把这条写成「hits 数字」不准确——连击是 `hits_mc` 的 SWF 布局坐标，不跟角色。\n- `setTimeout(playKO2, 500)` 是墙钟 500ms，不受 `GameCtrl.pause` / slowDown 影响。\n- `actionState` 直接比数字：12/13=必杀、22=击飞、30=死（`FighterActionState`）。\n- `snd_ko` / `snd_ko_bs` / `snd_over_hit`：main.swf 嵌入 MP3，`SoundCtrl.playSwcSound`。\n\n## 开场 / KO 时间线（`startKOmc`）\n\n`fight_fla.game_start_mc_44` 字段：`$round`、`$perfect`、`$winnerX`、`$winnerY`（本类不写 `$winnerY`，SWF 默认 90）。\n\n| 代码 `gotoAndStop` | 条件 | 派发 |\n|---|---|---|\n| `\"start\"` | round < 5 | `\"fight\"`（帧 58）、`\"complete\"`（帧 88） |\n| `\"start_final\"` | round≥5 | 同上结构 |\n| `\"ko\"` | 非超时 KO | `\"complete\"`（帧 190 一带） |\n| `\"timeover\"` | `isTimerOver` | `\"complete\"` |\n| `\"drawgame\"` | 超时且平局 | `\"complete\"` |\n| `\"winner\"` | 胜者条 | 子 MC `winnermc` COMPLETE 再向上派 |\n| 帧 1 | `clearStartAndEnd` | `stop` |\n\n`renderStartAndKO`：当前帧标签 `\"stop\"` 则停；标签 `\"go:xxx\"` 则 `gotoAndStop(xxx)`（SWF 内部跳转约定）；否则 `nextFrame()`。\n\n`game_start_mc_44` 其它脚本帧：27/28 按 `$round` 播 `nummc` 的 `\"r1\"..\"r5\"`；55 派 `\"fight_in\"`（本类不听）；58 `\"fight\"`；200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并写 `isPerfect`；210 把 `winnermc` 的 COMPLETE 转发出去。\n\n## `IGameUI` 对照\n\n`decompiled/.../ui/IGameUI.as`。本类全部实现，另多一个 `showWins`（接口没有）。\n\n| 接口 | 本类 | 谁调 |\n|---|---|---|\n| `setVolume` | 写 `ui.soundTransform` | `GameUI.initFight` / `fadIn` |\n| `destory` | 拆子件 + `removeChildren` | `GameUI.destory` ← `GameState.destory` |\n| `fadIn(Boolean=true)` | 血条+气条 | `showStart`、`GameUI.fadIn`、`GameStartCtrl.skip` |\n| `fadOut(Boolean=true)` | 同上 | `GameEndCtrl` `getUI().fadOut(false)`；KO 中途只 fadOut 气条 |\n| `getUI` | 返回 `ui_fight` | `GameUI.getUIDisplay` |\n| `render` | 血/气/屏外标/终场 | `GameUI.render` 每逻辑帧 |\n| `renderAnimate` | 淡入淡出 + startKOmc 走帧 | `GameUI` 30fps 语义 |\n| `showHits(n, team)` / `hideHits(team)` | HitsUI | `FighterEventCtrl` |\n| `showStart(cb, params)` | ROUND/FIGHT | `GameStartCtrl`（params 丢弃） |\n| `showEnd(cb, obj)` | KO / TIMEOVER / DRAW | `GameEndCtrl` |\n| `clearStartAndEnd` | `gotoAndStop(1)` | `GameEndCtrl` cinema 收尾 |\n| `pause` / `resume` | `PauseDialog` | 仅 `GameCtrl.pause/resume(true)` |\n\n`GameUI.fadOut()` 自己写成 `_ui.fadIn()`，等于废函数。终场不经过它。\n\n## 两种 pause\n\n| | `GameCtrl.pause()` | `GameCtrl.pause(true)` |\n|---|---|---|\n| 谁调 | `FightUI.playKO`、`EffectCtrl.freeze` | ESC / 失焦 |\n| `_isRenderGame` | false（物理停） | false |\n| `_isPauseGame` | 不变 | true，整段 `GameCtrl.render` return |\n| `FightUI.pause` | **不调** | 弹 `PauseDialog` |\n| HUD `render` | 仍走（`GameState.render` 在 pause 闸之前？否：`_isPauseGame` 在 EffectCtrl 之前 return，**菜单暂停时 HUD 也停**） | 停 |\n| KO 顿帧 | HUD 仍 render（`_isPauseGame` 仍 false），`renderEnd` / 气条 fadOut 动画靠 `renderAnimate`——但 `GameUI.render` 在 `GameState.render` 里，而 `GameCtrl.render` 顺序是：菜单闸 → EffectCtrl → gameState.render → `_isRenderGame` 闸。无参 pause 只关 `_isRenderGame`，**HUD 继续**。 |\n\n`PauseDialog`：半透明全屏底 + `SetBtnGroup` 三项 GAME TITLE / MOVE LIST / CONTINUE。TITLE 走 `GameUI.confrim(\"BACK TITLE?\",\"返回到主菜单？\")`（拼写 `confrim`）；MOVE LIST 叠 `MoveListSp`；CONTINUE → `GameCtrl.I.resume(true)`。\n\n## KO / 超时 cinema 时序\n\n```\nGameEndCtrl.showEnd(cb, {winner, loser} | {drawGame:true})\n        │\n        ├─ isTimerOver\n        │     playTimeOver()                    // 不 pause、不关 freeze\n        │       startKOmc \"timeover\" + 气条 fadOut\n        │       complete → timeoverBack\n        │            ├─ drawGame: playDrawGame \"drawgame\" → complete → cb\n        │            └─ 否则 _playOver=true, delay=1s → renderEnd 切胜者 → cb\n        │\n        └─ else playKO(loser)\n              freezeEnabled=false\n              hit_end + shine(白,0.5) + cameraFocusOne(loser)\n              GameCtrl.pause()                  // 顿帧\n              任一方 12/13 → BGEffect(\"kobg\",2) + 稍后 snd_ko_bs\n              shake(5,0,1.5)  + snd_over_hit    // 1.5ms bug\n              500ms 墙钟 → playKO2 \"ko\" + snd_ko + 气条 fadOut\n              complete → koBack: freezeEnabled=true, resume(), _playOver=true\n              renderEnd 等 loser 22→slowDown(2,0) → 30→delay 1s/2s\n              delay 到 0: cameraFocusOne(winner) + showWinner\n                         单挑 showWins；直接 cb（winner MC 可能还在播）\n```\n\n`GameEndCtrl` 同时 hold 最多 10s，cb 把 hold 清 0。之后等 `isAllowWinState` 才 `winner.win()`，再 transIn，最后 `clearStartAndEnd` + `fadOut(false)`。\n\n## 逐行说明\n\n### 静态 / 实例字段（L27–59）\n\n- `QI_BAR_MODE`：气条贴边策略。未赋值 → 0。\n- `ui`：`ui_fight` 根，公开给 `getUI()` / `GameState.addChild`。\n- `_fightbar`：顶部整条 HUD。\n- `_qibar1` / `_qibar2`：绑 `ui.fzqi1` / `fzqi2`。P2 构造里 `setDirect(-1)`。\n- `_hits1` / `_hits2`：绑 `ui.hits1` / `hits2`。`showHits` 用 team 1/2 选。\n- `_endParam`：`showEnd` 的 `{winner,loser,drawGame,finishBack}`。播完置 null。\n- `_renderEnd`：`render()` 里跑 `renderEnd` 的闸。\n- `_playOver`：KO / TIMEOVER MC 的 `\"complete\"` 之后才 true，开始等击飞落地。\n- `_showWinnerDelay`：落地后再等 N 逻辑帧才切胜者镜头。单位=游戏帧。\n- `_drawGame`：超时平局走 `playDrawGame`，不进胜者条。\n- `_isSlowDown`：击飞慢动作只开一次。\n- `_pauseDialog`：懒创建。\n- `_flyTimer`：`getTimer()` 记下进入 `HURT_FLYING` 的墙钟，用来决定胜者 delay 1s 还是 2s。\n- `_p1PosUI` / `_p2PosUI`：`player_pos_p1` / `player_pos_p2`，默认 `visible=false`。\n\n### 构造（L61–83）\n\n1. `ResUtils.I.createDisplayObject(ResUtils.I.fight, \"ui_fight\")` → `ui`。\n2. `new FightBar(ui.hpbarmc)`。\n3. `new QiBar(ui.fzqi1)` / `new QiBar(ui.fzqi2)`，P2 `setDirect(-1)`。\n4. `new HitsUI(ui.hits1)` / `new HitsUI(ui.hits2)`。\n5. 再 `createDisplayObject` 两个 `player_pos_*`，隐藏后 `ui.addChild`。\n6. **仅** `GameMode.isAcrade()`（mode 10/20/30）：`trace(\"fightUI.initlize\")`（文案像 init，实际在构造）、`_fightbar.initScore()`、听 `\"SCORE_UPDATE\"`。VS/练习不显示分数。\n\n此时角色还没绑，等 `initlize`。`GameUI` 构造完立刻 `setVolume`。\n\n### `initlize`（L85–91）\n\n`param1`=P1 `GameRunFighterGroup`，`param2`=P2。\n\n- `_fightbar.setFighter`：脸/HP/体力。\n- `_qibar1.setFighter(currentFighter, fuzhu)`：气条跟**当前出战**角色，脸用**辅助** `Assister.data`。\n- `_qibar2` 同理。\n- `updateScore(null)`：即使没听事件也刷一次（非街机 `_score` 为 null，空操作）。\n\n`GameState.initFight` 与 `resetFight`（下一回合 / 组队换人）都会再进这里。`GameUI` 复用同一 `FightUI` 实例。\n\n### `setVolume`（L93–98）\n\n读 `ui.soundTransform`，改 `volume`，写回。`startKOmc` 里若有时间轴音效走这条。`GameUI.fadIn` 每次都重设为 `config.soundVolume`。\n\n### `showWins`（L100–103）\n\n转发 `_fightbar.showWin(fighter, wins)`。`IGameUI` **没有**这个方法；只有本类 `renderEnd` 在 `isSingleMode` 时自调。组队不亮胜场灯。\n\n### `updateScore`（L105–108）\n\n`GameEvent` `\"SCORE_UPDATE\"` 或 `initlize` 调用。写 `_fightbar.setScore(GameData.I.score)`。`param1` 未用。\n\n### `destory`（L110–156）\n\n顺序：\n\n1. `GameEvent.removeEventListener(\"SCORE_UPDATE\", updateScore)`（非街机也 remove，harmless）。\n2. `_pauseDialog.destory()`。\n3. `_fightbar` / `_qibar1` / `_qibar2` / `_hits1` / `_hits2` 各自 `destory` 后置 null。\n4. `ui.removeChildren()` + `ui.stopAllMovieClips()`，catch 后 `trace(e)`。`ui=null`。\n\n**不清**：`_p1PosUI`/`_p2PosUI`（随 `removeChildren` 摘掉，不单独 destory）、`_endParam`、终场标志、`QI_BAR_MODE`。`GameState.destory` → `GameUI.destory` 进这里。下一场 `GameUI.initFight` 会 `new FightUI()`（因为 `_ui` 已被 destory 置空？`GameUI.destory` 只调 `_ui.destory()` **不清 `_ui` 引用**——再 `initFight` 时 `_ui` 仍是已掏空的 `FightUI`，`_ui is FightUI` 为真，**不会 new**，只再 `initlize`。`ui` 已 null，后续 `render`/`fadIn` 会 NPE）。?\n\n实际战斗结束走 `goStage` 拆掉整个 `GameState`（连带 `new GameUI()`），这条脏复用只在「同一 `GameState` 上 destory UI 再 initFight」时触发，本包没有这条路径。?\n\n### `getUI`（L158–161）\n\n返回 `ui`。`GameUI.getUIDisplay` / `GameState.addChild` 用。`IGameUI` 要求。\n\n### `render`（L163–174）—— 逻辑帧\n\n`GameUI.render` 每游戏帧（默认 60）进来，**不受** `GameCtrl._isRenderGame` 影响（`GameState.render` 在 EffectCtrl 之后、主逻辑之前）。菜单暂停 `_isPauseGame` 时 `GameCtrl.render` 提前 return，本函数也不跑。\n\n1. `_fightbar.render()`：HP / 体力 / 计时。\n2. `_qibar1/2.render()`：气、辅助气。\n3. `camera.getZoom()` → `renderPlayerPosUI`。\n4. `_renderEnd` 则 `renderEnd()`（KO 后等击飞落地、切胜者）。\n\n**不**调 `renderQibarPos`。HitsUI 无 per-frame render（靠 MC `gotoAndPlay`）。\n\n### `renderQibarPos`（L176–192）—— 死代码\n\n`QI_BAR_MODE != 0` 直接 return。AUTO 且 `zoom < 1.5`：气条 `moveTo(120,60,0.8)` / `(675,60,0.8)`（贴顶缩小）；否则 `moveResume()` 回构造时记下的原位。本包 `render` 从不调用。?\n\n### `renderAnimate`（L194–200）\n\n`GameUI` 按 `ceil(FPS_GAME/30)-1` 抽帧（60fps 隔一帧）。转发 FightBar / 两条 QiBar 的 fad 动画，再 `renderStartAndKO()`。Hits / startKOmc 的 `gotoAndPlay` 走的是 Flash 自己的帧频，不经这里；但 `startKOmc` 被 `gotoAndStop` 后要靠这里 `nextFrame()`。\n\n### `renderStartAndKO`（L202–223）\n\n`_loc2_ = ui.startKOmc`，null 则 return（正常不会）。\n\n- 有 `currentFrameLabel`：\n  - `\"stop\"` → return（停在标签，等下次 `gotoAndStop` 切段）。\n  - 含 `\"go:\"` → `gotoAndStop(split(\"go:\")[1])` 后 return（SWF 用标签驱动跳转）。\n- 否则 `nextFrame()`。\n\n`showStart`/`playKO`/`playTimeOver`/`showWinner` 都是 `gotoAndStop` 到段首，之后全靠这条往前爬，爬到脚本帧 `stop()+dispatchEvent(COMPLETE)`。\n\n### `fadIn`（L225–240）\n\n`param1` 默认 true = 播 MC 淡入。先 `_fightbar.fadIn(param1)`。\n\n- `QI_BAR_MODE == 1`（TOP）：两条气条 `fadIn(false)`（瞬显）再 `setPosAndScale` 到顶部缩小位。**忽略** `param1`。\n- 否则（AUTO/BOTTOM/默认 0）：气条 `fadIn(param1)`，留在 SWF 原位。\n\n`BITMAP_UI` 时子件自己把动画短路成 `visible=true`。练习 `GameUI.fadIn`、`showStart` 内部、`GameStartCtrl.skip` 都会进。\n\nBOTTOM(2) 与 AUTO 在这条上行为相同（都不改坐标）。\n\n### `fadOut`（L242–247）\n\n三条都 `fadOut(param1)`。`GameEndCtrl` 终场 `fadOut(false)`：BITMAP 路径直接藏子件；非 BITMAP 血条 `visible=false`，气条同。KO 中途 `playKO2` / `playTimeOver` 只 fadOut 气条（默认 true）。\n\n### `showHits`（L249–253）\n\n`param1`=连击数，`param2`=team UI id。`==1` 用 `_hits1` 否则 `_hits2`。`FighterEventCtrl`：team.id 1→1、2→2。第一下 hits==1 时事件层就不调这里。\n\n### `hideHits`（L255–259）\n\n`param1` 同样是 team uiID。受击结束 / 倒地 `removeHits` 进来。连打中途不 hide。\n\n### `showStart`（L261–288）\n\n闭包：`finishBack`、`params`（**未使用**）、`onFight`、`startComplete`。\n\n1. `fadIn()`（默认带动画）。\n2. `round = gameRunData.round`。\n3. `startKOmc.y = -50`（偏上）。\n4. `$round = round`。SWF 帧 27 把 round clamp 到 1–5 再让 `nummc.gotoAndPlay(\"r\"+round)`。\n5. `gotoAndStop(round < 5 ? \"start\" : \"start_final\")`。第 5 回合（先到 2 胜的 BO3 里少见；生存/组队回合能到 5+）走 FINAL。\n6. 听 `\"fight\"` → `onFight` 只 `removeEventListener`。帧 58 派这个，本类不当闸。\n7. 若有 `finishBack`，听 `\"complete\"`（帧 88）再回调。`GameStartCtrl` 用它清 `_uiPlaying`。\n\n`params` 形参对齐 `IGameUI.showStart(Function, Object)`，本实现丢弃。\n\n### `showEnd`（L290–311）\n\n`param1`=完成回调，`param2`=`{winner, loser, drawGame?}`。\n\n1. `_endParam = param2 || {}`，再挂 `finishBack`。\n2. `_drawGame = param2 ? param2.drawGame : false`。`param2` 刚被空对象兜底，但这里又用原 `param2`——若调用方传 `null`，`_endParam={}` 而 `_drawGame=false`。`GameEndCtrl` 总传对象。\n3. `_renderEnd=true`，`_playOver=false`。\n4. `gameRunData.isTimerOver` → `playTimeOver()`，否则 `playKO(param2.loser)`（平局 `drawGame` 且超时才走 timeover；非超时平局本包不存在）。\n\n`GameEndCtrl` 同时 `_holdFrame=10*FPS_GAME`，UI 回调把 hold 清 0 以提前结束等待。\n\n### `playKO`（L313–352）\n\n闭包 `playKO2`：`startKOmc.y=0`，`gotoAndStop(\"ko\")`，听 `\"complete\"`→`koBack`，`snd_ko_bs` 或 `snd_ko`，两条气条 `fadOut()`。\n\n立即：\n\n1. `_showWinnerDelay=0`。\n2. `EffectCtrl.I.freezeEnabled=false`：挡住 KO 期间的 hit-stop，避免再 `GameCtrl.pause` 套娃。\n3. `_isSlowDown=false`。\n4. 有 `loser`：`doEffectById(\"hit_end\", loser.x, loser.y)`、`shine(0xFFFFFF, 0.5)`、`cameraFocusOne(loser.getDisplay())`（zoom 3.5）。\n5. `GameCtrl.I.pause()`：**顿帧**（`_isRenderGame=false`），不是菜单。镜头/特效/本 UI `render` 仍走。\n6. 扫双方 `currentFighter`：任一方 `actionState==12||13`（必杀/超必）→ `bsKO=true`，`BGEffect(\"kobg\", 2)`。\n7. `shake(5, 0, 1.5)`：X 振幅 5、Y 0、时长 **1.5ms**。`param3<=0` 才会被 `EffectCtrl` 收成 500；1.5 原样用，lose 分母接近 0 → `ceil` 后至少 1，一两拍动画帧就抖完。?\n8. `snd_over_hit`。\n9. `setTimeout(playKO2, 500)`：真实 500ms 后才出 KO 大字。顿帧不影响 timeout。\n\n无 loser（? 正常 KO 总有）则没有 hit_end / 特写，仍 pause + shake。\n\n### `koBack`（L354–361）\n\n`freezeEnabled=true`（写了**两遍**），卸 `\"complete\"`，`_playOver=true`，`GameCtrl.I.resume()` 恢复物理。之后 `renderEnd` 才能看击飞。\n\n### `playTimeOver`（L363–370）\n\n**不** `pause()`、**不**关 `freezeEnabled`。`startKOmc.y=0`，`gotoAndStop(\"timeover\")`，听 `timeoverBack`，气条 fadOut。超时路径角色仍按逻辑帧落地（`GameCtrl.timeover` 已 `actionEnable=false`）。\n\n### `timeoverBack`（L372–385）\n\n`freezeEnabled=true`（超时路径本来就没关）。卸监听。\n\n- `_drawGame`：`playDrawGame()`，`_showWinnerDelay=0`（**不**置 `_playOver`，`renderEnd` 一直早退，不切胜者）。\n- 否则：`_playOver=true`，`_showWinnerDelay = 1 * FPS_GAME`（约 1 秒后出胜者，**不等** `actionState==30`）。超时败者可能还站着。\n\n### `playDrawGame`（L387–392）\n\n`gotoAndStop(\"drawgame\")`，听 `drawGameBack`。\n\n### `drawGameBack`（L394–401）\n\n卸监听。`_endParam.finishBack != null` 才调。不改 `_renderEnd` / `_endParam`（随后 `GameEndCtrl` `clearStartAndEnd`）。\n\n### `renderEnd`（L403–471）—— KO 后逻辑\n\n每逻辑帧。闸：`!_playOver` 或 `!_endParam` return。\n\n**已有 delay（`_showWinnerDelay>0`）**：减 1。到 ≤0：\n\n1. `_endParam.winner` 有则 `cameraFocusOne(winner)`、`showWinner(winner)`（无 callback）。\n2. `GameMode.isSingleMode()`（20/21/22）才 `showWins(winner, getWins(winner))`。组队/生存不亮灯。\n3. `_endParam` 仍在则 **直接** `_endParam.finishBack()`——**不**判 null。`GameEndCtrl` 总有 cb。\n4. `_renderEnd=false`，`_endParam=null`。\n5. `return`（即使 delay 刚到 0 也不掉到下面的击飞逻辑）。\n\n**delay==0 且尚未启动**：看 `_endParam.loser`。\n\n- `actionState==22`（`HURT_FLYING`）且尚未慢动作：`_isSlowDown=true`，`EffectCtrl.slowDown(2, 0)`（rate 2、时长 0=不自动恢复），记下 `_flyTimer=getTimer()`。\n- `actionState==30`（`DEAD`）：\n  - 若曾经慢动作：飞了不到 2000ms → delay=`2*FPS_GAME`，否则 `1*FPS_GAME`。然后 `slowDownResume()`。\n  - 否则（没经过 22，例如抓死/原地倒）：delay=`2*FPS_GAME`，仍 `slowDownResume()`（没 slow 过也 harmless）。\n\n超时非平局在 `timeoverBack` 已设 delay=1s，本段 loser 逻辑会被 delay 分支抢先，**不再**等 DEAD。KO 路径 delay 一直为 0 直到落地，所以会等 22→30。\n\n败者若永远不到 30（? 死亡动画卡死），`_playOver` 已 true 但 delay 起不来，`GameEndCtrl` 的 10s hold 到期后仍会 `clearStartAndEnd` / 进 win pose——UI 可能没播 winner。?\n\n### `clearStartAndEnd`（L473–476）\n\n`startKOmc.gotoAndStop(1)`（SWF 帧 1 `stop` 并复位 `$round=1` 等）。`GameEndCtrl` 在 cinema 收尾调用。不卸还在的 COMPLETE 监听（正常已卸）。\n\n### `pause`（L478–486）\n\n懒 `new PauseDialog()` 并 `ui.addChild`。每次 `show()`：visible、开键、箭头落在 CONTINUE（index 2）。`GameCtrl.pause(true)` 在 intro/outro 期间会推迟到 intro 结束（`_gameStartAndPause`），所以开场 FIGHT 播着时 ESC 先不弹框。\n\n### `resume`（L488–495）\n\n无 dialog 则 return。否则 `hide()`（藏、关键、`GameUI.closeConfrim`）。CONTINUE 按钮走 `GameCtrl.resume(true)` → 这里。\n\n### `showWinner`（L497–526）\n\n`startKOmc.y=30`。`teamid = winner.team.id`，无 winner/team 当 1。\n\n- team 1：`$winnerX=30`（左）。\n- team 2：`$winnerX=546`（右）。\n- 其它 team id：不写 `$winnerX`，沿用 SWF 默认 30。\n\n`$perfect = winner.hp >= winner.hpMax`。超时残留满血也算 perfect。`gotoAndStop(\"winner\")`。SWF 帧 200/201 把 `winnermc` 挪到 `$winnerX/$winnerY` 并设 `isPerfect`。\n\n`back` 非 null 才听 `\"complete\"`。`renderEnd` 不传 back——胜者条播完不经这里通知 `GameEndCtrl`（对方靠 10s hold / UI 里 `showEnd` 的 finishBack 已在 delay 归零时调过，**winner MC 可能还在播**）。?\n\n### `renderPlayerPosUI`（L528–554）\n\n`param1`=当前 zoom。\n\n- `zoom > 1.8`：两个标记 `visible=false` 后 return。近景不需要屏外箭头。反编译 `_temp_1` 是连续赋值的临时名。\n- 否则取 `p1FighterGroup.currentFighter` / P2，有则 `getPlayerPos` 写 x/y 并 `visible=true`。\n- 某侧 current 为 null（组队换人间隙）不会把该侧 visible 设回 false。?\n\n### `getPlayerPos`（L556–576）\n\n`GameState.getGameSpriteGlobalPosition(sprite, 0, -50)`：屏幕坐标，Y 偏 -50（标在头顶）。公式：`((-scroll.x + x + ox) * zoom, (-scroll.y + y + oy) * zoom)`。\n\n钳制：\n\n- `x < 20` → 20；`x > GAME_SIZE.x-20`（780）→ 780。\n- `y < 60` → 60（避开顶 HUD）。\n- `y > GAME_SIZE.y-5`（595）→ **`x = GAME_SIZE.x-5`（795）**。明显笔误，本应改 y。角色飞出屏幕底部时标记会跳到右缘。?\n\n返回同一 `Point` 对象（调用方立刻读 x/y，P1/P2 顺序调用会覆盖，但每侧读完就写进 MC，安全）。\n","total_lines":403}},"locations":[]}
