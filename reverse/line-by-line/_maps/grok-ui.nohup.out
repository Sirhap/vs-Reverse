one flags=0x09\n  F12 PLACE2 depth=2 cid=None name=None flags=0x09\n  F13 PLACE2 depth=2 cid=None name=None flags=0x09\n  F14 PLACE2 depth=2 cid=None name=None flags=0x09\n  F15 PLACE2 depth=2 cid=None name=None flags=0x09\n  F16 PLACE2 depth=2 cid=None name=None flags=0x09\n  F17 PLACE2 depth=2 cid=None name=None flags=0x09\n  F18 PLACE2 depth=2 cid=None name=None flags=0x09\n  F19 PLACE2 depth=2 cid=None name=None flags=0x09\n  F20 PLACE2 depth=2 cid=None name=None flags=0x09\n  F46 PLACE2 depth=2 cid=None name=None flags=0x09\n  F47 PLACE2 depth=2 cid=None name=None flags=0x09\n  F48 PLACE2 depth=2 cid=None name=None flags=0x09\n  F49 PLACE2 depth=2 cid=None name=None flags=0x09\n  F50 PLACE2 depth=2 cid=None name=None flags=0x09\n  F51 PLACE2 depth=2 cid=None name=None flags=0x09\n  F52 PLACE2 depth=2 cid=None name=None flags=0x09\n  F53 PLACE2 depth=2 cid=None name=None flags=0x09\n  F54 PLACE2 depth=2 cid=None name=None flags=0x09\n  F55 PLACE2 depth=2 cid=None name=None flags=0x09\n  F56 PLACE2 depth=2 cid=None name=None flags=0x09\n  F57 PLACE2 depth=2 cid=None name=None flags=0x09\n  F58 PLACE2 depth=2 cid=None name=None flags=0x09\n  F59 PLACE2 depth=2 cid=None name=None flags=0x09\n  F60 PLACE2 depth=2 cid=None name=None flags=0x09\n  F61 PLACE2 depth=2 cid=None name=None flags=0x09\n  F62 PLACE2 depth=2 cid=None name=None flags=0x09\n  F63 PLACE2 depth=2 cid=None name=None flags=0x09\n  F64 PLACE2 depth=2 cid=None name=None flags=0x09\n  F65 PLACE2 depth=2 cid=None name=None flags=0x09\n  F66 REMOVE 1\n  F66 REMOVE 2\n\n=== BITMAPS ===\n  char 1 DefineBitsJPEG3 len=139818 jpeg3 alphaofs=12709 head=b'\\xff\\xd8\\xff\\xe0'\n  char 3 DefineBits len=3135 jpeg-tables-based head=b'\\xff\\xd8\\xff\\xe0'\n  char 6 DefineBitsLossless2 len=1674 fmt=3 34x37\n  char 9 DefineBitsLossless2 len=11297 fmt=3 388x75\n  char 11 DefineBitsLossless2 len=11049 fmt=3 388x75\n  char 18 DefineBitsLossless2 len=12124 fmt=3 353x226\n  char 21 DefineBitsLossless2 len=25589 fmt=3 750x93\n\n=== SOUND ===\n  SoundStreamHead2 len=4 06000000\n  DefineSound id=23 flags=0x26 len=4273\n\n=== TEXT / FONT ===\n  DefineFont3 id=15 len=22462\n  DefineFontName id=15 len=143\n    fontname 微软雅黑\n  Tag11 id=16 len=633\nJPEG3 size (3474, 600) RGB\nDefineBits raw len 3135\n","exit_code":0,"command":"python3 << 'PY'\nimport zlib, struct\nfrom collections import defaultdict\n\npath = '/workspace/bvn-3.3/extracted/full/swf/bin_225.swf'\ndata = open(path,'rb').read()\nbody = zlib.decompress(data[8:])\n\nTAG_NAMES = {\n    0:'End',1:'ShowFrame',2:'DefineShape',4:'PlaceObject',5:'RemoveObject',\n    6:'DefineBits',9:'SetBackgroundColor',12:'DoAction',14:'DefineSound',\n    15:'StartSound',20:'DefineBitsLossless',21:'DefineBitsJPEG2',\n    22:'DefineShape2',26:'PlaceObject2',28:'RemoveObject2',32:'DefineShape3',\n    35:'DefineBitsJPEG3',36:'DefineBitsLossless2',37:'DefineEditText',\n    39:'DefineSprite',43:'FrameLabel',45:'SoundStreamHead2',48:'DefineFont3',\n    70:'PlaceObject3',75:'DefineFont3',76:'SymbolClass',82:'DoABC',\n    83:'DefineShape4',86:'DefineSceneAndFrameLabelData',88:'DefineFontName',\n}\n\ndef read_rect(buf, pos):\n    b = buf[pos]\n    nbits = b >> 3\n    total_bits = 5 + nbits*4\n    total_bytes = (total_bits + 7)//8\n    return pos+total_bytes\n\ndef read_string(buf, p):\n    e = buf.find(b'\\x00', p)\n    s = buf[p:e].decode('utf-8', errors='replace')\n    return s, e+1\n\nclass BitReader:\n    def __init__(self, data, offset=0):\n        self.data = data\n        self.pos = offset\n        self.bit = 0\n        self.cur = 0\n    def bits(self, n):\n        v = 0\n        for _ in range(n):\n            if self.bit == 0:\n                self.cur = self.data[self.pos]\n                self.pos += 1\n                self.bit = 8\n            self.bit -= 1\n            v = (v<<1) | ((self.cur>>self.bit)&1)\n        return v\n    def sbits(self, n):\n        v = self.bits(n)\n        if n and (v & (1<<(n-1))):\n            v -= 1<<n\n        return v\n    def align(self):\n        self.bit = 0\n\ndef parse_matrix(br):\n    has_scale = br.bits(1)\n    sx=sy=1.0\n    if has_scale:\n        n = br.bits(5)\n        sx = br.sbits(n)/65536.0\n        sy = br.sbits(n)/65536.0\n    has_rot = br.bits(1)\n    r0=r1=0.0\n    if has_rot:\n        n = br.bits(5)\n        r0 = br.sbits(n)/65536.0\n        r1 = br.sbits(n)/65536.0\n    n = br.bits(5)\n    tx = br.sbits(n)/20.0\n    ty = br.sbits(n)/20.0\n    br.align()\n    return dict(sx=sx,sy=sy,r0=r0,r1=r1,tx=tx,ty=ty)\n\ndef parse_cxform_alpha(br):\n    has_add = br.bits(1)\n    has_mul = br.bits(1)\n    n = br.bits(4)\n    mul = [1,1,1,1]\n    add = [0,0,0,0]\n    if has_mul:\n        mul = [br.sbits(n) for _ in range(4)]\n    if has_add:\n        add = [br.sbits(n) for _ in range(4)]\n    br.align()\n    return mul, add\n\ndef parse_place2(payload):\n    flags = payload[0]\n    br = BitReader(payload, 1)\n    # after flags byte, rest is byte-aligned fields mixed with bit fields\n    # PlaceObject2: flags then UI16 depth, then optional char, matrix, cxform, ratio, name, clipdepth, clipevents\n    # Easier: use byte reader for aligned parts\n    q = 1\n    depth = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    cid = None\n    if flags & 0x02:\n        cid = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    matrix = None\n    if flags & 0x04:\n        br = BitReader(payload, q)\n        matrix = parse_matrix(br)\n        q = br.pos\n    cx = None\n    if flags & 0x08:\n        br = BitReader(payload, q)\n        # PlaceObject2 uses CXFORM if not PlaceObject3? Actually PlaceObject2 uses CXFORMWITHALPHA\n        cx = parse_cxform_alpha(br)\n        q = br.pos\n    ratio = None\n    if flags & 0x10:\n        ratio = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    inst = None\n    if flags & 0x20:\n        inst, q = read_string(payload, q)\n    clip = None\n    if flags & 0x40:\n        clip = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    has_clip_actions = flags & 0x80\n    return dict(flags=flags, depth=depth, cid=cid, matrix=matrix, name=inst, ratio=ratio, clip=clip, has_clip_actions=bool(has_clip_actions), cx=cx)\n\ndef parse_place3(payload):\n    flags = payload[0]\n    flags2 = payload[1]\n    q = 2\n    depth = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    cls = None\n    if flags2 & 0x08:  # HasClassName\n        cls, q = read_string(payload, q)\n    cid = None\n    if flags & 0x02:\n        cid = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n    matrix=None\n    if flags & 0x04:\n        br = BitReader(payload, q)\n        matrix = parse_matrix(br)\n        q = br.pos\n    inst=None\n    # skip more if needed\n    if flags & 0x08:\n        br = BitReader(payload, q)\n        parse_cxform_alpha(br)\n        q = br.pos\n    if flags & 0x10:\n        q += 2\n    if flags & 0x20:\n        inst, q = read_string(payload, q)\n    return dict(flags=flags, flags2=flags2, depth=depth, cid=cid, className=cls, name=inst, matrix=matrix)\n\ndef parse_tags(buf):\n    tags=[]\n    pp=0\n    while pp < len(buf)-1:\n        rec = struct.unpack('<H', buf[pp:pp+2])[0]\n        pp += 2\n        tag_type = rec >> 6\n        length = rec & 0x3f\n        if length == 0x3f:\n            if pp+4>len(buf): break\n            length = struct.unpack('<I', buf[pp:pp+4])[0]\n            pp += 4\n        payload = buf[pp:pp+length]\n        pp += length\n        tags.append((tag_type, TAG_NAMES.get(tag_type, f'Tag{tag_type}'), length, payload))\n        if tag_type==0:\n            break\n    return tags\n\npos = read_rect(body, 0)\npos += 4  # fps+frames\nroot_tags = parse_tags(body[pos:])\n\n# collect all define sprites\nsprites = {}\nall_tags_top = root_tags\nfor tt,name,ln,pl in all_tags_top:\n    if tt==39:\n        sid = struct.unpack('<H', pl[:2])[0]\n        nfr = struct.unpack('<H', pl[2:4])[0]\n        inner = parse_tags(pl[4:])\n        sprites[sid] = (nfr, inner)\n\ndef walk_timeline(tags, nfr_decl=None):\n    frame=1\n    events=[]\n    for tt,name,ln,pl in tags:\n        if tt==1:\n            frame += 1\n        elif tt==43:\n            s,_=read_string(pl,0)\n            events.append((frame,'LABEL',s))\n        elif tt==26:\n            po=parse_place2(pl)\n            events.append((frame,'PLACE2',po))\n        elif tt==70:\n            po=parse_place3(pl)\n            events.append((frame,'PLACE3',po))\n        elif tt==28:\n            depth=struct.unpack('<H', pl[:2])[0]\n            events.append((frame,'REMOVE',depth))\n        elif tt==15:\n            events.append((frame,'STARTSOUND',pl[:8].hex()))\n        elif tt==4:\n            events.append((frame,'PLACE1', pl[:6].hex()))\n        elif tt==5:\n            events.append((frame,'REMOVE1', pl[:4].hex()))\n        elif tt==12:\n            events.append((frame,'DOACTION',ln))\n    return events, frame-1\n\nsymbol = {\n    0: 'common_ui_fla.MainTimeline (doc)',\n    5: 'trans_mc',\n    8: 'select_arrow_mc',\n    13: 'wzimg_bgimg_5',\n    14: 'mc_wzbtn',\n    20: 'mc_win_all',\n    25: 'mc_congratulations',\n    26: 'logo_movie',\n}\n\nprint('=== ROOT timeline ===')\nev, seen = walk_timeline(root_tags)\nprint('seen', seen)\nfor e in ev:\n    print(' ', e)\n\nprint('\\n=== SPRITES timelines ===')\nfor sid in sorted(sprites):\n    nfr, inner = sprites[sid]\n    print(f'\\n--- sprite {sid} {symbol.get(sid,\"?\")} declared={nfr} ---')\n    ev, seen = walk_timeline(inner)\n    print('seen', seen)\n    # summarize unique cids placed\n    cids=set(); names=set()\n    for fr,kind,po in ev:\n        if kind in ('PLACE2','PLACE3'):\n            if po.get('cid') is not None: cids.add(po['cid'])\n            if po.get('name'): names.add(po['name'])\n            if po.get('className'): names.add('cls:'+po['className'])\n    print(' placed cids', sorted(cids), 'instance names', names)\n    # print all place/remove/label\n    for item in ev:\n        fr,kind,po = item\n        if kind in ('PLACE2','PLACE3'):\n            m=po.get('matrix')\n            mstr=''\n            if m:\n                mstr=f\" xy=({m['tx']:.1f},{m['ty']:.1f}) scale=({m['sx']:.3f},{m['sy']:.3f})\"\n            print(f'  F{fr} {kind} depth={po[\"depth\"]} cid={po.get(\"cid\")} name={po.get(\"name\")!r}{mstr} flags=0x{po[\"flags\"]:02x}')\n        else:\n            print(f'  F{fr} {kind} {po}')\n\n# Bitmap headers\nprint('\\n=== BITMAPS ===')\nfor tt,name,ln,pl in root_tags:\n    if tt in (6,20,21,35,36):\n        cid=struct.unpack('<H', pl[:2])[0]\n        extra=''\n        if tt==36: # lossless2\n            fmt=pl[2]; w,h=struct.unpack('<HH', pl[3:7])\n            extra=f' fmt={fmt} {w}x{h}'\n        elif tt==20:\n            fmt=pl[2]; w,h=struct.unpack('<HH', pl[3:7])\n            extra=f' fmt={fmt} {w}x{h}'\n        elif tt==35: # jpeg3\n            extra=f' jpeg3 alphaofs={struct.unpack(\"<I\", pl[2:6])[0]}'\n            # jpeg soi\n            extra += f' head={pl[6:10]}'\n        elif tt==6:\n            extra=f' jpeg-tables-based head={pl[2:6]}'\n        print(f'  char {cid} {name} len={ln}{extra}')\n\nprint('\\n=== SOUND ===')\nfor tt,name,ln,pl in root_tags:\n    if tt==14:\n        cid=struct.unpack('<H', pl[:2])[0]\n        flags=pl[2]\n        print(f'  DefineSound id={cid} flags=0x{flags:02x} len={ln}')\n    if tt==45:\n        print(f'  SoundStreamHead2 len={ln} {pl[:16].hex()}')\n\nprint('\\n=== TEXT / FONT ===')\nfor tt,name,ln,pl in root_tags:\n    if tt in (11,33,37,48,75,88):\n        cid=struct.unpack('<H', pl[:2])[0] if ln>=2 else -1\n        print(f'  {name} id={cid} len={ln}')\n        if tt==88:\n            # fontid + name\n            fid=struct.unpack('<H', pl[:2])[0]\n            s,_=read_string(pl,2)\n            print('    fontname', s)\n\n# JPEG3 dimensions via SOF\nimport io\ntry:\n    from PIL import Image\n    import io as _io\n    for tt,name,ln,pl in root_tags:\n        if tt==35:\n            alphaofs=struct.unpack('<I', pl[2:6])[0]\n            jpeg=pl[6:6+alphaofs]\n            im=Image.open(_io.BytesIO(jpeg))\n            print('JPEG3 size', im.size, im.mode)\n        if tt==6:\n            print('DefineBits raw len', ln)\nexcept Exception as e:\n    print('PIL', e)\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":"Dump PlaceObject names, nesting, bitmap sizes","current_dir":"/workspace/bvn-3.3","output_file":"/home/box/.grok/sessions/%2Fworkspace%2Fbvn-3.3/01a06f0d-c127-71b1-aebb-cbe2617f4e0f/terminal/call-5dee677c-bbf3-4fcb-8888-86e06de38244-52.log","total_bytes":11910},"locations":[]}
