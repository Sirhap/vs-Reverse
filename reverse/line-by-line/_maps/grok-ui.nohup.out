{"type":"tool_call","toolCallId":"call-a3e642d8-296c-45d3-82a7-e295b7074b91-73","title":"run_terminal_command","kind":"execute","status":"pending","toolName":"run_terminal_command","rawInput":{"command":"python3 - << 'PY'\nimport os, struct, zlib, re\n\nSWFDIR = '/workspace/bvn-3.3/extracted/full/swf'\n\nTAG_NAMES = {\n    0:'End',1:'ShowFrame',2:'DefineShape',4:'PlaceObject',5:'RemoveObject',6:'DefineBits',\n    9:'SetBackgroundColor',12:'DoAction',14:'DefineSound',26:'PlaceObject2',28:'RemoveObject2',\n    39:'DefineSprite',43:'FrameLabel',56:'ExportAssets',69:'FileAttributes',76:'SymbolClass',\n    82:'DoABC',86:'DefineSceneAndFrameLabelData',\n}\n\ndef encoded_u32(data, i):\n    result = 0\n    shift = 0\n    while True:\n        b = data[i]\n        i += 1\n        result |= (b & 0x7f) << shift\n        if not (b & 0x80):\n            break\n        shift += 7\n    return result, i\n\ndef read_string(data, i):\n    end = data.find(b'\\x00', i)\n    s = data[i:end].decode('utf-8', errors='replace')\n    return s, end+1\n\ndef decompress_swf(path):\n    data = open(path,'rb').read()\n    sig = data[:3]\n    length = struct.unpack_from('<I', data, 4)[0]\n    if sig == b'CWS':\n        body = zlib.decompress(data[8:])\n        return b'FWS' + data[3:8] + body\n    return data\n\ndef iter_tags(data):\n    # skip header RECT\n    nbits = data[8] >> 3\n    rect_bits = 5 + nbits*4\n    rect_bytes = (rect_bits + 7)//8\n    i = 8 + rect_bytes + 4  # + fps + framecount\n    fps = struct.unpack_from('<H', data, 8+rect_bytes)[0]\n    frames = struct.unpack_from('<H', data, 8+rect_bytes+2)[0]\n    print(f'  header fps={fps/256:.2f} frames={frames} start={i}')\n    while i+2 <= len(data):\n        code_len = struct.unpack_from('<H', data, i)[0]\n        i += 2\n        tag = code_len >> 6\n        length = code_len & 0x3f\n        if length == 0x3f:\n            length = struct.unpack_from('<I', data, i)[0]\n            i += 4\n        payload = data[i:i+length]\n        yield tag, payload\n        i += length\n        if tag == 0:\n            break\n\ndef parse_sprite(payload):\n    sid, framecount = struct.unpack_from('<HH', payload, 0)\n    # remaining is tags\n    data = payload[4:]\n    i = 0\n    labels = []\n    frame = 1\n    scripts_info = []\n    while i+2 <= len(data):\n        code_len = struct.unpack_from('<H', data, i)[0]\n        i += 2\n        tag = code_len >> 6\n        length = code_len & 0x3f\n        if length == 0x3f:\n            if i+4 > len(data):\n                break\n            length = struct.unpack_from('<I', data, i)[0]\n            i += 4\n        payload2 = data[i:i+length]\n        if tag == 43:  # FrameLabel\n            name, _ = read_string(payload2, 0)\n            labels.append((frame, name, payload2))\n        elif tag == 1:\n            frame += 1\n        elif tag == 12:  # DoAction\n            scripts_info.append((frame, 'DoAction', length))\n        i += length\n        if tag == 0:\n            break\n    return sid, framecount, labels, frame-1 if frame>1 else framecount\n\ndef parse_scene_labels(payload):\n    i = 0\n    nscenes, i = encoded_u32(payload, i)\n    scenes = []\n    for _ in range(nscenes):\n        off, i = encoded_u32(payload, i)\n        name, i = read_string(payload, i)\n        scenes.append((off, name))\n    nlabels, i = encoded_u32(payload, i)\n    labels = []\n    for _ in range(nlabels):\n        fr, i = encoded_u32(payload, i)\n        name, i = read_string(payload, i)\n        labels.append((fr+1, name))  # 0-based -> 1-based?\n        # actually SWF spec says frameNum is the frame number (0-based)\n    return scenes, labels\n\ndef parse_symbol_class(payload):\n    n = struct.unpack_from('<H', payload, 0)[0]\n    i = 2\n    out = []\n    for _ in range(n):\n        sid = struct.unpack_from('<H', payload, i)[0]\n        i += 2\n        name, i = read_string(payload, i)\n        out.append((sid, name))\n    return out\n\nfor fname in ['bin_227.swf','bin_228.swf','bin_2215.swf']:\n    path = os.path.join(SWFDIR, fname)\n    print('====', fname, 'size', os.path.getsize(path))\n    data = decompress_swf(path)\n    print('  decompressed', len(data))\n    sprites = []\n    for tag, payload in iter_tags(data):\n        name = TAG_NAMES.get(tag, str(tag))\n        if tag == 86:\n            scenes, labels = parse_scene_labels(payload)\n            print('  DefineSceneAndFrameLabelData scenes', scenes, 'labels', labels)\n        elif tag == 76:\n            print('  SymbolClass', parse_symbol_class(payload))\n        elif tag == 39:\n            sid, fc, labels, parsed_frames = parse_sprite(payload)\n            sprites.append((sid, fc, labels, parsed_frames, len(payload)))\n        elif tag == 43:\n            name2,_ = read_string(payload,0)\n            print('  root FrameLabel', name2)\n    print('  sprites:')\n    for sid, fc, labels, pf, sz in sprites:\n        print(f'    id={sid} frames={fc} parsed={pf} size={sz} labels={labels}')\n    print()\nPY\n","description":"Parse SWF frame labels from UI nested SWFs"},"content":[],"locations":[]}
