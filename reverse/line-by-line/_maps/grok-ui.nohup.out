me 'mc_win_all' abc_len 397\n[38] DoABC len=430\n  DoABC flags 1 name 'mc_wzbtn' abc_len 417\n[39] DoABC len=422\n  DoABC flags 1 name 'select_arrow_mc' abc_len 402\n[40] DoABC len=678\n  DoABC flags 1 name 'trans_mc' abc_len 665\n[41] SymbolClass len=148\n  char 26 -> logo_movie\n  char 25 -> mc_congratulations\n  char 20 -> mc_win_all\n  char 14 -> mc_wzbtn\n  char 13 -> common_ui_fla.wzimg_bgimg_5\n  char 8 -> select_arrow_mc\n  char 5 -> trans_mc\n  char 0 -> common_ui_fla.MainTimeline\n\n=== DefineSprite list ===\nROOT frames_seen 2 expected 2\nROOT labels []\nROOT actions [(1, 'DoABC', 585), (1, 'DoABC', 588), (1, 'DoABC', 622), (1, 'DoABC', 596), (1, 'DoABC', 412), (1, 'DoABC', 430), (1, 'DoABC', 422), (1, 'DoABC', 678)]\n\n=== Sprites ===\n  sprite 5: declared_frames=70 labels=[(10, 'fadin', 6), (26, 'stop', 5), (45, 'fadout', 7), (61, 'stop', 5)] actions=[] seen=70\n  sprite 8: declared_frames=14 labels=[] actions=[] seen=14\n  sprite 13: declared_frames=2 labels=[] actions=[] seen=2\n  sprite 14: declared_frames=1\n  sprite 20: declared_frames=1\n  sprite 25: declared_frames=50 labels=[] actions=[] seen=50\n  sprite 26: declared_frames=66 labels=[] actions=[] seen=66\n\n=== DefineBits / JPEG / Lossless sizes ===\nbitmaps [('DefineBitsJPEG3', 1, 139818), ('DefineBits', 3, 3135), ('DefineBitsLossless2', 6, 1674), ('DefineBitsLossless2', 9, 11297), ('DefineBitsLossless2', 11, 11049), ('DefineBitsLossless2', 18, 12124), ('DefineBitsLossless2', 21, 25589)] count 7\nshapes count 9 first [('DefineShape', 2, 45), ('DefineShape', 4, 38), ('DefineShape', 7, 49), ('DefineShape', 10, 54), ('DefineShape', 12, 54), ('DefineShape', 17, 33), ('DefineShape', 19, 50), ('DefineShape', 22, 53), ('DefineShape', 24, 36)] last [('DefineShape', 12, 54), ('DefineShape', 17, 33), ('DefineShape', 19, 50), ('DefineShape', 22, 53), ('DefineShape', 24, 36)]\n","exit_code":0,"command":"python3 << 'PY'\nimport zlib, struct, os\nfrom io import BytesIO\n\npath = '/workspace/bvn-3.3/extracted/full/swf/bin_225.swf'\ndata = open(path,'rb').read()\nsig, ver = data[:3], data[3]\nlength = struct.unpack('<I', data[4:8])[0]\nprint('sig', sig, 'ver', ver, 'declared', length, 'file', len(data))\nbody = zlib.decompress(data[8:])\nprint('decomp', len(body), 'expected', length-8)\n\n# RECT: nbits in top 5 bits\ndef read_rect(buf, pos):\n    b = buf[pos]\n    nbits = b >> 3\n    total_bits = 5 + nbits*4\n    total_bytes = (total_bits + 7)//8\n    return pos+total_bytes\n\npos = 0\npos = read_rect(body, pos)\nfps = struct.unpack('<H', body[pos:pos+2])[0]/256\nframes = struct.unpack('<H', body[pos+2:pos+4])[0]\npos += 4\nprint('fps', fps, 'doc frames', frames)\n\nTAG_NAMES = {\n    0:'End',1:'ShowFrame',2:'DefineShape',4:'PlaceObject',5:'RemoveObject',\n    6:'DefineBits',7:'DefineButton',8:'JPEGTables',9:'SetBackgroundColor',\n    10:'DefineFont',11:'DefineText',12:'DoAction',13:'DefineFontInfo',\n    14:'DefineSound',15:'StartSound',17:'DefineButtonSound',18:'SoundStreamHead',\n    19:'SoundStreamBlock',20:'DefineBitsLossless',21:'DefineBitsJPEG2',\n    22:'DefineShape2',23:'DefineButtonCxform',24:'Protect',26:'PlaceObject2',\n    28:'RemoveObject2',32:'DefineShape3',33:'DefineText2',34:'DefineButton2',\n    35:'DefineBitsJPEG3',36:'DefineBitsLossless2',37:'DefineEditText',\n    39:'DefineSprite',43:'FrameLabel',45:'SoundStreamHead2',46:'DefineMorphShape',\n    48:'DefineFont2',56:'ExportAssets',57:'ImportAssets',58:'EnableDebugger',\n    59:'DoInitAction',60:'DefineVideoStream',61:'VideoFrame',62:'DefineFontInfo2',\n    64:'EnableDebugger2',65:'ScriptLimits',66:'SetTabIndex',69:'FileAttributes',\n    70:'PlaceObject3',71:'ImportAssets2',73:'DefineFontAlignZones',74:'CSMTextSettings',\n    75:'DefineFont3',76:'SymbolClass',77:'Metadata',78:'DefineScalingGrid',\n    82:'DoABC',83:'DefineShape4',84:'DefineMorphShape2',86:'DefineSceneAndFrameLabelData',\n    87:'DefineBinaryData',88:'DefineFontName',89:'StartSound2',90:'DefineBitsJPEG4',\n    91:'DefineFont4',\n}\n\ndef read_string(buf, p):\n    e = buf.find(b'\\x00', p)\n    s = buf[p:e].decode('utf-8', errors='replace')\n    return s, e+1\n\ntags = []\nsprites = {}  # id -> info\ncurrent_sprite = None\nsprite_stack = []\n# We'll parse sequentially\n\np = pos\ntag_index = 0\nwhile p < len(body):\n    rec = struct.unpack('<H', body[p:p+2])[0]\n    p += 2\n    tag_type = rec >> 6\n    length = rec & 0x3f\n    if length == 0x3f:\n        length = struct.unpack('<I', body[p:p+4])[0]\n        p += 4\n    payload = body[p:p+length]\n    p += length\n    name = TAG_NAMES.get(tag_type, f'Tag{tag_type}')\n    tags.append((tag_type, name, length, payload))\n    if tag_type == 0:\n        break\n    tag_index += 1\n\nprint('tag count', len(tags))\nfrom collections import Counter\nc = Counter(t[1] for t in tags)\nfor k,v in c.most_common():\n    print(f'  {k}: {v}')\n\nprint('\\n=== FileAttributes / Scene / SymbolClass / FrameLabel / Export ===')\nfor i,(tt,name,ln,pl) in enumerate(tags):\n    if name in ('FileAttributes','SetBackgroundColor','DefineSceneAndFrameLabelData','SymbolClass','ExportAssets','Metadata','FrameLabel','DoABC','EnableDebugger2','ScriptLimits'):\n        print(f'[{i}] {name} len={ln}')\n        if name == 'SetBackgroundColor' and ln>=3:\n            print('  bg', pl[:3].hex())\n        if name == 'SymbolClass':\n            n = struct.unpack('<H', pl[:2])[0]\n            q = 2\n            for _ in range(n):\n                cid = struct.unpack('<H', pl[q:q+2])[0]; q+=2\n                s,q = read_string(pl,q)\n                print(f'  char {cid} -> {s}')\n        if name == 'ExportAssets':\n            n = struct.unpack('<H', pl[:2])[0]\n            q = 2\n            for _ in range(n):\n                cid = struct.unpack('<H', pl[q:q+2])[0]; q+=2\n                s,q = read_string(pl,q)\n                print(f'  export {cid} -> {s}')\n        if name == 'DefineSceneAndFrameLabelData':\n            q=0\n            def read_u30(b,i):\n                val=0; shift=0\n                while True:\n                    byte=b[i]; i+=1\n                    val |= (byte&0x7f)<<shift\n                    if not (byte&0x80): break\n                    shift+=7\n                return val,i\n            nscenes,q = read_u30(pl,q)\n            print('  nscenes', nscenes)\n            for _ in range(nscenes):\n                off,q = read_u30(pl,q)\n                s,q = read_string(pl,q)\n                print('  scene offset', off, s)\n            nlab,q = read_u30(pl,q)\n            print('  nlabels', nlab)\n            for _ in range(nlab):\n                fr,q = read_u30(pl,q)\n                s,q = read_string(pl,q)\n                print('  label frame', fr, s)\n        if name == 'FrameLabel':\n            s,_ = read_string(pl,0)\n            print('  FRAME LABEL (root?):', s)\n        if name == 'DoABC':\n            # flags + name\n            flags = struct.unpack('<I', pl[:4])[0]\n            s,_ = read_string(pl,4)\n            print('  DoABC flags', flags, 'name', repr(s), 'abc_len', ln-4-len(s)-1)\n\nprint('\\n=== DefineSprite list ===')\n# walk again with sprite context for FrameLabel\np = pos\n# Better: iterate tags with sprite context\nsprite_id = None\nsprite_frames = None\nsprite_frame = 0\nroot_frame = 1\nin_sprite = False\n\ndef parse_sprite(pl):\n    sid = struct.unpack('<H', pl[:2])[0]\n    nframes = struct.unpack('<H', pl[2:4])[0]\n    inner = pl[4:]\n    return sid, nframes, inner\n\n# We'll recursively parse sprite bodies\ndef parse_tag_stream(buf, context_name, expected_frames=None):\n    pp = 0\n    frame = 1\n    labels = []\n    actions = []\n    places = []\n    children_sprites = []\n    while pp < len(buf):\n        rec = struct.unpack('<H', buf[pp:pp+2])[0]\n        pp += 2\n        tag_type = rec >> 6\n        length = rec & 0x3f\n        if length == 0x3f:\n            length = struct.unpack('<I', buf[pp:pp+4])[0]\n            pp += 4\n        payload = buf[pp:pp+length]\n        pp += length\n        name = TAG_NAMES.get(tag_type, f'Tag{tag_type}')\n        if tag_type == 0:\n            break\n        if tag_type == 1:  # ShowFrame\n            frame += 1\n        elif tag_type == 43:  # FrameLabel\n            s,_ = read_string(payload,0)\n            labels.append((frame, s, length))\n        elif tag_type == 12:  # DoAction\n            actions.append((frame, 'DoAction', length))\n        elif tag_type == 59:  # DoInitAction\n            spr = struct.unpack('<H', payload[:2])[0] if length>=2 else -1\n            actions.append((frame, f'DoInitAction sprite={spr}', length))\n        elif tag_type == 26:  # PlaceObject2\n            flags = payload[0]\n            q=1\n            depth = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n            cid = None\n            if flags & 0x02:  # HasCharacter\n                cid = struct.unpack('<H', payload[q:q+2])[0]; q+=2\n            name_inst = None\n            # skip matrix/cxform/ratio/name...\n            # HasMatrix 0x04, HasCxform 0x08, HasRatio 0x10, HasName 0x20\n            def skip_matrix(b,i):\n                nbits = b[i]>>4\n                bits = 5\n                if b[i] & 0x80: # has scale\n                    # nScaleBits next 5\n                    # this is messy; skip by bit reader\n                    return i  # we'll use bit reader\n                return i\n            # only record if has character or name\n            if flags & 0x20 or flags & 0x02:\n                places.append((frame, depth, cid, flags))\n        elif tag_type == 39:  # DefineSprite nested? shouldn't be nested in sprite typically but can be\n            pass\n        elif tag_type == 82:\n            actions.append((frame, 'DoABC', length))\n    return {'frames_seen': frame-1, 'labels': labels, 'actions': actions, 'places_with_char_or_name': len(places), 'expected': expected_frames}\n\n# Root timeline\nroot_info = parse_tag_stream(body[pos:], 'root', frames)\nprint('ROOT frames_seen', root_info['frames_seen'], 'expected', frames)\nprint('ROOT labels', root_info['labels'])\nprint('ROOT actions', root_info['actions'])\n\n# Parse DefineSprites from top-level tags\nprint('\\n=== Sprites ===')\nfor i,(tt,name,ln,pl) in enumerate(tags):\n    if name == 'DefineSprite':\n        sid = struct.unpack('<H', pl[:2])[0]\n        nfr = struct.unpack('<H', pl[2:4])[0]\n        info = parse_tag_stream(pl[4:], f'sprite{sid}', nfr)\n        extra = ''\n        if info['labels'] or info['actions'] or nfr>1:\n            extra = f\" labels={info['labels']} actions={info['actions']} seen={info['frames_seen']}\"\n        print(f'  sprite {sid}: declared_frames={nfr}{extra}')\n\nprint('\\n=== DefineBits / JPEG / Lossless sizes ===')\nshape_ids=[]\nbit_ids=[]\nfor tt,name,ln,pl in tags:\n    if name.startswith('DefineBits') or name in ('DefineBitsLossless','DefineBitsLossless2','DefineBitsJPEG2','DefineBitsJPEG3'):\n        cid = struct.unpack('<H', pl[:2])[0]\n        bit_ids.append((name, cid, ln))\n    if name in ('DefineShape','DefineShape2','DefineShape3','DefineShape4'):\n        cid = struct.unpack('<H', pl[:2])[0]\n        shape_ids.append((name, cid, ln))\nprint('bitmaps', bit_ids[:30], 'count', len(bit_ids))\nprint('shapes count', len(shape_ids), 'first', shape_ids[:10], 'last', shape_ids[-5:])\nPY\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":2871},"locations":[]}
