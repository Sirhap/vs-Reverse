,"gobot__bake_navigation_mesh","gobot__setup_navigation_agent","gobot__set_navigation_layers","gobot__get_navigation_info","gobot__list_animations","gobot__create_animation","gobot__add_animation_track","gobot__set_animation_keyframe","gobot__get_animation_info","gobot__remove_animation","gobot__get_audio_bus_layout","gobot__add_audio_bus","gobot__set_audio_bus","gobot__add_audio_bus_effect","gobot__add_audio_player","gobot__get_audio_info","gobot__find_nodes_by_type","gobot__find_signal_connections","gobot__batch_set_property","gobot__batch_add_nodes","gobot__find_node_references","gobot__get_scene_dependencies","gobot__cross_scene_set_property","gobot__list_export_presets","gobot__export_project","gobot__get_export_info","gobot__create_particles","gobot__set_particle_material","gobot__set_particle_color_gradient","gobot__apply_particle_preset","gobot__get_particle_info","gobot__get_performance_monitors","gobot__get_editor_performance","gobot__read_resource","gobot__edit_resource","gobot__create_resource","gobot__get_resource_preview","gobot__add_mesh_instance","gobot__setup_lighting","gobot__set_material_3d","gobot__setup_environment","gobot__setup_camera_3d","gobot__add_gridmap","gobot__create_shader","gobot__read_shader","gobot__edit_shader","gobot__assign_shader_material","gobot__set_shader_param","gobot__get_shader_params","gobot__run_test_scenario","gobot__assert_node_state","gobot__assert_screen_text","gobot__run_stress_test","gobot__get_test_report","gobot__create_theme","gobot__set_theme_color","gobot__set_theme_constant","gobot__set_theme_font_size","gobot__set_theme_stylebox","gobot__setup_control","gobot__get_theme_info","gobot__tilemap_set_cell","gobot__tilemap_fill_rect","gobot__tilemap_get_cell","gobot__tilemap_clear","gobot__tilemap_get_info","gobot__tilemap_get_used_cells","gobot__find_unused_resources","gobot__analyze_signal_flow","gobot__analyze_scene_complexity","gobot__find_script_references","gobot__detect_circular_dependencies","gobot__get_pr