pivot","competition-zip-archive","ctf-sandbox","ctf-sandbox-orchestrator","database-security","diagram-generator","digital-forensics","docs-generator","dotnet-reverse","dsl-vm-reverse","edr-bypass-re","email-security","firmware-pentest","ghidra","ghidra-reverse","go-rust-reverse","hardware-security","ida-reverse","identity-federation","js-reverse","llm-security","macos-reverse","malware-analysis","mobile-reverse","ot-ics","patch-diff-exploit","pentest-tools","src-hunter","protocol-reverse","pwn-chain","radare2","radio-sdr","reverse-engineering","reverse-skill-router","supply-chain-security","thick-client","threat-hunting","threat-intelligence","wifi-wireless","windows-ad","build-with-ai","code-review","create-skill","create-workflow","design","execute-plan","bundled:imagine","implement","long-running-background-tasks","pr-babysit","resume-claude","resume-codex","resume-cursor","review","skill-design-principles","statusline"]}
