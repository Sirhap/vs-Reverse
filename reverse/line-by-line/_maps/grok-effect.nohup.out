uct.unpack_from('<H',p,0)[0]\n        j=2\n        for _ in range(n):\n            cid=struct.unpack_from('<H',p,j)[0]; j+=2\n            name,used=cstr(p[j:]); j+=used\n            print(f'  {cid:5d} {name}')\n\n# DefineSprite 39: id, frameCount, then tags until End\nprint('\\n=== DefineSprite frame counts + labels + named instances ===')\nsprite_info={}\nfor tag,length,p in tags:\n    if tag!=39:\n        continue\n    sid=struct.unpack_from('<H',p,0)[0]\n    fcount=struct.unpack_from('<H',p,2)[0]\n    # parse inner tags\n    j=4\n    labels=[]\n    names=[]\n    frame=1\n    nplace=0\n    while j<len(p):\n        cl=struct.unpack_from('<H',p,j)[0]; j+=2\n        itag=cl>>6\n        ilen=cl & 0x3f\n        if ilen==0x3f:\n            ilen=struct.unpack_from('<I',p,j)[0]; j+=4\n        ip=p[j:j+ilen]; j+=ilen\n        if itag==0:\n            break\n        if itag==1:\n            frame+=1\n        elif itag==43:\n            name,_=cstr(ip)\n            labels.append((frame,name))\n        elif itag==26:  # PlaceObject2\n            flags=ip[0]\n            k=1\n            depth=struct.unpack_from('<H',ip,k)[0]; k+=2\n            if flags & 0x02:  # hasCharacter\n                cid=struct.unpack_from('<H',ip,k)[0]; k+=2\n            else:\n                cid=None\n            if flags & 0x04:  # matrix\n                nbits=(ip[k]>>4)&0x0f\n                # skip matrix roughly\n                has_scale = ip[k]>>7\n                has_rot = (ip[k]>>6)&1\n                nbits_off = ip[k] & 0x1f\n                bits=5\n                if has_scale:\n                    nsb=(ip[k]>>2)&0x1f if False else None\n                # simpler: skip remaining for name via flags 0x20 HasName\n            if flags & 0x20:\n                # need to skip to name - this is messy; try scanning for cstring near end\n                pass\n            nplace+=1\n        elif itag==70:  # PlaceObject3\n            flags=ip[0]\n            nplace+=1\n    sprite_info[sid]=(fcount,labels,nplace)\n    lab=', '.join(f'F{fr}:{nm}' for fr,nm in labels) if labels else '-'\n    export=symbols.get(sid,'')\n    print(f'  sprite {sid:5d} frames={fcount:4d} places~{nplace:3d} export={export:24s} labels={lab}')\n\nprint('\\n=== Root timeline labels ===')\nframe=1\nfor tag,length,p in tags:\n    if tag==43:\n        name,_=cstr(p)\n        print(f'  root F{frame} {name}')\n    elif tag==1:\n        frame+=1\n\nprint('\\n=== DefineSound ===')\n# tag 14: id, flags, sampleCount, data\nfor tag,length,p in tags:\n    if tag==14:\n        sid=struct.unpack_from('<H',p,0)[0]\n        flags=p[2]\n        fmt=(flags>>4)&0xF\n        rate=(flags>>2)&3\n        size=(flags>>1)&1\n        stereo=flags&1\n        sc=struct.unpack_from('<I',p,3)[0]\n        export=symbols.get(sid,'')\n        print(f'  sound {sid:5d} fmt={fmt} rate={rate} size={size} stereo={stereo} samples={sc} export={export} datalen={length-7}')\n\nprint('\\n=== DefineBitsJPEG / DefineBitsLossless counts ===')\nfor tname,tid in [('JPEG2',21),('JPEG3',35),('Lossless',20),('Lossless2',36),('DefineShape',2),('DefineShape2',22),('DefineShape3',32),('DefineShape4',83),('DefineMorphShape',46),('DefineButton2',34),('DoABC',82),('DefineBinaryData',87)]:\n    print(tname, c[tid])\nPY\n","description":"Parse effect.swf sprites, labels, sounds"},"content":[],"locations":[]}
