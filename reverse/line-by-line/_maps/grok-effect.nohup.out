ss names from effect scripts\ncd /workspace/bvn-3.3/decompiled/other/effect/scripts\npython3 - <<'PY'\nimport os,re\nfrom pathlib import Path\nroot=Path('.')\nfor p in sorted(root.rglob('*.as')):\n    t=p.read_text()\n    cls=re.search(r'class (\\w+)', t)\n    ext=re.search(r'extends (\\w+)', t)\n    emb=re.search(r'\\[Embed\\((.*?)\\)\\]', t, re.S)\n    fields=re.findall(r'public var (\\w+):(\\w+)', t)\n    frames=re.findall(r'addFrameScript\\(([^)]+)\\)', t)\n    print(f\"{p}\\tclass={cls.group(1) if cls else '?'}\\text={ext.group(1) if ext else '?'}\\tembed={emb.group(1) if emb else '-'}\\tfields={fields}\\tframes={frames}\")\nPY\necho '--- assets ---'\nls -la /workspace/bvn-3.3/decompiled/other/effect/ 2>/dev/null\nfind /workspace/bvn-3.3/decompiled/other/effect -maxdepth 3 -type d\nls /workspace/bvn-3.3/decompiled/other/effect/scripts/_assets 2>/dev/null | head\nfind /workspace/bvn-3.3 -iname '*effect*.swf' 2>/dev/null | head -20\n","truncated":false,"signal":null,"timed_out":false,"description":null,"current_dir":"/workspace/bvn-3.3","output_file":"","total_bytes":10642},"locations":[]}
